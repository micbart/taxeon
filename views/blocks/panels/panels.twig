{#
	Title: Panele
	Description: Panele z tytułem, listą punktów i odnośnikiem
	Category: taxeon
	Icon: columns
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set znacznikTytulu = fields.title.text ? 'h3' : 'h2' %}

{% set ramki = {
	'glass': 'border border-white/24 bg-white/11 shadow-[inset_0_1px_0_rgb(255_255_255/0.22),0_24px_50px_-30px_rgb(3_8_40/0.7)] backdrop-blur-[18px] backdrop-saturate-[1.3]',
	'muted': 'border border-white/24 bg-[rgb(14_31_44/0.42)] backdrop-blur-[18px] backdrop-saturate-[1.3]',
	'light': 'border border-line bg-white shadow-card',
	'dark': 'bg-ink text-white',
	'positive': onDark ? 'border border-[rgb(111_214_160/0.5)] bg-white/11' : 'border border-[#c9e3d4] bg-white shadow-card',
	'negative': onDark ? 'border border-[rgb(255_154_165/0.5)] bg-white/11' : 'border border-[#e7cfd4] bg-white shadow-card'
} %}

{% set barwyTytulu = onDark
	? { 'positive': 'text-[#6fd6a0]', 'negative': 'text-[#ff9aa5]' }
	: { 'positive': 'text-[#0b7a46]', 'negative': 'text-[#a32338]' } %}
{% set znaki = { 'positive': '✓', 'negative': '✗' } %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %} class="relative overflow-hidden {{ section.shell(fields) }}">
	{% include 'components/section-decor.twig' with { background: fields.background } only %}

	<div class="relative {{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			size: fields.head_size,
			background: fields.background,
			headWidth: fields.head_width,
			titleWidth: fields.title_width,
			textWidth: fields.text_width,
			textGap: fields.text_gap,
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: onDark
		} only %}

		<div class="grid grid-cols-2 gap-6 max-xl:grid-cols-1
			{{ fields.title.text or fields.eyebrow.text ? 'mt-10' : '' }}">
			{% for panel in fields.items %}
				{% set wariant = panel.variant ?: (onDark ? 'glass' : 'light') %}
				{% set wariant = not onDark and wariant in ['glass', 'muted'] ? 'light' : wariant %}
				{% set jasnyTekst = wariant in ['glass', 'muted', 'dark'] or (onDark and wariant in ['positive', 'negative']) %}
				{% set znakWariantu = znaki[wariant] %}

				<div class="reveal flex flex-col rounded-panel {{ ramki[wariant] }}
					{{ znaki[wariant] ? 'gap-4 px-8 py-[34px]' : 'gap-[18px] px-9 py-10' }}">

					{% if panel.eyebrow %}
						<span class="text-[13px] font-semibold tracking-[0.14em] uppercase
							{{ jasnyTekst ? 'text-line' : 'text-navy' }}">
							{{ panel.eyebrow }}
						</span>
					{% endif %}

					{% if panel.title %}
					<{{ znacznikTytulu }} class="font-display font-semibold
						{{ znaki[wariant]
							? 'text-[22px] tracking-[-0.02em]'
							: 'text-[clamp(26px,2.6vw,36px)] leading-[1.12] tracking-[-0.03em]' }}
						{{ barwyTytulu[wariant] ?: (jasnyTekst ? 'text-white' : 'text-ink') }}">
						{% if znaki[wariant] %}{{ znaki[wariant] }} {% endif %}{{ panel.title }}
					</{{ znacznikTytulu }}>
					{% endif %}

					{% if panel.text %}
						<p class="{{ jasnyTekst ? 'text-[17px] leading-[1.62] text-white/84' : 'text-[16px] leading-[1.6] text-ink-2' }}">
							{{ panel.text }}
						</p>
					{% endif %}

					{% if panel.items|length %}
						{% if panel.list_style == 'rows' %}
							{% for punkt in panel.items %}
								<span class="flex gap-3 border-t pt-3.5 text-[16px] leading-[1.55]
									{{ jasnyTekst ? 'border-white/14 text-white' : 'border-line-2 text-ink-2' }}">
									{% if znaki[wariant] %}
										<span class="{{ barwyTytulu[wariant] }}">{{ znaki[wariant] }}</span>
									{% endif %}
									<span>{{ punkt.text }}</span>
								</span>
							{% endfor %}
						{% elseif panel.list_style == 'check-lg' %}
							<div class="flex flex-col gap-3">
								{% for punkt in panel.items %}
									<span class="flex gap-3 text-[17px] leading-[1.5]
										{{ jasnyTekst ? 'text-white' : 'text-ink-2' }}">
										<span class="flex-none {{ jasnyTekst ? 'text-gold-light' : 'text-gold' }}">✓</span>
										<span>{{ punkt.text }}</span>
									</span>
								{% endfor %}
							</div>
						{% else %}
							{% set myslnik = panel.list_style == 'dash' %}

							<div class="flex flex-col gap-[13px]">
								{% for punkt in panel.items %}
									<span class="grid grid-cols-[22px_1fr] items-start gap-x-3 text-[16px] leading-[1.55]
										{{ jasnyTekst ? (myslnik ? 'text-white/90' : 'text-white') : 'text-ink-2' }}">
										<span class="text-center {{ myslnik
											? (jasnyTekst ? 'text-line' : 'text-ink-3')
											: (jasnyTekst ? 'text-gold-light' : 'text-gold') }}">
											{{ myslnik ? '—' : '✓' }}
										</span>
										<span>{{ punkt.text }}</span>
									</span>
								{% endfor %}
							</div>
						{% endif %}
					{% endif %}

					{% if panel.note %}
						<p class="mt-auto pt-3 text-[15px] leading-[1.6]
							{{ jasnyTekst ? 'text-white/70 [&_a]:underline' : 'text-ink-3 [&_a]:font-semibold [&_a]:text-navy' }}">
							{{ panel.note }}
						</p>
					{% endif %}

					{% if panel.links|length %}
						{% if panel.links|length > 1 %}
							<div class="mt-auto flex flex-wrap gap-3 pt-3.5">
								{% for pozycja in panel.links %}
									<a href="{{ pozycja.link.url }}"
										{{ linkAttrs(pozycja.link.url, pozycja.link.target)|raw }}
										class="rounded-pill border px-[22px] py-[13px] text-[15px] font-semibold transition
											{{ jasnyTekst
												? 'border-white/40 text-white hover:bg-white hover:text-navy'
												: 'border-navy text-navy hover:bg-mist' }}">
										{{ pozycja.link.title }}
									</a>
								{% endfor %}
							</div>
						{% else %}
							<a href="{{ panel.links|first.link.url }}"
								{{ linkAttrs(panel.links|first.link.url, panel.links|first.link.target)|raw }}
								class="mt-auto pt-2.5 text-[16px] font-semibold transition
									{{ jasnyTekst ? 'text-gold-light hover:text-white' : 'text-navy hover:text-navy-deep' }}">
								{{ panel.links|first.link.title }}
							</a>
						{% endif %}
					{% endif %}
				</div>
			{% endfor %}
		</div>
	</div>
</section>
