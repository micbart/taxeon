{#
	Title: Panele
	Description: Panele z tytułem, listą punktów i odnośnikiem
	Category: taxeon
	Icon: columns
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}

{% set ramki = {
	'glass': 'border border-white/24 bg-white/11 shadow-[inset_0_1px_0_rgb(255_255_255/0.22),0_24px_50px_-30px_rgb(3_8_40/0.7)] backdrop-blur-[18px] backdrop-saturate-[1.3]',
	'muted': 'border border-white/24 bg-[rgb(6_16_50/0.42)] backdrop-blur-[18px] backdrop-saturate-[1.3]',
	'light': 'border border-line bg-page',
	'dark': 'bg-deep-2 text-white'
} %}

<section class="relative overflow-hidden {{ section.shell(fields) }}">
	{% if fields.background == 'gradient' %}
		<div aria-hidden="true" class="absolute inset-0 bg-[image:var(--gradient-blue-glow)]"></div>
	{% endif %}

	<div class="relative {{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: onDark
		} only %}

		<div class="grid grid-cols-2 gap-6 max-xl:grid-cols-1
			{{ fields.title.text or fields.eyebrow.text ? 'mt-10' : '' }}">
			{% for panel in fields.items %}
				{% set wariant = panel.variant ?: (onDark ? 'glass' : 'light') %}
				{% set jasnyTekst = wariant in ['glass', 'muted', 'dark'] %}

				<div class="flex flex-col rounded-panel {{ ramki[wariant] }}
					{{ onDark ? 'gap-[18px] px-9 py-10' : 'gap-4 px-[34px] py-9' }}">

					<h3 class="font-display font-semibold
						{{ onDark
							? 'text-[clamp(26px,2.6vw,36px)] leading-[1.12] tracking-[-0.03em]'
							: 'text-[26px] tracking-[-0.025em]' }}
						{{ jasnyTekst ? 'text-white' : 'text-ink' }}">
						{{ panel.title }}
					</h3>

					{% if panel.items|length %}
						{% if panel.list_style == 'rows' %}
							{% for punkt in panel.items %}
								<span class="border-t pt-3.5 text-[16px] leading-[1.55]
									{{ jasnyTekst ? 'border-white/12 text-white/82' : 'border-[#eef2f8] text-ink-2' }}">
									{{ punkt.text }}
								</span>
							{% endfor %}
						{% else %}
							<div class="flex flex-col gap-[13px]">
								{% for punkt in panel.items %}
									<span class="grid grid-cols-[22px_1fr] items-start gap-x-3 text-[16px] leading-[1.55]
										{{ jasnyTekst ? (wariant == 'muted' ? 'text-white/82' : 'text-white') : 'text-ink-2' }}">
										<span class="text-center {{ wariant == 'muted' ? 'text-white/50' : 'text-sky' }}">
											{{ wariant == 'muted' ? '•' : '✓' }}
										</span>
										<span>{{ punkt.text }}</span>
									</span>
								{% endfor %}
							</div>
						{% endif %}
					{% endif %}

					{% if panel.note %}
						<p class="mt-auto pt-3 text-[15px] leading-[1.6] [&_a]:underline
							{{ jasnyTekst ? 'text-white/70' : 'text-ink-3' }}">
							{{ panel.note }}
						</p>
					{% endif %}

					{% if panel.link.url %}
						<a href="{{ panel.link.url }}"
							target="{{ panel.link.target ?: '_self' }}"
							class="mt-auto pt-2.5 text-[16px] font-semibold transition
								{{ jasnyTekst ? 'text-sky-2 hover:text-white' : 'text-accent hover:text-accent-strong' }}">
							{{ panel.link.title }}
						</a>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	</div>
</section>
