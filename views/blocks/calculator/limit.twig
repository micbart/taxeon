{% set control = include('components/control.twig')|trim %}

<div data-kalkulator="limit" data-limit="{{ dane.limitRoczny }}"
	class="grid grid-cols-[minmax(280px,0.85fr)_minmax(0,1.15fr)] items-stretch gap-8 max-xl:grid-cols-1">

	<form class="rounded-card border border-line bg-page p-8 shadow-[0_40px_80px_-50px_rgb(14_31_44/0.6)] max-sm:p-6"
		aria-label="{{ __('Dane do wyliczenia limitu', 'taxeon') }}"
		onsubmit="return false">
		<p class="text-meta font-semibold tracking-[0.12em] text-navy uppercase">
			{{ __('twoje dane', 'taxeon') }}
		</p>

		<div class="mt-5 grid gap-2">
			<label for="kalk-data" class="text-label font-semibold text-ink">
				{{ __('Dzień rozpoczęcia sprzedaży', 'taxeon') }}
			</label>
			<input id="kalk-data" type="date" value="{{ dane.dzis }}" data-k-pole="data" class="{{ control }}">
		</div>

		<div class="mt-7 h-px bg-line"></div>

		<dl class="mt-5 grid gap-3 text-[14px]">
			<div class="flex items-baseline justify-between gap-3">
				<dt class="text-ink-3">{{ __('Limit roczny', 'taxeon') }}</dt>
				<dd class="font-medium whitespace-nowrap text-ink-2 tabular-nums">
					{{ dane.limitRoczny|number_format(2, ',', ' ') }} zł
				</dd>
			</div>
			<div class="flex items-baseline justify-between gap-3">
				<dt class="text-ink-3">{{ __('Dni sprzedaży do końca roku', 'taxeon') }}</dt>
				<dd class="font-medium whitespace-nowrap text-ink-2 tabular-nums">
					<span data-k-wynik="dni">{{ dane.wynik.dni }}</span>
				</dd>
			</div>
		</dl>
	</form>

	<div class="flex flex-col justify-center rounded-card border border-navy bg-cream px-10 py-11
		shadow-[0_28px_60px_-36px_rgb(23_63_95/0.65)] max-sm:px-7 max-sm:py-9">
		<p class="text-meta font-semibold tracking-[0.12em] text-navy uppercase">
			{{ __('limit uprawniający do zwolnienia', 'taxeon') }}
		</p>

		<p class="mt-3 font-display text-[clamp(34px,4.4vw,52px)] leading-none font-bold tracking-[-0.04em]
			text-ink tabular-nums">
			<span data-k-wynik="limit">{{ dane.wynik.limit|number_format(2, ',', ' ') }}</span>
			<span class="text-[26px] font-semibold tracking-normal">zł</span>
		</p>

		<div class="my-7 h-px bg-navy/15"></div>

		<p class="text-[15px] leading-[1.6] text-ink-2">
			{{ __('Tyle możesz sprzedać do końca roku', 'taxeon') }}
			<span class="font-semibold text-ink tabular-nums" data-k-wynik="rok">{{ dane.dzis|slice(0, 4) }}</span>,
			{{ __('zaczynając sprzedaż', 'taxeon') }}
			<span class="font-semibold text-ink tabular-nums" data-k-wynik="data">{{ dane.dzis }}</span>.
		</p>
	</div>
</div>
