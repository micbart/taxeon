{% set p = dane.parametry %}

<div data-kalkulator="limit" data-limit="{{ dane.limitRoczny }}"
	class="grid grid-cols-[minmax(260px,0.8fr)_minmax(0,1.2fr)] items-stretch gap-10
		max-lg:grid-cols-1 max-lg:gap-8">

	<form class="rounded-card border border-line bg-white/90 p-7 shadow-[0_24px_60px_-40px_rgb(6_26_80/0.35)]
			backdrop-blur-[8px] max-sm:p-5"
		aria-label="{{ __('Dane do wyliczenia limitu', 'taxeon') }}"
		onsubmit="return false">
		<div class="grid gap-[7px]">
			<label for="kalk-data" class="text-sm font-bold text-ink">
				{{ __('Dzień rozpoczęcia sprzedaży', 'taxeon') }}
			</label>
			<input id="kalk-data" type="date" value="{{ dane.dzis }}" data-k-pole="data"
				class="w-full rounded-btn border-[1.5px] border-line bg-white px-4 py-[13px] text-[15px]
					text-ink transition focus:border-accent focus:outline-none">
			<span class="text-[13px] leading-[1.5] text-ink-3">
				{{ __('Limit roczny dzielimy proporcjonalnie do liczby dni do końca roku.', 'taxeon') }}
			</span>
		</div>

		<dl class="mt-6 grid gap-2 border-t border-line pt-4 text-[14px]">
			<div class="flex items-baseline justify-between gap-3 text-ink-2">
				<dt>{{ __('Limit roczny', 'taxeon') }}</dt>
				<dd class="tabular-nums whitespace-nowrap">{{ dane.limitRoczny|number_format(2, ',', ' ') }} zł</dd>
			</div>
			<div class="flex items-baseline justify-between gap-3 text-ink-2">
				<dt>{{ __('Dni sprzedaży do końca roku', 'taxeon') }}</dt>
				<dd class="tabular-nums whitespace-nowrap"><span data-k-wynik="dni">{{ dane.wynik.dni }}</span></dd>
			</div>
		</dl>
	</form>

	<div class="flex flex-col justify-center rounded-card border border-accent bg-accent-soft p-9
		shadow-[0_18px_44px_-26px_rgb(11_99_246/0.5)] max-sm:p-6">
		<p class="text-[13px] font-semibold tracking-[0.1em] text-accent uppercase">
			{{ __('limit uprawniający do zwolnienia', 'taxeon') }}
		</p>
		<p class="mt-3 font-display text-[clamp(32px,4vw,48px)] leading-[1.05] font-bold text-ink">
			<span data-k-wynik="limit">{{ dane.wynik.limit|number_format(2, ',', ' ') }}</span> zł
		</p>
		<p class="mt-4 text-[15px] leading-[1.6] text-ink-2">
			{{ __('Tyle możesz sprzedać do końca roku', 'taxeon') }}
			<span data-k-wynik="rok">{{ dane.dzis|slice(0, 4) }}</span>,
			{{ __('zaczynając sprzedaż', 'taxeon') }}
			<span data-k-wynik="data">{{ dane.dzis }}</span>.
		</p>
	</div>
</div>
