{% set p = dane.parametry %}
{% set wynik = dane.wynik %}
{% set formy = {
	'skala': { 'nazwa': 'Zasady ogólne', 'opis': 'skala 12% i 32%' },
	'liniowy': { 'nazwa': 'Podatek liniowy', 'opis': 'stawka 19%' },
	'ryczalt': { 'nazwa': 'Ryczałt', 'opis': 'od przychodu' }
} %}
{% set ustawienia = {
	'skalaProg': p.skalaProg,
	'skalaStawkaNizsza': p.skalaStawkaNizsza,
	'skalaStawkaWyzsza': p.skalaStawkaWyzsza,
	'kwotaZmniejszajaca': p.kwotaZmniejszajaca,
	'liniowyStawka': p.liniowyStawka,
	'zdrowotnaSkala': p.zdrowotnaSkala,
	'zdrowotnaLiniowy': p.zdrowotnaLiniowy,
	'zdrowotnaMinimalna': p.zdrowotnaMinimalna,
	'ryczaltPrzecietne': p.ryczaltPrzecietne,
	'ryczaltProgNizszy': p.ryczaltProgNizszy,
	'ryczaltProgWyzszy': p.ryczaltProgWyzszy,
	'ryczaltOdliczenie': p.ryczaltOdliczenie
} %}

<div data-kalkulator="podatkowy" data-ustawienia="{{ ustawienia|json_encode|e('html_attr') }}"
	class="grid grid-cols-[minmax(272px,0.78fr)_minmax(0,1.9fr)] items-start gap-8 max-xl:grid-cols-1">

	<form class="rounded-card border border-line bg-page p-8 shadow-[0_40px_80px_-50px_rgb(14_31_44/0.6)] max-sm:p-6"
		aria-label="{{ __('Dane do wyliczenia', 'taxeon') }}"
		onsubmit="return false">
		<p class="text-meta font-semibold tracking-[0.12em] text-navy uppercase">
			{{ __('twoje dane', 'taxeon') }}
		</p>

		<div class="mt-5 grid gap-[18px]">
			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-przychod', nazwa: 'przychod',
				label: __('Przychód miesięcznie', 'taxeon'), wartosc: p.domyslnyPrzychod
			} only %}

			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-koszty', nazwa: 'koszty',
				label: __('Koszty miesięcznie', 'taxeon'), wartosc: p.domyslneKoszty
			} only %}

			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-spoleczne', nazwa: 'spoleczne',
				label: __('Składki społeczne miesięcznie', 'taxeon'), wartosc: p.domyslneSpoleczne,
				hint: __('ZUS bez składki zdrowotnej.', 'taxeon')
			} only %}

			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-stawka', nazwa: 'stawka',
				label: __('Stawka ryczałtu', 'taxeon'), wartosc: p.domyslnaStawka, opcje: p.stawki
			} only %}
		</div>

		<div class="mt-7 h-px bg-line"></div>

		<p class="mt-5 text-meta leading-[1.6] text-ink-3">
			{{ __('Kwoty w wynikach są roczne — mnożymy wpisane wartości przez dwanaście miesięcy.', 'taxeon') }}
		</p>
	</form>

	<div>
		<div class="grid grid-cols-3 gap-5 max-md:grid-cols-1 max-md:gap-4" role="group"
			aria-label="{{ __('Wynik dla trzech form opodatkowania', 'taxeon') }}">
			{% for klucz, forma in formy %}
				{% set f = wynik.formy[klucz] %}
				{% set najlepsza = wynik.najlepsza == klucz %}

				<div data-k-forma="{{ klucz }}"
					class="group/karta flex flex-col rounded-card border bg-page p-7 transition
						border-line shadow-soft
						data-[najlepsza]:border-navy data-[najlepsza]:bg-cream
						data-[najlepsza]:shadow-[0_28px_60px_-36px_rgb(23_63_95/0.65)]
						max-sm:p-6"
					{{ najlepsza ? 'data-najlepsza' : '' }}>

					<div class="flex min-h-[22px] items-start">
						<span data-k-znacznik
							class="hidden rounded-pill bg-navy px-[11px] py-[5px] text-[11px] leading-none
								font-semibold tracking-[0.04em] whitespace-nowrap text-white uppercase
								data-[widoczny]:block"
							{{ najlepsza ? 'data-widoczny' : '' }}>
							{{ __('zostaje najwięcej', 'taxeon') }}
						</span>
					</div>

					<h3 class="mt-3.5 font-display text-[18px] leading-[1.2] font-bold tracking-[-0.02em] text-ink">
						{{ forma.nazwa }}
					</h3>
					<p class="mt-1 text-meta text-ink-3">{{ forma.opis }}</p>

					<div class="mt-6">
						<p class="text-meta font-semibold tracking-[0.12em] text-ink-3 uppercase">
							{{ __('zostaje na rękę', 'taxeon') }}
						</p>
						<p class="mt-1.5 font-display text-[clamp(28px,2.6vw,36px)] leading-none font-bold
							tracking-[-0.04em] text-ink tabular-nums">
							<span data-k-wynik="{{ klucz }}.naReke">{{ f.naReke|number_format(2, ',', ' ') }}</span>
							<span class="text-[20px] font-semibold tracking-normal">zł</span>
						</p>
						<p class="mt-2 text-[14px] text-ink-3 tabular-nums">
							<span data-k-wynik="{{ klucz }}.naRekeMies">{{ (f.naReke / 12)|number_format(2, ',', ' ') }}</span>
							zł {{ __('miesięcznie', 'taxeon') }}
						</p>
					</div>

					<div class="my-6 h-px bg-line group-data-[najlepsza]/karta:bg-navy/15"></div>

					<dl class="grid gap-2.5 text-[13.5px]">
						{% for pole, etykieta in {
							'pdof': __('Podatek dochodowy', 'taxeon'),
							'zdrowotna': __('Składka zdrowotna', 'taxeon'),
							'spoleczne': __('Składki społeczne', 'taxeon')
						} %}
							<div class="flex items-baseline justify-between gap-2.5">
								<dt class="whitespace-nowrap text-ink-3">{{ etykieta }}</dt>
								<dd class="font-medium whitespace-nowrap text-ink-2 tabular-nums">
									<span data-k-wynik="{{ klucz }}.{{ pole }}">{{ f[pole]|number_format(2, ',', ' ') }}</span> zł
								</dd>
							</div>
						{% endfor %}

						<div class="mt-1 flex items-baseline justify-between gap-2.5 border-t border-line pt-3
							group-data-[najlepsza]/karta:border-navy/15">
							<dt class="whitespace-nowrap font-semibold text-ink">{{ __('Razem', 'taxeon') }}</dt>
							<dd class="font-semibold whitespace-nowrap text-ink tabular-nums">
								<span data-k-wynik="{{ klucz }}.suma">{{ f.suma|number_format(2, ',', ' ') }}</span> zł
							</dd>
						</div>
					</dl>
				</div>
			{% endfor %}
		</div>

		<p class="mt-5 text-meta leading-[1.6] text-ink-3">
			{{ __('Kwoty roczne dla', 'taxeon') }} {{ p.rok }}.
			{{ __('Przy ryczałcie zakładamy jedną stawkę dla całego przychodu, a składkę zdrowotną liczymy od przychodu pomniejszonego o składki społeczne.', 'taxeon') }}
		</p>
	</div>
</div>
