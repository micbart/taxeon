{% set p = dane.parametry %}
{% set wynik = dane.wynik %}
{% set formy = {
	'skala': 'Zasady ogólne (skala)',
	'liniowy': 'Podatek liniowy',
	'ryczalt': 'Ryczałt'
} %}
{% set ustawienia = {
	'skalaProg': p.skalaProg,
	'skalaStawkaNizsza': p.skalaStawkaNizsza,
	'skalaStawkaWyzsza': p.skalaStawkaWyzsza,
	'kwotaZmniejszajaca': p.kwotaZmniejszajaca,
	'liniowyStawka': p.liniowyStawka,
	'zdrowotnaSkala': p.zdrowotnaSkala,
	'zdrowotnaLiniowy': p.zdrowotnaLiniowy,
	'zdrowotnaMinimalna': p.zdrowotnaMinimalna,
	'ryczaltPrzecietne': p.ryczaltPrzecietne,
	'ryczaltProgNizszy': p.ryczaltProgNizszy,
	'ryczaltProgWyzszy': p.ryczaltProgWyzszy,
	'ryczaltOdliczenie': p.ryczaltOdliczenie
} %}

<div data-kalkulator="podatkowy" data-ustawienia="{{ ustawienia|json_encode|e('html_attr') }}"
	class="grid grid-cols-[minmax(260px,0.75fr)_minmax(0,1.6fr)] items-start gap-10 max-lg:grid-cols-1 max-lg:gap-8">

	<form class="rounded-card border border-line bg-white/90 p-7 shadow-[0_24px_60px_-40px_rgb(6_26_80/0.35)]
			backdrop-blur-[8px] max-sm:p-5"
		aria-label="{{ __('Dane do wyliczenia', 'taxeon') }}"
		onsubmit="return false">
		<h3 class="font-display text-[19px] font-bold text-ink">{{ __('Twoje dane', 'taxeon') }}</h3>

		<div class="mt-5 grid gap-4">
			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-przychod', nazwa: 'przychod',
				label: __('Przychód miesięcznie', 'taxeon'), wartosc: p.domyslnyPrzychod
			} only %}

			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-koszty', nazwa: 'koszty',
				label: __('Koszty miesięcznie', 'taxeon'), wartosc: p.domyslneKoszty
			} only %}

			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-spoleczne', nazwa: 'spoleczne',
				label: __('Składki społeczne miesięcznie', 'taxeon'), wartosc: p.domyslneSpoleczne,
				hint: __('ZUS bez składki zdrowotnej.', 'taxeon')
			} only %}

			{% include 'blocks/calculator/pole.twig' with {
				id: 'kalk-stawka', nazwa: 'stawka',
				label: __('Stawka ryczałtu', 'taxeon'), wartosc: p.domyslnaStawka, opcje: p.stawki
			} only %}
		</div>
	</form>

	<div class="grid grid-cols-3 gap-4 max-lg:grid-cols-1" role="group"
		aria-label="{{ __('Wynik dla trzech form opodatkowania', 'taxeon') }}">
		{% for klucz, nazwa in formy %}
			{% set f = wynik.formy[klucz] %}
			<div data-k-forma="{{ klucz }}"
				class="flex flex-col rounded-card border bg-white/90 p-6 transition max-sm:p-5
					data-[najlepsza]:border-accent data-[najlepsza]:shadow-[0_18px_44px_-26px_rgb(11_99_246/0.5)]
					border-line"
				{{ wynik.najlepsza == klucz ? 'data-najlepsza' : '' }}>
				<div class="flex items-start justify-between gap-2">
					<h3 class="font-display text-[16px] leading-[1.25] font-bold text-ink">{{ nazwa }}</h3>
					<span data-k-znacznik
						class="hidden rounded-pill bg-accent px-2.5 py-1 text-[11px] font-semibold
							whitespace-nowrap text-white data-[widoczny]:block"
						{{ wynik.najlepsza == klucz ? 'data-widoczny' : '' }}>
						{{ __('najkorzystniej', 'taxeon') }}
					</span>
				</div>

				<p class="mt-5 text-[13px] font-semibold tracking-[0.1em] text-ink-3 uppercase">
					{{ __('zostaje na rękę', 'taxeon') }}
				</p>
				<p class="font-display text-[clamp(26px,2.4vw,32px)] leading-[1.1] font-bold text-ink">
					<span data-k-wynik="{{ klucz }}.naReke">{{ f.naReke|number_format(2, ',', ' ') }}</span> zł
				</p>
				<p class="mt-1 text-[13.5px] text-ink-3">
					<span data-k-wynik="{{ klucz }}.naRekeMies">{{ (f.naReke / 12)|number_format(2, ',', ' ') }}</span>
					zł {{ __('miesięcznie', 'taxeon') }}
				</p>

				<dl class="mt-5 grid gap-2 border-t border-line pt-4 text-[14px]">
					{% for pole, etykieta in {
						'pdof': __('Podatek dochodowy', 'taxeon'),
						'zdrowotna': __('Składka zdrowotna', 'taxeon'),
						'spoleczne': __('Składki społeczne', 'taxeon'),
						'suma': __('Razem obciążenia', 'taxeon')
					} %}
						<div class="flex items-baseline justify-between gap-3 {{ pole == 'suma' ? 'font-semibold text-ink' : 'text-ink-2' }}">
							<dt>{{ etykieta }}</dt>
							<dd class="whitespace-nowrap tabular-nums">
								<span data-k-wynik="{{ klucz }}.{{ pole }}">{{ f[pole]|number_format(2, ',', ' ') }}</span> zł
							</dd>
						</div>
					{% endfor %}
				</dl>
			</div>
		{% endfor %}

		<p class="col-span-3 text-[13px] text-ink-3 max-lg:col-span-1">
			{{ __('Kwoty roczne dla', 'taxeon') }} {{ p.rok }}.
			{{ __('Przy ryczałcie zakładamy jedną stawkę dla całego przychodu.', 'taxeon') }}
		</p>
	</div>
</div>
