{% if dane.pakiety|length %}
	<div data-kalkulator="ksiegowy"
		class="grid grid-cols-[minmax(272px,0.8fr)_minmax(0,1.7fr)] items-start gap-8 max-xl:grid-cols-1">

		<form class="rounded-card border border-line bg-page p-8 shadow-[0_40px_80px_-50px_rgb(14_31_44/0.6)] max-sm:p-6"
			aria-label="{{ __('Dobór pakietu', 'taxeon') }}"
			onsubmit="return false">
			<p class="text-meta font-semibold tracking-[0.12em] text-navy uppercase">
				{{ __('twoja sytuacja', 'taxeon') }}
			</p>

			<fieldset class="mt-5">
				<legend class="text-label font-semibold text-ink">{{ __('Kto prowadzi księgowość', 'taxeon') }}</legend>

				<div class="mt-2.5 grid gap-1 rounded-sm bg-line p-[5px]">
					{% for opcja in [
						{ wartosc: 'ksiegowa', etykieta: __('Księgowa z Taxeon', 'taxeon') },
						{ wartosc: 'samodzielnie', etykieta: __('Księguję sam', 'taxeon') }
					] %}
						<label class="cursor-pointer rounded-[10px] px-5 py-2.5 text-center font-display text-[15px]
							font-semibold text-ink-3 transition
							has-checked:bg-page has-checked:text-ink
							has-checked:shadow-[0_6px_16px_-8px_rgb(14_31_44/0.6)]
							has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-navy">
							<input type="radio" name="kalk-obsluga" value="{{ opcja.wartosc }}" data-k-pole="obsluga"
								{{ loop.first ? 'checked' : '' }} class="sr-only">
							{{ opcja.etykieta }}
						</label>
					{% endfor %}
				</div>
			</fieldset>

			<fieldset class="mt-6" data-k-grupa="forma">
				<legend class="text-label font-semibold text-ink">{{ __('Forma opodatkowania', 'taxeon') }}</legend>

				<div class="mt-2.5 grid gap-1 rounded-sm bg-line p-[5px]">
					{% for opcja in [
						{ wartosc: 'ryczalt', etykieta: __('Ryczałt', 'taxeon') },
						{ wartosc: 'kpir', etykieta: __('KPiR', 'taxeon') }
					] %}
						<label class="cursor-pointer rounded-[10px] px-5 py-2.5 text-center font-display text-[15px]
							font-semibold text-ink-3 transition
							has-checked:bg-page has-checked:text-ink
							has-checked:shadow-[0_6px_16px_-8px_rgb(14_31_44/0.6)]
							has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-navy">
							<input type="radio" name="kalk-forma" value="{{ opcja.wartosc }}" data-k-pole="forma"
								{{ loop.first ? 'checked' : '' }} class="sr-only">
							{{ opcja.etykieta }}
						</label>
					{% endfor %}
				</div>

				<p class="mt-2 text-meta leading-[1.5] text-ink-3">
					{{ __('KPiR to zasady ogólne albo podatek liniowy.', 'taxeon') }}
				</p>
			</fieldset>

			<label data-k-grupa="vat"
				class="mt-6 flex cursor-pointer items-center gap-3 rounded-btn border-[1.5px] border-line
					bg-white px-4 py-[13px] text-[15px] text-ink transition
					has-checked:border-navy has-checked:bg-cream">
				<input type="checkbox" data-k-pole="vat"
					class="size-[18px] flex-none cursor-pointer accent-navy">
				{{ __('Jestem czynnym podatnikiem VAT', 'taxeon') }}
			</label>
		</form>

		<div>
			<div class="grid grid-cols-2 gap-5 max-md:grid-cols-1 max-md:gap-4">
				{% for indeks, pakiet in dane.pakiety %}
					<div data-k-pakiet="{{ indeks }}" data-etykieta="{{ pakiet.label }}"
						class="flex flex-col rounded-card border bg-page p-7 transition
							border-line shadow-soft
							data-[wybrany]:border-navy data-[wybrany]:bg-cream
							data-[wybrany]:shadow-[0_28px_60px_-36px_rgb(23_63_95/0.65)]
							max-sm:p-6">

						<div class="flex min-h-[28px] items-start justify-between gap-2">
							<span class="font-display text-[14px] font-semibold tracking-[0.12em] text-navy uppercase">
								{{ pakiet.label }}
							</span>

							<span data-k-znacznik
								class="hidden flex-none rounded-pill bg-navy px-[11px] py-[5px] text-[11px]
									font-semibold tracking-[0.04em] whitespace-nowrap text-white uppercase
									data-[widoczny]:block">
								{{ __('dla Ciebie', 'taxeon') }}
							</span>
						</div>

						<p class="mt-4 flex items-baseline gap-2 font-display font-bold tracking-[-0.04em] text-ink">
							<span class="text-[38px] leading-none">{{ pakiet.price }}</span>
							{% if pakiet.period %}
								<span class="text-[15px] font-normal tracking-normal text-ink-3">{{ pakiet.period }}</span>
							{% endif %}
						</p>

						{% if pakiet.text %}
							<p class="mt-3 text-[14px] leading-[1.6] text-ink-3">{{ pakiet.text }}</p>
						{% endif %}

						{% if pakiet.link.url %}
							<a href="{{ pakiet.link.url }}" {{ linkAttrs(pakiet.link.url, pakiet.link.target)|raw }}
								class="mt-6 rounded-pill px-5 py-3 text-center text-[15px] font-semibold transition
									border border-line text-ink hover:border-navy hover:bg-navy hover:text-white">
								{{ pakiet.link.title }}
							</a>
						{% endif %}
					</div>
				{% endfor %}
			</div>

			<p class="mt-5 text-meta leading-[1.6] text-ink-3">
				{{ __('Ceny netto pochodzą z cennika. Kadry i płace, rozliczenie roczne oraz nietypowe rozliczenia transgraniczne wyceniamy osobno.', 'taxeon') }}
			</p>
		</div>
	</div>
{% endif %}
