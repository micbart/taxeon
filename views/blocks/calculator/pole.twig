{% set control = include('components/control.twig')|trim %}

<div class="grid gap-2">
	<label for="{{ id }}" class="text-label font-semibold text-ink">{{ label }}</label>

	{% if opcje %}
		<div class="relative">
			<select id="{{ id }}" data-k-pole="{{ nazwa }}"
				class="{{ control }} cursor-pointer appearance-none pr-11">
				{% for opcja in opcje %}
					<option value="{{ opcja }}" {{ opcja == wartosc ? 'selected' : '' }}>
						{{ opcja|replace({'.': ','}) }}%
					</option>
				{% endfor %}
			</select>
			<span aria-hidden="true"
				class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-ink-3 [&_svg]:size-[18px]">
				{{ 'chevron-down'|svg }}
			</span>
		</div>
	{% else %}
		<div class="relative">
			<input id="{{ id }}"
				type="number"
				inputmode="decimal"
				min="0"
				step="0.01"
				value="{{ wartosc }}"
				data-k-pole="{{ nazwa }}"
				class="{{ control }} pr-11 tabular-nums
					[&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none">
			<span aria-hidden="true"
				class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-label text-ink-3">
				zł
			</span>
		</div>
	{% endif %}

	{% if hint %}<span class="text-meta leading-[1.5] text-ink-3">{{ hint }}</span>{% endif %}
</div>
