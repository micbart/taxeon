{#
	Title: Doradca / konsultacja
	Description: Granatowa karta CTA z listą korzyści i wskaźnikami zaufania
	Category: raks
	Icon: businessperson
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		<div class="reveal relative grid grid-cols-[1.05fr_1fr] items-center gap-14 overflow-hidden rounded-panel
			border border-transparent bg-[image:var(--gradient-deep)] p-14 text-white shadow-navy-lg
			before:pointer-events-none before:absolute before:inset-0 before:bg-[image:var(--gradient-glow-card)] before:content-['']
			max-lg:grid-cols-1 max-lg:gap-9 max-lg:px-[26px] max-lg:py-9 max-sm:px-5">

			<div class="relative z-[1]">
				{% if fields.avatar or fields.icon %}
					<span class="mb-[22px] grid size-16 place-items-center overflow-hidden rounded-[18px]
						border-[1.5px] border-white/20 bg-white/10 text-deep-tint-3 [&_svg]:size-[30px]">
						{% if fields.avatar %}
							{% include 'components/image.twig' with { id: fields.avatar.ID, size: 'thumbnail', alt: '', class: 'size-full object-cover' } only %}
						{% else %}
							{{ fields.icon|svg }}
						{% endif %}
					</span>
				{% endif %}

				{% include 'components/eyebrow.twig' with { title: fields.eyebrow, color: 'text-deep-tint' } only %}

				{% include 'components/title-with-select-tag.twig' with {
					title: fields.title,
					defaultTag: 'h2',
					titleClass: 'mt-3.5 font-display text-[32px] leading-[1.08] font-semibold tracking-[-0.02em] text-white'
				} only %}

				{% include 'components/title-with-select-tag.twig' with {
					title: fields.text,
					defaultTag: 'p',
					titleClass: 'mt-4 max-w-[440px] text-[16.5px] leading-relaxed text-white/80'
				} only %}

				{% if fields.benefits|length %}
					<ul class="mt-6 flex flex-col gap-[11px]">
						{% for benefit in fields.benefits %}
							<li class="flex items-center gap-[11px] text-[15px] font-semibold text-white/90
								[&_svg]:size-[19px] [&_svg]:text-deep-tint-2">
								{{ 'circle-check-big'|svg }}
								{{ benefit.text }}
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</div>

			<div class="relative z-[1] rounded-card border border-white/14 bg-white/7 p-[34px] max-sm:px-4 max-sm:py-5">
				<div class="flex flex-col gap-[13px]">
					{% include 'components/button.twig' with {
						button: fields.button_primary,
						block: true,
						class: 'max-sm:gap-2 max-sm:px-4 max-sm:py-3.5 max-sm:text-sm max-sm:leading-snug max-sm:text-balance max-sm:[&_svg]:size-4'
					} only %}

					{% include 'components/button.twig' with {
						button: fields.button_secondary,
						block: true,
						class: 'max-sm:gap-2 max-sm:px-4 max-sm:py-3.5 max-sm:text-sm max-sm:leading-snug max-sm:text-balance max-sm:[&_svg]:size-4'
					} only %}
				</div>

				{% if fields.stats|length %}
					<div class="mt-[30px] flex flex-col gap-5 border-t border-white/14 pt-[30px]">
						{% for stat in fields.stats %}
							<div class="flex items-center gap-3.5">
								{% if stat.icon %}
									<span class="grid size-[46px] flex-none place-items-center rounded-[13px]
										bg-white/10 text-deep-tint-3 [&_svg]:size-[23px]">
										{{ stat.icon|svg }}
									</span>
								{% endif %}

								<div>
									<b class="block font-display text-[19px] leading-[1.15] font-bold tracking-[-0.01em] text-white">
										{{ stat.value }}
									</b>
									<span class="mt-0.5 block text-meta text-white/60">{{ stat.label }}</span>
								</div>
							</div>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</section>
