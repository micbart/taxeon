{#
	Title: Wsparcie (harmonijka)
	Description: Rozsuwane kafle ze zdjęciem — panel otwiera się po najechaniu lub kliknięciu
	Category: raks
	Icon: slides
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
	EnqueueStyle: src/blocks/support/support.scss

	Rozsuwanie kafli wymaga reguł zależnych od hovera rodzeństwa
	(`:hover .is-active:not(:hover)`), których nie da się zapisać jako utility —
	dlatego sama ta mechanika siedzi w support.scss. Reszta jest w klasach.
#}

{% import 'components/section.twig' as section %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			wide: true
		} only %}

		<div data-accordion
			class="support-list reveal flex h-[470px] gap-3.5 max-xl:h-auto max-xl:flex-col max-xl:gap-3">

			{% for item in fields.items %}
				<article data-accordion-item
					class="support-item relative min-w-0 cursor-pointer overflow-hidden rounded-panel
						bg-[image:var(--gradient-tile)] shadow-tile max-xl:min-h-[200px]
						{{ loop.first ? 'is-active' }}">

					{% if item.image %}
						{% include 'components/image.twig' with {
							id: item.image.ID,
							size: 'raks-cover',
							sizes: '(max-width: 920px) 100vw, 60vw',
							alt: '',
							objectPosition: item.focal ?: '60% 40%',
							class: 'absolute inset-0 size-full object-cover'
						} only %}
					{% endif %}

					<div aria-hidden="true" class="pointer-events-none absolute inset-0 z-[1] bg-[image:var(--gradient-shade)]"></div>

					<div aria-hidden="true"
						class="support-rail pointer-events-none absolute inset-0 z-[2] flex flex-col items-center
							justify-between py-[26px] transition-opacity max-xl:hidden">
						{% if item.icon %}
							<span class="grid size-[50px] flex-none place-items-center rounded-[14px] border
								border-white/22 bg-white/14 text-white backdrop-blur-[4px] [&_svg]:size-6">
								{{ item.icon|svg }}
							</span>
						{% endif %}

						<span class="font-display text-xl leading-[1.6] font-semibold tracking-[-0.01em] whitespace-nowrap
							text-white [writing-mode:vertical-rl] [text-shadow:0_1px_10px_rgb(0_0_0/0.4)] rotate-180">
							{{ item.title.text }}
						</span>
					</div>

					<div class="support-panel absolute inset-0 z-[2] flex w-[520px] max-w-[78%] flex-col items-start
						p-10 opacity-0 transition-opacity delay-75
						max-xl:relative max-xl:w-full max-xl:max-w-full max-xl:p-[30px] max-xl:opacity-100">

						{% if item.icon %}
							<span class="grid size-[50px] flex-none place-items-center rounded-[14px] border
								border-white/22 bg-white/14 text-white backdrop-blur-[4px] [&_svg]:size-6">
								{{ item.icon|svg }}
							</span>
						{% endif %}

						{% include 'components/title-with-select-tag.twig' with {
							title: item.title,
							defaultTag: 'h3',
							titleClass: 'mt-[22px] max-w-[12ch] font-display text-[30px] leading-[1.08] font-semibold
								tracking-[-0.02em] text-white'
						} only %}

						{% include 'components/title-with-select-tag.twig' with {
							title: item.text,
							defaultTag: 'p',
							titleClass: 'mt-4 max-w-[42ch] text-base leading-[1.55] text-white/82'
						} only %}

						{% if item.link.url %}
							<a href="{{ item.link.url }}"
								target="{{ item.link.target ?: '_self' }}"
								aria-label="{{ item.link.title ?: item.title.text }}"
								class="mt-auto grid size-14 place-items-center rounded-full bg-white text-ink transition
									hover:-translate-y-[3px] hover:scale-105 hover:bg-[#eef3ff]
									max-xl:mt-6 [&_svg]:size-[22px]">
								{{ 'arrow-up-right'|svg }}
							</a>
						{% endif %}
					</div>
				</article>
			{% endfor %}
		</div>
	</div>
</section>
