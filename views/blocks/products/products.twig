{#
	Title: Produkty ze sklepu
	Description: Karty produktów synchronizowanych ze sklepu, z filtrem kategorii
	Category: raks
	Icon: cart
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set count = fields.count > 0 ? fields.count : -1 %}

{% set dostepne = fields.show_unavailable ? [] : shopAvailableMetaQuery() %}
{% if fields.source == 'manual' %}
	{% set items = fields.items|length ? get_posts({
		post_type: 'produkt',
		post__in: fields.items,
		orderby: 'post__in',
		posts_per_page: -1
	}) : [] %}
{% elseif fields.source == 'category' and fields.category %}
	{% set items = get_posts({
		post_type: 'produkt',
		posts_per_page: count,
		raks_shop_sort_by_date: true,
		meta_query: dostepne,
		tax_query: [{
			taxonomy: 'kategoria-produktu',
			field: 'term_id',
			terms: fields.category
		}]
	}) %}
{% else %}
	{% set items = get_posts({
		post_type: 'produkt',
		posts_per_page: count,
		raks_shop_sort_by_date: true,
		meta_query: dostepne
	}) %}
{% endif %}

{% set areas = [] %}
{% for item in items %}
	{% for term in item.terms({ taxonomy: 'kategoria-produktu' }) %}
		{% if term.name not in areas %}
			{% set areas = areas|merge([term.name]) %}
		{% endif %}
	{% endfor %}
{% endfor %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: onDark
		} only %}

		{% if items|length %}
			<div data-filter>
				{% if fields.show_filter and areas|length > 1 %}
					<div class="reveal mb-9 flex flex-wrap gap-2.5">
						{% for area in [fields.filter_all_label ?: __('Wszystkie', 'raks')]|merge(areas) %}
							<button type="button"
								data-filter-pill="{{ loop.first ? '' : area }}"
								data-active="{{ loop.first ? 'true' : 'false' }}"
								class="cursor-pointer rounded-full border px-[18px] py-[9px] text-sm font-semibold transition
									{{ onDark
										? 'border-white/25 bg-transparent text-white/80 hover:border-white/60 hover:text-white data-[active=true]:border-white data-[active=true]:bg-white data-[active=true]:text-ink'
										: 'border-line bg-white text-ink-2 hover:border-accent/45 hover:text-accent-strong data-[active=true]:border-accent data-[active=true]:bg-accent data-[active=true]:text-white' }}">
								{{ area }}
							</button>
						{% endfor %}
					</div>
				{% endif %}

				{% set cols = {
					'2': 'grid-cols-2 max-lg:grid-cols-1',
					'3': 'grid-cols-3 max-xl:grid-cols-2 max-sm:grid-cols-1',
					'4': 'grid-cols-4 max-2xl:grid-cols-2 max-sm:grid-cols-1'
				} %}

				<div class="grid gap-6 {{ cols[fields.columns ?: '2'] }}">
					{% for item in items %}
						{% include 'components/product-card.twig' with {
							item: item,
							buttonLabel: fields.button_label,
							showPrice: fields.show_price,
							showDate: fields.show_date,
							showImage: fields.show_image
						} only %}
					{% endfor %}
				</div>

				<p data-filter-empty hidden
					class="mt-8 rounded-panel border border-dashed border-line px-7 py-10 text-center text-lead
						{{ onDark ? 'border-white/25 text-white/80' : 'text-ink-2' }}">
					{{ fields.empty_text ?: __('Nie mamy teraz nic w tej kategorii.', 'raks') }}
				</p>
			</div>
		{% elseif fields.empty_text %}
			<p class="reveal rounded-panel border border-dashed border-line px-7 py-10 text-center text-lead
				{{ onDark ? 'border-white/25 text-white/80' : 'text-ink-2' }}">
				{{ fields.empty_text }}
			</p>
		{% endif %}
	</div>
</section>
