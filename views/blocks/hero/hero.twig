{#
	Title: Hero
	Description: Nagłówek strony z wideo w tle, kartami cennika albo panelem bocznym
	Category: taxeon
	Icon: cover-image
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsMultiple: false
	SupportsAnchor: true
#}
{% set uklad = fields.layout ?: 'cards' %}
{% set split = uklad == 'split' %}
{% set srodek = uklad == 'center' %}
{% set rozmiaryTytulu = {
	'62': 'text-[clamp(38px,4.4vw,62px)]',
	'64': 'text-[clamp(38px,4.4vw,64px)]',
	'66': 'text-[clamp(38px,4.4vw,66px)]'
} %}
{% set odstepyOpisu = { '22': 'mt-[22px]', '24': 'mt-6', '26': 'mt-[26px]' } %}
{% set szerokosciOpisu = { '56ch': 'max-w-[56ch]', '60ch': 'max-w-[60ch]', '62ch': 'max-w-[62ch]' } %}
{% set barwyOpisu = { 'soft': 'text-white/76 leading-[1.6]', 'strong': 'text-white/78 leading-[1.62]' } %}
{% set akcent = fields.button_style == 'accent' %}
{% set odstepy = { '72': 'pb-[72px]', '76': 'pb-[76px]', '84': 'pb-[84px]', '88': 'pb-[88px]' } %}
{% set podstrona = uklad != 'cards' %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %} class="relative overflow-hidden bg-deep text-white">
	{% include 'components/hero-media.twig' with {
		url: fields.video,
		poster: fields.poster.sizes.large ?: fields.poster.url,
		title: fields.title.text,
		split: split,
		center: srodek,
		glow: podstrona
	} only %}

	<div class="relative mx-auto w-full max-w-page px-gutter pt-[168px] max-md:pt-[132px] max-sm:px-5
		{{ odstepy[fields.space_bottom] ?: (split ? 'pb-[84px]' : 'pb-[72px]') }}
		{{ split ? 'grid grid-cols-[minmax(320px,1.25fr)_minmax(300px,0.75fr)] items-start gap-14 max-xl:grid-cols-1 max-xl:gap-10' }}
		{{ srodek ? 'text-center' }}">

		<div>
			{% if fields.show_breadcrumbs %}
				{% include 'components/breadcrumbs.twig' with { breadcrumbs: breadcrumbs, light: true } only %}
			{% endif %}

			{% if fields.badge %}
				<div class="inline-flex items-center gap-2.5 text-[13px] tracking-[0.04em] text-white/82 uppercase">
					<span class="block size-1.5 rounded-full bg-sky"></span>
					{{ fields.badge }}
				</div>
			{% endif %}

			{% if fields.title.text %}
				<{{ fields.title.tag ?: 'h1' }} class="mt-[22px] font-display font-bold
					tracking-[-0.035em] text-balance
					{{ rozmiaryTytulu[fields.title_size]
						?: (srodek or split ? 'text-[clamp(38px,4.4vw,64px)]' : 'text-[clamp(38px,4.4vw,66px)]') }}
					{{ fields.title_size == '62' ? 'leading-[1.03]' : 'leading-none' }}
					{{ srodek ? 'mx-auto max-w-[20ch]' : (split ? 'max-w-[20ch]' : 'max-w-[21ch]') }}">
					{{ fields.title.text }}
				</{{ fields.title.tag ?: 'h1' }}>
			{% endif %}

			{% if fields.subtitle %}
				<p class="mt-[18px] font-display font-medium tracking-[-0.01em] text-sky-2
					{{ podstrona
						? (split ? 'max-w-[30ch]' : 'max-w-[32ch]') ~ ' text-[clamp(19px,1.9vw,26px)]'
						: (fields.subtitle_size == '26' ? 'text-[clamp(19px,1.9vw,26px)]' : 'text-[clamp(20px,2vw,28px)]') }}">
					{{ fields.subtitle }}
				</p>
			{% endif %}

			{% if fields.text %}
				<p class="{{ srodek ? 'text-[19px]' : 'text-[18px]' }}
					{{ barwyOpisu[fields.text_tone] ?: (srodek or split ? 'text-white/78 leading-[1.62]' : 'text-white/76 leading-[1.6]') }}
					{{ srodek ? 'mx-auto' }}
					{{ odstepyOpisu[fields.text_gap] ?: (srodek or split ? 'mt-6' : 'mt-[26px]') }}
					{{ szerokosciOpisu[fields.text_width] ?: (podstrona or srodek ? 'max-w-[62ch]' : 'max-w-[56ch]') }}">
					{{ fields.text }}
				</p>
			{% endif %}

			{% if fields.chips|length %}
				<div class="mt-8 flex flex-wrap gap-2.5">
					{% for pigulka in fields.chips %}
						<a href="{{ pigulka.link.url }}"
							class="rounded-pill border border-white/28 px-5 py-[11px] text-[15px] font-medium
								text-white transition hover:bg-white/12">
							{{ pigulka.link.title }}
						</a>
					{% endfor %}
				</div>
			{% endif %}

			{% if fields.button_primary.url or fields.button_secondary.url %}
				<div class="flex flex-wrap gap-3.5
					{{ srodek ? 'justify-center mt-[34px]' : (akcent ? 'mt-[34px]' : 'mt-8') }}">
					{% if fields.button_primary.url %}
						<a href="{{ fields.button_primary.url }}"
							{{ linkAttrs(fields.button_primary.url, fields.button_primary.target)|raw }}
							class="rounded-pill font-semibold transition
								{{ srodek ? 'bg-white px-8 py-[17px] text-[16px] text-ink hover:bg-accent-tint' : (akcent
									? 'bg-accent-cta px-9 py-5 text-[18px] text-white shadow-cta hover:bg-white hover:text-ink'
									: 'bg-white px-[30px] py-[17px] text-[16px] text-ink hover:bg-accent-tint') }}">
							{{ fields.button_primary.title }}
						</a>
					{% endif %}

					{% if fields.button_secondary.url %}
						<a href="{{ fields.button_secondary.url }}"
							{{ linkAttrs(fields.button_secondary.url, fields.button_secondary.target)|raw }}
							class="rounded-pill border border-white/32 px-[30px] py-[17px] text-[16px] font-semibold
								text-white transition hover:bg-white/10">
							{{ fields.button_secondary.title }}
						</a>
					{% endif %}
				</div>
			{% endif %}

			{% if fields.checks|length %}
				<div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-[15px] text-white/66
					{{ srodek ? 'justify-center' }}">
					{% for pozycja in fields.checks %}
						<span class="inline-flex items-center gap-2">
							<span aria-hidden="true" class="text-sky">✓</span>
							{{ pozycja.text }}
						</span>
					{% endfor %}
				</div>
			{% endif %}

			{% if fields.trust|length %}
				<div class="mt-[30px] flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/14 pt-[26px]">
					{% for pozycja in fields.trust %}
						{% set tresc %}
							{% if pozycja.stars %}
								<span class="text-[14px] tracking-[0.08em] text-sky">★★★★★</span>
							{% endif %}
							<span class="font-display text-[15px] font-semibold text-white">{{ pozycja.value }}</span>
							{% if pozycja.label %}
								<span class="text-[14.5px] text-white/{{ pozycja.stars ? '60' : '72' }}">{{ pozycja.label }}</span>
							{% endif %}
						{% endset %}

						{% if pozycja.url %}
							<a href="{{ pozycja.url }}" target="_blank" rel="noopener"
								class="inline-flex items-center gap-[9px] whitespace-nowrap transition hover:text-sky-2">{{ tresc }}</a>
						{% else %}
							<span class="inline-flex items-center gap-[9px] whitespace-nowrap">{{ tresc }}</span>
						{% endif %}
					{% endfor %}
				</div>
			{% endif %}

			{% if not split and fields.cards|length %}
				{% set siatkaKart = fields.cards|length > 3
					? 'grid-cols-4 max-xl:grid-cols-2 max-md:grid-cols-1'
					: 'grid-cols-[repeat(auto-fit,minmax(290px,1fr))]' %}

				<div class="mt-14 grid max-w-[1180px] gap-5 {{ siatkaKart }}">
					{% for card in fields.cards %}
						{% include 'blocks/hero/card.twig' with { card: card, wide: false, waska: fields.cards|length > 3 } only %}
					{% endfor %}
				</div>
			{% endif %}

			{% if not split and (fields.note_title or fields.note_link.url) %}
				{% include 'blocks/hero/note.twig' with { fields: fields } only %}
			{% endif %}
		</div>

		{% if split and fields.cards|length %}
			<div class="flex flex-col gap-5">
				{% for card in fields.cards %}
					{% include 'blocks/hero/card.twig' with { card: card, wide: true, waska: false } only %}
				{% endfor %}
			</div>
		{% endif %}
	</div>

	{% if fields.stats|length %}
		<div class="relative border-t border-white/12 bg-deep/72">
			<div class="mx-auto grid w-full max-w-page grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-5
				px-gutter py-[22px] text-center max-md:grid-cols-2 max-sm:gap-4 max-sm:px-5">
				{% for stat in fields.stats %}
					<div class="flex flex-col items-center gap-0.5">
						{% if stat.url %}
							<a href="{{ stat.url }}" target="_blank" rel="noopener"
								class="font-display text-[20px] font-semibold transition hover:text-sky-2
									{{ stat.highlight ? 'text-sky' : 'text-white' }}">
								{{ stat.value }}
							</a>
						{% else %}
							<span class="font-display text-[20px] font-semibold {{ stat.highlight ? 'text-sky' : '' }}">
								{{ stat.value }}
							</span>
						{% endif %}

						<span class="text-[14px] text-white/60">{{ stat.label }}</span>
					</div>
				{% endfor %}
			</div>
		</div>
	{% endif %}
</section>
