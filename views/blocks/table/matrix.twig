{% set wyrozniona = kolumny|filter(k => k.highlight)|keys|first %}
{% set domyslna = wyrozniona is null ? 0 : wyrozniona %}
{% set przelacznik = kolumny|length > 2 %}

<div {% if przelacznik %}data-matrix data-wybrany="{{ domyslna }}"{% endif %}>
	{% if przelacznik %}
		<div class="mb-4 hidden gap-2 max-md:grid max-md:grid-cols-2" role="group"
			aria-label="{{ __('Pakiet pokazany w tabeli', 'taxeon') }}">
			{% for indeks, kolumna in kolumny %}
				<button type="button"
					data-matrix-pakiet="{{ indeks }}"
					aria-pressed="{{ indeks == domyslna ? 'true' : 'false' }}"
					class="cursor-pointer rounded-card border border-line bg-white/90 px-3 py-2.5 text-left
						transition aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white">
					<span class="block font-display text-[13.5px] font-semibold">{{ kolumna.label }}</span>
					{% if kolumna.note %}
						<span class="block text-[12.5px] opacity-70">{{ kolumna.note }}</span>
					{% endif %}
				</button>
			{% endfor %}
		</div>
	{% endif %}

	<div class="overflow-hidden rounded-card border border-line bg-white/90 shadow-[0_24px_60px_-40px_rgb(6_26_80/0.35)] backdrop-blur-[8px]">
		<div class="grid {{ siatka }} items-end border-b border-line bg-[#f4f7fc]">
			<div class="py-[18px] font-display text-[14px] font-semibold tracking-[0.02em] text-ink
				px-[22px] max-sm:px-3 max-sm:text-[13px]">
				{{ fields.head_label }}
			</div>

			{% for indeks, kolumna in kolumny %}
				<div data-kolumna="{{ indeks }}"
					class="py-3.5 text-center font-display leading-[1.35] font-semibold
						{{ waskie ? 'px-2 text-[13px]' : 'px-2.5 text-[14px]' }}
						max-md:px-3 max-md:text-[14px]
						{{ kolumna.highlight ? 'bg-accent/6 text-accent' : 'text-ink' }}">
					{{ kolumna.label }}
					{% if kolumna.note %}<br><span class="font-normal text-ink-3">{{ kolumna.note }}</span>{% endif %}
				</div>
			{% endfor %}
		</div>

		{% for wiersz in fields.rows %}
			<div class="grid {{ siatka }} items-stretch border-b border-[#eef2f8] last:border-b-0">
				<div class="flex items-center py-[15px] leading-[1.45] text-ink-2
					px-[22px] text-[15px] max-sm:px-3 max-sm:text-[13.5px]">
					{{ wiersz.label }}
				</div>

				{% for indeks, wartosc in wiersz.values %}
					{% set wyrozniony = kolumny[indeks].highlight %}
					<div data-kolumna="{{ indeks }}"
						class="flex items-center justify-center px-2.5 py-[15px] text-center text-[17px]
							{{ wyrozniony ? 'bg-accent/[0.035] text-accent' : (wartosc.on ? 'text-[#1d2b45]' : 'text-ink-3') }}">
						<span class="sr-only">{{ wartosc.on ? __('jest w pakiecie', 'taxeon') : __('brak w pakiecie', 'taxeon') }}</span>
						<span aria-hidden="true">{{ wartosc.on ? '✓' : '—' }}</span>
					</div>
				{% endfor %}
			</div>
		{% endfor %}

		{% if kolumny|filter(k => k.cta.url)|length %}
			<div class="grid {{ siatka }} items-stretch border-t border-line bg-[#f7faff]">
				<div class="flex items-center py-[18px] font-display font-semibold text-ink
					px-[22px] text-[14px] max-sm:px-3 max-sm:text-[13px]">
					{{ fields.cta_label }}
				</div>

				{% for indeks, kolumna in kolumny %}
					<div data-kolumna="{{ indeks }}"
						class="flex items-center justify-center px-1.5 py-3 max-md:px-3
							{{ kolumna.highlight ? 'bg-accent/[0.035]' : '' }}">
						{% if kolumna.cta.url %}
							<a href="{{ kolumna.cta.url }}"
								{{ linkAttrs(kolumna.cta.url, kolumna.cta.target)|raw }}
								aria-label="{{ kolumna.cta.title|replace({ '→': '' })|trim }}"
								class="block w-full rounded-pill bg-accent-cta px-3 py-2.5 text-center text-[13px]
									leading-none font-semibold whitespace-nowrap text-white transition
									hover:bg-accent-strong">
								{{ __('Wybieram', 'taxeon') }}
							</a>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</div>
