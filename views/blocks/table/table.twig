{#
	Title: Porównanie
	Description: Tabela porównawcza wariantów z opisem po lewej
	Category: taxeon
	Icon: editor-table
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set kolumny = fields.columns|default([]) %}
{% set siatki = {
	1: 'grid-cols-[minmax(0,1fr)_118px] max-sm:grid-cols-[minmax(0,1fr)_72px]',
	2: 'grid-cols-[minmax(0,1fr)_118px_118px] max-sm:grid-cols-[minmax(0,1fr)_64px_64px]',
	3: 'grid-cols-[minmax(0,1fr)_96px_96px_96px] max-md:grid-cols-[minmax(0,1fr)_136px] max-sm:grid-cols-[minmax(0,1fr)_112px]',
	4: 'grid-cols-[minmax(0,1fr)_108px_108px_108px_108px] max-md:grid-cols-[minmax(0,1fr)_136px] max-sm:grid-cols-[minmax(0,1fr)_112px]'
} %}
{% set siatka = siatki[kolumny|length] ?: siatki[2] %}
{% set waskie = kolumny|length > 3 %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %} class="relative overflow-hidden {{ section.shell(fields) }}">
	{% include 'components/section-decor.twig' with { background: fields.background } only %}
	{% set onDark = section.isDark(fields) %}

	<div class="relative {{ section.container(fields) }}">
		{% if fields.head_position == 'above' %}
			{% include 'components/section-head.twig' with {
				size: fields.head_size,
			background: fields.background,
			headWidth: fields.head_width,
				titleWidth: fields.title_width,
				textWidth: fields.text_width,
			textGap: fields.text_gap,
				eyebrow: fields.eyebrow,
				title: fields.title,
				text: fields.text
			} only %}

			{% if fields.note %}
				<div class="mt-7 border-l-[3px] py-1 pl-[18px] [&_p]:text-[15px] [&_p]:leading-[1.65]
					{{ onDark ? 'border-gold-light [&_p]:text-white/86 [&_strong]:text-white' : 'border-navy [&_p]:text-ink' }}">
					{{ fields.note }}
				</div>
			{% endif %}

			<div class="mt-11">
				{% include 'blocks/table/matrix.twig' with { fields: fields, kolumny: kolumny, siatka: siatka, waskie: waskie, szklo: onDark and fields.surface == 'glass' } only %}
			</div>
		{% else %}
			<div class="grid grid-cols-[minmax(280px,0.85fr)_minmax(420px,1.3fr)] items-start gap-16
				max-xl:grid-cols-1 max-xl:gap-10">
				<div>
					{% include 'components/section-head.twig' with {
						size: fields.head_size,
			background: fields.background,
			headWidth: fields.head_width,
						titleWidth: fields.title_width,
						textWidth: fields.text_width,
			textGap: fields.text_gap,
						eyebrow: fields.eyebrow,
						title: fields.title,
						text: fields.text
					} only %}

					{% if fields.note %}
						<div class="mt-7 border-l-[3px] py-1 pl-[18px] [&_p]:text-[15px] [&_p]:leading-[1.65]
							{{ onDark ? 'border-gold-light [&_p]:text-white/86 [&_strong]:text-white' : 'border-navy [&_p]:text-ink' }}">
							{{ fields.note }}
						</div>
					{% endif %}
				</div>

				{% include 'blocks/table/matrix.twig' with { fields: fields, kolumny: kolumny, siatka: siatka, waskie: waskie, szklo: onDark and fields.surface == 'glass' } only %}
			</div>
		{% endif %}
	</div>
</section>
