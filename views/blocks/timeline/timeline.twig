{#
	Title: Oś czasu
	Description: Chronologia z rokiem, tytułem i opisem
	Category: raks
	Icon: clock
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow, title: fields.title, text: fields.text, onDark: onDark
		} only %}

		<ol class="reveal ml-3 grid gap-9 border-l-2 pl-9 {{ onDark ? 'border-white/15' : 'border-line' }}">
			{% for item in fields.items %}
				<li class="relative
					before:absolute before:top-1.5 before:-left-[43px] before:size-3.5 before:rounded-full
					before:border-2 before:content-['']
					{{ onDark ? 'before:border-deep-tint before:bg-navy' : 'before:border-accent before:bg-page' }}">

					<div class="font-display text-lead font-bold tracking-[-0.01em]
						{{ onDark ? 'text-deep-tint' : 'text-accent' }}">{{ item.year }}</div>

					{% include 'components/title-with-select-tag.twig' with {
						title: item.title,
						defaultTag: 'h3',
						titleClass: 'mt-1.5 font-display text-[19px] leading-[1.08] font-semibold tracking-[-0.02em] '
							~ (onDark ? 'text-white' : 'text-ink')
					} only %}

					{% include 'components/title-with-select-tag.twig' with {
						title: item.text,
						defaultTag: 'p',
						titleClass: 'mt-2 max-w-[68ch] text-body leading-[1.6] ' ~ (onDark ? 'text-white/82' : 'text-ink-2')
					} only %}
				</li>
			{% endfor %}
		</ol>
	</div>
</section>
