{#
	Title: Kroki
	Description: Ponumerowane kroki współpracy w jednym rzędzie
	Category: taxeon
	Icon: editor-ol
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set naGradiencie = fields.background == 'gradient' %}

<section class="relative overflow-hidden {{ section.shell(fields) }}">
	{% if onDark %}
		<div aria-hidden="true"
			class="absolute inset-0 bg-[radial-gradient(90%_60%_at_100%_0%,rgb(11_99_246/0.35),transparent_62%)]"></div>
	{% endif %}

	<div class="relative {{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			size: fields.head_size,
			headWidth: fields.head_width,
			titleWidth: fields.title_width,
			textWidth: fields.text_width,
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: onDark
		} only %}

		{% if fields.items|length %}
			<div class="mt-[52px] grid grid-cols-4 gap-px overflow-hidden rounded-card border
				max-xl:grid-cols-2 max-md:grid-cols-1
				{{ naGradiencie ? 'border-white/22 bg-white/18' : (onDark ? 'border-white/14 bg-white/14' : 'border-line bg-line') }}">
				{% for item in fields.items %}
					<div class="flex flex-col gap-3 px-[26px] py-8
						{{ item.featured
							? 'bg-[linear-gradient(160deg,rgb(11_99_246/0.9),rgb(10_52_168/0.9))]'
							: (naGradiencie ? 'bg-[rgb(6_16_50/0.35)] backdrop-blur-[14px]' : (onDark ? 'bg-deep' : 'bg-page')) }}">
						{% if item.number %}
							<span class="font-display text-[40px] leading-none font-bold tracking-[-0.04em]
								{{ item.featured ? 'text-white/50' : (naGradiencie ? 'text-accent-tint-2/50' : (onDark ? 'text-sky-2/35' : 'text-accent/35')) }}">
								{{ item.number }}
							</span>
						{% endif %}

						<h3 class="font-display text-[25px] leading-[1.2] font-semibold tracking-[-0.025em]
							{{ onDark or item.featured ? 'text-white' : 'text-ink' }}">
							{{ item.title }}
						</h3>

						{% if item.text %}
							<p class="text-[15px] leading-[1.6]
								{{ item.featured ? 'text-white/86' : (onDark ? 'text-white/72' : 'text-ink-3') }}">
								{{ item.text }}
							</p>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}

		{% if fields.cta_title or fields.cta_link.url %}
			<div class="mt-8 flex flex-wrap items-center gap-6 rounded-card border px-[30px] py-[26px]
				backdrop-blur-[12px] {{ onDark ? 'border-white/16 bg-white/6' : 'border-line bg-soft' }}">
				<div>
					<div class="font-display text-[22px] font-semibold tracking-[-0.02em] {{ onDark ? 'text-white' : 'text-ink' }}">
						{{ fields.cta_title }}
					</div>

					{% if fields.cta_text %}
						<div class="mt-1 text-[16px] {{ onDark ? 'text-white/72' : 'text-ink-3' }}">{{ fields.cta_text }}</div>
					{% endif %}
				</div>

				{% if fields.cta_link.url %}
					<a href="{{ fields.cta_link.url }}"
						{{ linkAttrs(fields.cta_link.url, fields.cta_link.target)|raw }}
						class="ml-auto rounded-pill px-[30px] py-4 text-[16px] font-semibold whitespace-nowrap transition
							{{ onDark ? 'bg-white text-ink hover:bg-accent-tint' : 'bg-accent text-white hover:bg-accent-strong' }}
							max-sm:ml-0">
						{{ fields.cta_link.title }}
					</a>
				{% endif %}
			</div>
		{% endif %}
	</div>
</section>
