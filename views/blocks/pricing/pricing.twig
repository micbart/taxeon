{#
	Title: Cennik (karty)
	Description: Karty z ceną, listą punktów i przyciskiem; jedna może być wyróżniona
	Category: taxeon
	Icon: money-alt
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

{% set cols = {
	'2': 'grid-cols-2 max-lg:grid-cols-1',
	'3': 'grid-cols-3 max-xl:grid-cols-2 max-sm:grid-cols-1',
	'4': 'grid-cols-4 max-2xl:grid-cols-2 max-sm:grid-cols-1'
} %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: section.isDark(fields)
		} only %}

		{% set paraZWyroznieniem = fields.cards|length == 2 and fields.cards|filter(c => c.featured)|length == 1 %}
		{% set isDownload = fields.variant == 'download' %}

		<div class="grid items-stretch gap-6 {{ isDownload ? 'grid-cols-2 max-[860px]:grid-cols-1' : cols[fields.columns ?: '3'] }}">
			{% for card in fields.cards %}
				{% if isDownload %}
				<div class="relative flex flex-col rounded-panel p-8 max-sm:px-6 max-sm:py-7
					{{ card.featured
						? 'border border-transparent bg-[image:var(--gradient-deep)] text-white shadow-navy'
						: (paraZWyroznieniem ? 'gradient-frame' : 'border border-line bg-white shadow-soft') }}">

					<div class="flex items-center gap-4">
						{% if card.icon %}
							<span class="grid size-[54px] flex-none place-items-center rounded-[14px] [&_svg]:size-[27px]
								{{ card.featured ? 'bg-white/14 text-white' : 'bg-accent-soft text-accent' }}">
								{{ card.icon|svg }}
							</span>
						{% endif %}

						<div class="min-w-0">
							{% include 'components/title-with-select-tag.twig' with {
								title: card.title,
								defaultTag: 'h3',
								titleClass: 'font-display text-[22px] leading-[1.08] font-semibold tracking-[-0.02em] '
									~ (card.featured ? 'text-white' : 'text-ink')
							} only %}

							{% if card.tag %}
								<div class="mt-[3px] text-sm {{ card.featured ? 'text-white/72' : 'text-ink-3' }}">{{ card.tag }}</div>
							{% endif %}
						</div>
					</div>

					{% include 'components/title-with-select-tag.twig' with {
						title: card.text,
						defaultTag: 'p',
						titleClass: 'mt-[18px] flex-1 text-[15px] leading-[1.55] ' ~ (card.featured ? 'text-white/80' : 'text-ink-2')
					} only %}

					{% if card.button.link.url or card.button_secondary.link.url %}
						<div class="mt-6 flex flex-wrap gap-3">
							{% include 'components/button.twig' with {
								button: card.button,
								variant: card.featured ? 'on-navy' : null,
								class: 'min-w-[150px] flex-1'
							} only %}

							{% include 'components/button.twig' with {
								button: card.button_secondary,
								variant: card.featured ? 'ghost-navy' : null,
								class: 'min-w-[150px] flex-1'
							} only %}
						</div>
					{% endif %}

					{% if card.links|length %}
						<div class="mt-[22px] flex flex-wrap items-center gap-x-[26px] gap-y-[18px]">
							{% for l in card.links %}
								{% if l.link.url %}
									<a href="{{ l.link.url }}"
										target="{{ l.link.target ?: '_self' }}"
										{% if l.link.target == '_blank' %}rel="noopener"{% endif %}
										class="inline-flex items-center gap-2 text-[14.5px] font-bold
											{{ card.featured ? 'text-deep-tint' : 'text-accent' }} [&_svg]:size-[17px]">
										{% if l.icon %}{{ l.icon|svg }}{% endif %}
										{{ l.link.title }}
									</a>
								{% endif %}
							{% endfor %}
						</div>
					{% endif %}
				</div>
				{% else %}
				<div class="relative flex flex-col overflow-hidden rounded-panel p-[34px] transition
					{{ card.featured
						? 'border border-transparent bg-[image:var(--gradient-deep)] text-white shadow-navy'
						: (paraZWyroznieniem
							? 'gradient-frame hover:-translate-y-1'
							: 'border border-line bg-white hover:-translate-y-1 hover:shadow-mid') }}">

					{% if card.featured and card.flag %}
						<span class="absolute top-5 right-5 rounded-full bg-white/16 px-3 py-[5px] text-[11.5px]
							font-bold tracking-[0.08em] text-white uppercase max-sm:static max-sm:mb-3.5 max-sm:self-start">
							{{ card.flag }}
						</span>
					{% endif %}

					{% if card.tag %}
						<span class="inline-flex items-center gap-2 text-[13px] font-bold tracking-[0.06em] uppercase
							{{ card.featured ? 'text-deep-tint' : 'text-accent' }} [&_svg]:size-4">
							{% if card.icon %}{{ card.icon|svg }}{% endif %}
							{{ card.tag }}
						</span>
					{% endif %}

					{% include 'components/title-with-select-tag.twig' with {
						title: card.title,
						defaultTag: 'h3',
						titleClass: 'mt-3.5 font-display text-[23px] leading-[1.08] font-semibold tracking-[-0.02em] '
							~ (card.featured ? 'text-white' : 'text-ink')
					} only %}

					{% include 'components/title-with-select-tag.twig' with {
						title: card.text,
						defaultTag: 'p',
						titleClass: 'mt-2 min-h-[44px] text-label ' ~ (card.featured ? 'text-white/82' : 'text-ink-2')
					} only %}

					{% if card.price %}
						<div class="mt-[22px] font-display text-[42px] leading-none font-bold tracking-[-0.02em]
							{{ card.featured ? 'text-white' : 'text-ink' }}">
							{{ card.price }}
							{% if card.price_suffix %}
								<small class="font-sans text-[15px] font-semibold {{ card.featured ? 'text-white/60' : 'text-ink-3' }}">
									{{ card.price_suffix }}
								</small>
							{% endif %}
						</div>
					{% endif %}

					{% if card.note %}
						<p class="mt-2 text-meta {{ card.featured ? 'text-white/60' : 'text-ink-3' }}">{{ card.note }}</p>
					{% endif %}

					{% if card.items|length %}
						<ul class="mt-6 grid gap-3">
							{% for item in card.items %}
								<li class="flex items-start gap-[11px] text-[15px] {{ card.featured ? 'text-white' : 'text-ink' }}
									[&_svg]:mt-0.5 [&_svg]:size-[19px] {{ card.featured ? '[&_svg]:text-deep-tint-2' : '[&_svg]:text-accent' }}">
									{{ 'check'|svg }}
									{{ item.text }}
								</li>
							{% endfor %}
						</ul>
					{% endif %}

					<div class="mt-auto grid gap-3 pt-7">
						{% include 'components/button.twig' with {
							button: card.button,
							variant: card.featured ? 'on-navy' : null,
							block: true
						} only %}

						{% include 'components/button.twig' with {
							button: card.button_secondary,
							variant: card.featured ? 'ghost-navy' : null,
							block: true
						} only %}

						{% if card.links|length %}
							<div class="flex flex-wrap gap-x-6 gap-y-2 pt-1">
								{% for l in card.links %}
									{% if l.link.url %}
										<a href="{{ l.link.url }}"
											target="{{ l.link.target ?: '_self' }}"
											class="inline-flex items-center gap-2 text-label font-bold
												{{ card.featured ? 'text-deep-tint' : 'text-accent' }} [&_svg]:size-[17px]">
											{% if l.icon %}{{ l.icon|svg }}{% endif %}
											{{ l.link.title }}
										</a>
									{% endif %}
								{% endfor %}
							</div>
						{% endif %}
					</div>
				</div>
				{% endif %}
			{% endfor %}
		</div>
	</div>
</section>
