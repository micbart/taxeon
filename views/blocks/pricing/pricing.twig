{#
	Title: Cennik (jeden plan)
	Description: Wyśrodkowana karta z ceną i przełącznikiem okresu rozliczenia
	Category: taxeon
	Icon: money-alt
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set okresy = fields.periods|default([]) %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="relative overflow-hidden scroll-mt-header {{ section.shell(fields) }}">
	{% include 'components/section-decor.twig' with { background: fields.background } only %}

	<div class="relative {{ section.container(fields) }}">
		<div class="mx-auto max-w-[60ch] text-center">
			{% include 'components/section-head.twig' with {
				size: fields.head_size,
				titleWidth: fields.title_width,
				eyebrow: fields.eyebrow,
				title: fields.title,
				center: true
			} only %}

			{% if fields.checks|length %}
				<div class="mt-[18px] flex flex-wrap justify-center gap-x-[22px] gap-y-2.5 text-[16px] text-ink-3">
					{% for pozycja in fields.checks %}
						<span class="inline-flex items-center gap-2">
							<span aria-hidden="true" class="text-accent">✓</span>
							{{ pozycja.text }}
						</span>
					{% endfor %}
				</div>
			{% endif %}
		</div>

		<div data-tabs>
			{% if okresy|length > 1 %}
				<div class="mt-[34px] flex justify-center">
					<div role="tablist" class="inline-flex gap-1 rounded-pill bg-line p-[5px]">
						{% for okres in okresy %}
							<button type="button"
								role="tab"
								data-tab="{{ block.id }}-{{ loop.index }}"
								data-active="{{ loop.first ? 'true' : 'false' }}"
								class="cursor-pointer rounded-pill px-6 py-2.5 font-display text-[15px] font-semibold
									text-ink-3 transition
									data-[active=true]:bg-page data-[active=true]:text-ink
									data-[active=true]:shadow-[0_6px_16px_-8px_rgb(6_16_36/0.6)]">
								{{ okres.label }}
							</button>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{% for okres in okresy %}
				<div data-panel="{{ block.id }}-{{ loop.index }}"
					{% if not loop.first %}hidden{% endif %}
					class="mx-auto mt-8 max-w-[460px] rounded-[24px] border border-line bg-page px-10 py-11
						text-center shadow-[0_40px_80px_-50px_rgb(6_16_36/0.6)] max-sm:px-7">

					{% if fields.plan_label %}
						<div class="text-[13px] font-semibold tracking-[0.12em] text-accent uppercase">
							{{ fields.plan_label }}
						</div>
					{% endif %}

					<div class="mt-5 flex items-baseline justify-center gap-2">
						<span class="font-display text-[84px] leading-none font-bold tracking-[-0.04em] text-ink">
							{{ okres.price }}
						</span>

						{% if fields.currency %}
							<span class="font-display text-[26px] font-semibold text-ink">{{ fields.currency }}</span>
						{% endif %}
					</div>

					{% if okres.note %}
						<div class="mt-2 text-[15px] text-ink-3">{{ okres.note }}</div>
					{% endif %}

					<div class="my-7 h-px bg-line"></div>

					{% if fields.items|length %}
						<div class="mb-[30px] flex flex-col gap-[13px] text-left">
							{% for item in fields.items %}
								<span class="flex gap-[11px] text-[15.5px] text-ink-2">
									<span aria-hidden="true" class="flex-none text-accent">✓</span>
									{{ item.text }}
								</span>
							{% endfor %}
						</div>
					{% endif %}

					{% if fields.link.url %}
						<a href="{{ fields.link.url }}"
							target="{{ fields.link.target ?: '_self' }}"
							class="block rounded-pill bg-accent-cta px-6 py-[17px] text-[17px] font-semibold
								text-white shadow-[0_16px_34px_-16px_rgb(18_104_255/0.9)] transition
								hover:bg-accent-strong">
							{{ fields.link.title }}
						</a>
					{% endif %}

					{% if fields.note %}
						<p class="mt-[14px] text-[13.5px] text-ink-4">{{ fields.note }}</p>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	</div>
</section>
