{#
	Title: Programy
	Description: Siatka kart produktowych ze zdjęciem, opisem i tagami
	Category: raks
	Icon: grid-view
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text
		} only %}

		<div class="grid grid-cols-3 gap-[26px] max-xl:grid-cols-1">
			{% for item in fields.programs %}
				<article class="reveal flex flex-col overflow-hidden rounded-panel border border-line bg-white
					transition hover:-translate-y-[5px] hover:shadow-deep">

					{% if item.image %}
						<div class="relative aspect-16/7 overflow-hidden bg-soft">
							{% include 'components/image.twig' with {
								id: item.image.ID,
								size: 'raks-tile',
								sizes: '(max-width: 920px) 100vw, 33vw',
								altFrom: item.title,
								class: 'absolute inset-0 size-full object-cover'
							} only %}

							<div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[image:var(--gradient-shade-bottom)]"></div>
						</div>
					{% endif %}

					<div class="px-[30px] pt-[26px]">
						{% include 'components/title-with-select-tag.twig' with {
							title: item.title,
							defaultTag: 'h3',
							titleClass: 'font-display text-[22px] leading-[1.08] font-semibold tracking-[-0.02em] text-ink'
						} only %}

						{% include 'components/title-with-select-tag.twig' with {
							title: item.text,
							defaultTag: 'p',
							titleClass: 'mt-3 text-body text-ink-2'
						} only %}
					</div>

					{% if item.tags|length %}
						<div class="flex flex-wrap gap-2 px-[30px] py-[22px]">
							{% for tag in item.tags %}
								<span class="rounded-full border border-line bg-soft px-3 py-1.5 text-[13px] font-semibold text-ink-2">
									{{ tag.label }}
								</span>
							{% endfor %}
						</div>
					{% endif %}

					{% if item.link.url %}
						<div class="mt-auto flex items-center justify-between border-t border-line px-[30px] py-5">
							<a href="{{ item.link.url }}"
								target="{{ item.link.target ?: '_self' }}"
								class="group/link inline-flex items-center gap-[7px] font-bold text-accent
									[&_svg]:size-[17px] [&_svg]:transition-transform group-hover/link:[&_svg]:translate-x-1">
								{{ item.link.title ?: __('Dowiedz się więcej', 'raks') }}
								{{ 'arrow-right'|svg }}
							</a>
						</div>
					{% endif %}
				</article>
			{% endfor %}
		</div>
	</div>
</section>
