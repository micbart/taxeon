{#
	Title: Zakładki
	Description: Lista przycisków po lewej i panel z opisem kroku po prawej
	Category: taxeon
	Icon: index-card
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="relative overflow-hidden {{ section.shell(fields) }}">
	{% include 'components/section-decor.twig' with { background: fields.background } only %}

	<div class="relative {{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			size: fields.head_size,
			headWidth: fields.head_width,
			titleWidth: fields.title_width,
			textWidth: fields.text_width,
			eyebrow: fields.eyebrow,
			title: fields.title,
			onDark: onDark,
			titleSize: 'text-[clamp(30px,3.2vw,46px)] leading-[1.1]'
		} only %}

		{% if fields.items|length %}
			<div data-tabs class="mt-11 grid grid-cols-[320px_minmax(0,1fr)] items-stretch gap-7
				max-xl:grid-cols-1">
				<div role="tablist" aria-orientation="vertical" class="flex h-full flex-col gap-2.5">
					{% for item in fields.items %}
						<button type="button"
							role="tab"
							data-tab="{{ block.id }}-{{ loop.index }}"
							data-active="{{ loop.first ? 'true' : 'false' }}"
							aria-controls="{{ block.id }}-{{ loop.index }}"
							class="flex flex-1 basis-0 cursor-pointer flex-col justify-center gap-[5px]
								rounded-tile border px-[22px] py-5 text-left transition
								border-[#d7e1f0] bg-white/72 text-ink-2
								data-[active=true]:border-ink data-[active=true]:bg-ink
								data-[active=true]:text-white
								data-[active=true]:shadow-[0_18px_40px_-26px_rgb(6_16_36/0.9)]">
							<span class="font-display text-[17px] font-semibold tracking-[-0.02em]">{{ item.title }}</span>

							{% if item.hint %}
								<span class="text-[14.5px] leading-[1.5] opacity-72">{{ item.hint }}</span>
							{% endif %}
						</button>
					{% endfor %}
				</div>

				<div>
					{% for item in fields.items %}
						<div role="tabpanel"
							id="{{ block.id }}-{{ loop.index }}"
							data-panel="{{ block.id }}-{{ loop.index }}"
							{% if not loop.first %}hidden{% endif %}
							class="min-h-[340px] rounded-[20px] border border-line bg-page px-[42px] py-10
								shadow-[0_40px_90px_-70px_rgb(6_16_36/0.7)] max-sm:px-7">
							{% if item.step %}
								<span class="font-mono text-[12px] tracking-[0.08em] text-accent uppercase">{{ item.step }}</span>
							{% endif %}

							<h3 class="mt-3 font-display text-[28px] leading-[1.2] font-semibold
								tracking-[-0.03em] text-ink">{{ item.title }}</h3>

							{% if item.text %}
								<p class="mt-[14px] max-w-[56ch] text-[17px] leading-[1.68] text-body">{{ item.text }}</p>
							{% endif %}

							{% if item.points|length %}
								<div class="mt-[26px] flex flex-col gap-3 border-t border-[#eef2f8] pt-6">
									{% for point in item.points %}
										<span class="flex gap-3 text-[16px] leading-[1.55] text-ink-2">
											<span aria-hidden="true" class="flex-none text-accent">✓</span>
											{{ point.text }}
										</span>
									{% endfor %}
								</div>
							{% endif %}
						</div>
					{% endfor %}
				</div>
			</div>
		{% endif %}
	</div>
</section>
