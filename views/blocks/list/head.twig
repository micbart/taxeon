		{% include 'components/section-head.twig' with {
			size: fields.head_size,
			background: fields.background,
			headWidth: fields.head_width,
			titleWidth: fields.title_width,
			textWidth: fields.text_width,
			textGap: fields.text_gap,
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: onDark
		} only %}

		{% if fields.link.url and (ikony or fields.link_style == 'button') %}
			<div class="flex flex-wrap gap-3.5 {{ onDark ? 'mt-[30px]' : (ikony ? 'mt-[26px]' : 'mt-6') }}">
				<a href="{{ fields.link.url }}"
					{{ linkAttrs(fields.link.url, fields.link.target)|raw }}
					class="rounded-pill font-semibold transition
						{{ onDark
							? 'bg-white px-8 py-[17px] text-[16px] text-ink hover:bg-accent-tint'
							: 'bg-accent-cta px-7 py-4 text-[16px] text-white shadow-[0_16px_34px_-16px_rgb(18_104_255/0.9)] hover:bg-accent-strong' }}">
					{{ fields.link.title }}
				</a>
			</div>

			{% if fields.note %}
				<p class="mt-[14px] text-[13.5px] {{ onDark ? 'text-white/50' : 'text-ink-4' }}">{{ fields.note }}</p>
			{% endif %}
		{% elseif fields.link.url %}
			<a href="{{ fields.link.url }}"
				{{ linkAttrs(fields.link.url, fields.link.target)|raw }}
				class="mt-5 inline-block text-[15px] font-semibold
					{{ onDark ? 'text-sky-2 hover:text-white' : 'text-accent hover:text-accent-strong' }}">
				{{ fields.link.title }}
			</a>
		{% endif %}
