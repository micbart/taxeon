{#
	Title: Lista z nagłówkiem
	Description: Opis po lewej, lista wierszy z wyróżnioną wartością po prawej
	Category: taxeon
	Icon: editor-ul
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set kolumny = { '1': '', '2': 'grid grid-cols-2 max-md:grid-cols-1', '3': 'grid grid-cols-3 max-xl:grid-cols-2 max-md:grid-cols-1', '4': 'grid grid-cols-4 max-xl:grid-cols-2 max-md:grid-cols-1' } %}
{% set siatka = kolumny[fields.columns ?: '1'] %}
{% set barwyWartosci = onDark ? { 'muted': 'text-white/60', 'free': 'text-gold-light' } : { 'muted': 'text-ink-3', 'free': 'text-gold-dark' } %}
{% set kartaWiersza = onDark
	? 'border-white/22 bg-white/10 backdrop-blur-[8px]'
	: 'border-line bg-white/90 backdrop-blur-[8px]' %}

{% set ikony = fields.row_style == 'icon' %}
{% set proporcje = {
	'1-0.9': 'grid-cols-[minmax(280px,1fr)_minmax(320px,0.9fr)] gap-16',
	'0.85-1.3': 'grid-cols-[minmax(280px,0.85fr)_minmax(420px,1.3fr)] gap-16',
	'0.8-1.2': 'grid-cols-[minmax(280px,0.8fr)_minmax(420px,1.2fr)] gap-14',
	'0.7-1.3': 'grid-cols-[minmax(260px,0.7fr)_minmax(420px,1.3fr)] gap-16',
	'0.6-1.4': 'grid-cols-[minmax(240px,0.6fr)_minmax(420px,1.4fr)] gap-14'
} %}
{% set jasne = fields.background in ['', 'page'] %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %} class="relative overflow-hidden
	{{ section.shell(fields, jasne ? 'bg-[image:var(--gradient-light)]' : '') }}">
	{% include 'components/section-decor.twig' with {
		background: jasne ? 'light' : fields.background,
		glow: fields.row_style == 'icon'
	} only %}

	<div class="relative {{ section.container(fields) }}">
		{% if fields.head_position == 'above' %}
			{% include 'blocks/list/head.twig' with { fields: fields, onDark: onDark, ikony: ikony } only %}

			<div class="mt-11">
				{% include 'blocks/list/rows.twig' with {
					fields: fields, onDark: onDark, ikony: ikony,
					siatka: siatka, kartaWiersza: kartaWiersza, barwyWartosci: barwyWartosci
				} only %}
			</div>
		{% else %}
			<div class="grid max-xl:grid-cols-1 max-xl:gap-10
				{{ ikony
					? 'items-center gap-[52px] ' ~ (onDark ? 'grid-cols-[0.9fr_1.1fr]' : 'grid-cols-[0.85fr_1.15fr]')
					: 'items-start ' ~ (proporcje[fields.columns_ratio] ?: 'grid-cols-[minmax(280px,0.85fr)_minmax(420px,1.15fr)] gap-16') }}">
				<div>
					{% include 'blocks/list/head.twig' with { fields: fields, onDark: onDark, ikony: ikony } only %}
				</div>

				{% include 'blocks/list/rows.twig' with {
					fields: fields, onDark: onDark, ikony: ikony,
					siatka: siatka, kartaWiersza: kartaWiersza, barwyWartosci: barwyWartosci
				} only %}
			</div>
		{% endif %}
	</div>
</section>
