{#
	Title: Lista z nagłówkiem
	Description: Opis po lewej, lista wierszy z wyróżnioną wartością po prawej
	Category: taxeon
	Icon: editor-ul
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set kolumny = { '1': '', '2': 'grid grid-cols-2 max-md:grid-cols-1', '3': 'grid grid-cols-3 max-xl:grid-cols-2 max-md:grid-cols-1' } %}
{% set siatka = kolumny[fields.columns ?: '1'] %}
{% set barwyWartosci = { 'muted': 'text-accent-tint-2', 'free': 'text-[#9be7ff]' } %}
{% set kartaWiersza = onDark
	? 'border-white/22 bg-white/10 backdrop-blur-[8px]'
	: 'border-line bg-white/90 backdrop-blur-[8px]' %}

{% set jasne = fields.background in ['', 'page'] %}

<section class="relative overflow-hidden
	{{ section.shell(fields, jasne ? 'bg-[linear-gradient(180deg,#ffffff_0%,#f7faff_45%,#e8f0fe_100%)]' : '') }}">
	{% if jasne %}
		<div aria-hidden="true"
			class="absolute inset-0 bg-[radial-gradient(75%_55%_at_85%_100%,rgb(18_104_255/0.16),transparent_70%),radial-gradient(60%_50%_at_0%_15%,rgb(69_208_255/0.1),transparent_72%)]"></div>

		<div aria-hidden="true"
			class="absolute inset-0 [mask-image:linear-gradient(180deg,transparent,#000_55%)]
				bg-[repeating-linear-gradient(45deg,rgb(11_99_246/0.06)_0_1px,transparent_1px_54px),repeating-linear-gradient(-45deg,rgb(11_99_246/0.06)_0_1px,transparent_1px_54px)]"></div>
	{% elseif fields.background == 'gradient' %}
		<div aria-hidden="true" class="absolute inset-0 bg-[image:var(--gradient-blue-glow)]"></div>
	{% endif %}

	<div class="relative {{ section.container(fields) }}">
		<div class="grid grid-cols-[minmax(280px,0.85fr)_minmax(420px,1.15fr)] items-start gap-16
			max-xl:grid-cols-1 max-xl:gap-10">
			<div>
				{% include 'components/section-head.twig' with {
					eyebrow: fields.eyebrow,
					title: fields.title,
					text: fields.text,
					onDark: onDark
				} only %}

				{% if fields.link.url %}
					<a href="{{ fields.link.url }}"
						target="{{ fields.link.target ?: '_self' }}"
						class="mt-5 inline-block text-[15px] font-semibold
							{{ onDark ? 'text-sky-2 hover:text-white' : 'text-accent hover:text-accent-strong' }}">
						{{ fields.link.title }}
					</a>
				{% endif %}
			</div>

			<div class="{{ siatka ?: 'flex flex-col' }} {{ fields.columns == '3' ? 'gap-3.5' : 'gap-3' }}">
				{% for item in fields.items %}
					{% if fields.row_style == 'numbered' %}
						<div class="flex items-baseline gap-4 rounded-sm border px-6 py-5 {{ kartaWiersza }}">
							<span class="flex-none font-display text-[15px] font-semibold
								{{ onDark ? 'text-sky-2' : 'text-accent' }}">{{ item.value }}</span>
							<span class="text-[16px] leading-[1.55] {{ onDark ? 'text-white/88' : 'text-ink-2' }}">{{ item.label }}</span>
						</div>
					{% elseif fields.row_style == 'stacked' %}
						<div class="flex flex-col gap-1.5 rounded-card border px-[26px] py-6 {{ kartaWiersza }}">
							<span class="font-display font-semibold tracking-[-0.02em]
								{{ fields.columns == '3' ? 'text-[19px]' : 'text-[20px]' }}
								{{ onDark ? 'text-white' : 'text-ink' }}">{{ item.label }}</span>
							{% if item.text %}
								<span class="leading-[1.58] text-pretty
									{{ fields.columns == '3' ? 'text-[15px]' : 'text-[16px]' }}
									{{ onDark ? 'text-white/80' : 'text-ink-3' }}">{{ item.text }}</span>
							{% endif %}
						</div>
					{% else %}
						<div class="flex items-center justify-between gap-[18px] rounded-sm border px-6 py-5 {{ kartaWiersza }}">
							<span class="text-[17px] leading-[1.5] {{ onDark ? 'text-white/88' : 'text-ink-2' }}">{{ item.label }}</span>
							{% if item.value %}
								<span class="font-display text-[15px] font-semibold whitespace-nowrap
									{{ barwyWartosci[item.tone] ?: (onDark ? 'text-white' : 'text-accent') }}">
									{{ item.value }}
								</span>
							{% endif %}
						</div>
					{% endif %}
				{% endfor %}
			</div>
		</div>
	</div>
</section>
