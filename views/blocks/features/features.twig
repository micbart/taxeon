{#
	Title: Wyróżniki
	Description: Siatka kafli z ikoną, opcjonalnie na zdjęciu w tle — sekcja „Dlaczego"
	Category: raks
	Icon: awards
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

{% set isList = fields.layout == 'list' %}
{% set isInline = fields.layout == 'cards-inline' %}
{% set iconBeside = isList or isInline %}
{% set cols = {
	'1': 'grid-cols-1',
	'2': 'grid-cols-2 max-md:grid-cols-1',
	'3': 'grid-cols-3 max-xl:grid-cols-2 max-sm:grid-cols-1',
	'4': 'grid-cols-4 max-2xl:grid-cols-2 max-sm:grid-cols-1'
} %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="relative isolate {{ section.shell(fields, classes) }}">

	{% if fields.background_image %}
		{% include 'components/image.twig' with {
			id: fields.background_image.ID,
			size: 'raks-wide-2x',
			sizes: '100vw',
			alt: '',
			class: 'absolute inset-0 z-0 size-full overflow-hidden rounded-section object-cover object-[50%_40%] max-md:rounded-section-sm'
		} only %}

		<div aria-hidden="true"
			class="pointer-events-none absolute inset-0 z-[1] rounded-section bg-[image:var(--gradient-shade-wide)] max-md:rounded-section-sm"></div>
	{% endif %}

	<div class="relative z-[2] mx-auto w-full max-w-page px-gutter max-sm:px-5">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: fields.background_image or section.isDark(fields)
		} only %}

		<div class="grid auto-rows-fr {{ cols[fields.columns ?: '4'] }} {{ isList ? 'gap-x-10 gap-y-[18px]' : 'gap-[22px]' }}">
			{% for item in fields.items %}
				<div class="reveal {{ isList
					? 'flex items-start gap-4 py-1'
					: (isInline
						? 'flex items-start gap-[18px] rounded-panel border border-line bg-white p-7 transition hover:-translate-y-1 hover:border-transparent hover:shadow-mid'
						: 'rounded-panel border border-line bg-white px-[26px] py-[30px] transition hover:-translate-y-1 hover:border-transparent hover:shadow-mid') }}">

					{% if item.icon %}
						<span class="grid flex-none place-items-center rounded-[13px] bg-accent-soft text-accent
							{{ isList ? 'size-[46px] [&_svg]:size-[23px]' : '' }}
							{{ isInline ? 'size-[50px] rounded-[14px] [&_svg]:size-[25px]' : '' }}
							{{ iconBeside ? '' : 'mb-[22px] size-13 rounded-[14px] [&_svg]:size-[26px]' }}">
							{{ item.icon|svg }}
						</span>
					{% endif %}

					<div>

					{% include 'components/title-with-select-tag.twig' with {
							title: item.title,
							defaultTag: 'h3',
							titleClass: 'font-display leading-[1.08] font-semibold tracking-[-0.02em] text-ink '
								~ (isList ? 'text-lg' : (isInline ? 'text-[19px]' : 'text-xl'))
						} only %}

						{% include 'components/title-with-select-tag.twig' with {
							title: item.text,
							defaultTag: 'p',
							titleClass: 'leading-[1.55] text-ink-2 '
								~ (isList ? 'mt-[5px] text-[15px]' : (isInline ? 'mt-[9px] text-[15px]' : 'mt-3 text-body'))
						} only %}
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
