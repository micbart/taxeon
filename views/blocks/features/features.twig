{#
	Title: Karty
	Description: Siatka kart z nadkreśleniem, tytułem, opisem i odnośnikiem
	Category: taxeon
	Icon: grid
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set kolumny = { '2': 'grid-cols-2', '3': 'grid-cols-3', '4': 'grid-cols-4' } %}

<section class="relative overflow-hidden {{ section.shell(fields) }}">
	{% if fields.background == 'gradient' %}
		<div aria-hidden="true" class="absolute inset-0 bg-[image:var(--gradient-blue-glow)]"></div>
	{% endif %}

	<div class="relative {{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: onDark
		} only %}

		{% if fields.items|length %}
			<div class="mt-[52px] grid gap-6 {{ kolumny[fields.columns ?: '2'] }}
				max-xl:grid-cols-2 max-md:grid-cols-1">
				{% for item in fields.items %}
					<div class="flex min-h-[340px] flex-col gap-4 rounded-panel px-[38px] py-10 max-sm:px-6
						{{ onDark
							? 'border border-white/24 bg-white/11 shadow-[inset_0_1px_0_rgb(255_255_255/0.22),0_24px_50px_-30px_rgb(3_8_40/0.7)] backdrop-blur-[18px] backdrop-saturate-[1.3] transition hover:-translate-y-[3px] hover:border-white/45 hover:bg-white/18'
							: 'border border-line bg-page shadow-soft transition hover:-translate-y-[3px] hover:shadow-mid' }}">

						{% if item.kicker %}
							<span class="font-display text-[13px] font-semibold tracking-[0.1em] uppercase
								{{ onDark ? 'text-accent-tint-2' : 'text-accent' }}">
								{{ item.kicker }}
							</span>
						{% endif %}

						<h3 class="font-display text-[34px] leading-[1.12] font-semibold tracking-[-0.025em]
							{{ onDark ? 'text-white' : 'text-ink' }} max-sm:text-[28px]">
							{{ item.title }}
						</h3>

						{% if item.text %}
							<p class="max-w-[44ch] text-[17px] leading-[1.62] {{ onDark ? 'text-white/84' : 'text-ink-3' }}">
								{{ item.text }}
							</p>
						{% endif %}

						{% if item.link.url %}
							<a href="{{ item.link.url }}"
								target="{{ item.link.target ?: '_self' }}"
								class="mt-auto text-[16px] font-semibold
									{{ onDark ? 'text-white hover:text-accent-tint-2' : 'text-accent hover:text-accent-strong' }}">
								{{ item.link.title }}
							</a>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
