{#
	Title: Karty
	Description: Siatka kart z nadkreśleniem, tytułem, opisem i odnośnikiem
	Category: taxeon
	Icon: grid
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set kolumny = { '2': 'grid-cols-2', '3': 'grid-cols-3', '4': 'grid-cols-4' } %}
{% set rozmiar = fields.size ?: 'lg' %}
{% set maly = rozmiar == 'sm' %}
{% set duze = rozmiar == 'lg' %}

<section class="relative overflow-hidden {{ section.shell(fields) }}">
	{% include 'components/section-decor.twig' with { background: fields.background } only %}

	<div class="relative {{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			size: fields.head_size,
			headWidth: fields.head_width,
			titleWidth: fields.title_width,
			textWidth: fields.text_width,
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			onDark: onDark
		} only %}

		{% if fields.items|length %}
			<div class="grid {{ maly ? 'mt-[46px] gap-[18px]' : 'mt-[52px] gap-6' }}
				{{ kolumny[fields.columns ?: '2'] }} max-xl:grid-cols-2 max-md:grid-cols-1">
				{% for item in fields.items %}
					<div class="flex flex-col max-sm:px-6
						{{ maly ? 'gap-2.5 rounded-card px-[26px] py-7' : 'rounded-panel' }}
						{{ duze ? 'min-h-[340px] gap-4 px-[38px] py-10' : '' }}
						{{ rozmiar == 'md' ? 'gap-3 px-8 py-[34px]' : '' }}
						{{ onDark
							? 'border border-white/24 bg-white/11 backdrop-blur-[18px] backdrop-saturate-[1.3] transition hover:border-white/45 hover:bg-white/17 '
								~ (maly ? 'shadow-[inset_0_1px_0_rgb(255_255_255/0.2)]' : 'shadow-[inset_0_1px_0_rgb(255_255_255/0.22),0_24px_50px_-30px_rgb(3_8_40/0.7)] hover:-translate-y-[3px]')
							: 'border border-line bg-page shadow-soft transition hover:-translate-y-[3px] hover:shadow-mid' }}">

						{% if maly %}
							<span aria-hidden="true" class="mb-2 block h-1 w-[34px] rounded-[2px] bg-sky"></span>
						{% endif %}

						{% if item.kicker %}
							<span class="font-display text-[13px] font-semibold tracking-[0.1em] uppercase
								{{ onDark ? 'text-accent-tint-2' : 'text-accent' }}">
								{{ item.kicker }}
							</span>
						{% endif %}

						<h3 class="font-display font-semibold
							{{ maly
								? 'text-[20px] leading-[normal] tracking-[-0.02em]'
								: 'tracking-[-0.025em] max-sm:text-[26px] ' ~ (duze ? 'text-[34px] leading-[1.12]' : 'text-[26px] leading-[1.15]') }}
							{{ onDark ? 'text-white' : 'text-ink' }}">
							{{ item.title }}
						</h3>

						{% if item.text %}
							<p class="{{ maly
									? 'text-[15.5px] leading-[1.58]'
									: 'leading-[1.62] ' ~ (duze ? 'max-w-[44ch] text-[17px]' : 'text-[16px]') }}
								{{ onDark ? (maly ? 'text-white/78' : 'text-white/84') : 'text-ink-3' }}">
								{{ item.text }}
							</p>
						{% endif %}

						{% if item.link.url %}
							<a href="{{ item.link.url }}"
								target="{{ item.link.target ?: '_self' }}"
								class="mt-auto text-[16px] font-semibold
									{{ onDark ? 'text-white hover:text-accent-tint-2' : 'text-accent hover:text-accent-strong' }}">
								{{ item.link.title }}
							</a>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
