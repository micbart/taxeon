{#
	Title: Liczby
	Description: Siatka wskaźników — wartość i opis, opcjonalnie z ikoną
	Category: taxeon
	Icon: chart-bar
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set cols = {
	'2': 'grid-cols-2 max-sm:grid-cols-1',
	'3': 'grid-cols-3 max-md:grid-cols-1',
	'4': 'grid-cols-4 max-xl:grid-cols-2 max-sm:grid-cols-1'
} %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow, title: fields.title, text: fields.text, onDark: onDark
		} only %}

		<div class="reveal grid gap-10 {{ cols[fields.columns ?: '4'] }}">
			{% for item in fields.items %}
				<div>
					{% if item.icon %}
						<span class="mb-4 grid size-12 place-items-center rounded-[13px] [&_svg]:size-6
							{{ onDark ? 'bg-white/10 text-deep-tint-3' : 'bg-accent-soft text-accent' }}">
							{{ item.icon|svg }}
						</span>
					{% endif %}

					<div class="font-display text-[clamp(34px,4vw,48px)] leading-none font-bold tracking-[-0.02em]
						{{ onDark ? 'text-white' : 'text-ink' }}">{{ item.value }}</div>

					<div class="mt-2.5 text-body {{ onDark ? 'text-white/70' : 'text-ink-3' }}">{{ item.label }}</div>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
