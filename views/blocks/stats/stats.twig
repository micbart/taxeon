{#
	Title: Liczby
	Description: Karty z dużą liczbą, tytułem i opisem
	Category: taxeon
	Icon: chart-bar
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

<section class="{{ section.shell(fields) }}">
	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text
		} only %}

		<div class="mt-8 grid grid-cols-2 gap-6 max-xl:grid-cols-1">
			{% for item in fields.items %}
				<div class="flex flex-col gap-3.5 rounded-panel px-[38px] py-10 max-sm:px-6
					{{ item.dark ? 'bg-deep-2 text-white' : 'border border-line bg-page' }}">
					<span class="font-display text-[52px] leading-none font-bold tracking-[-0.04em]
						{{ item.dark ? 'text-sky-2' : 'text-accent' }}">
						{{ item.value }}
					</span>

					<h3 class="font-display text-[28px] font-semibold tracking-[-0.025em]
						{{ item.dark ? 'text-white' : 'text-ink' }}">
						{{ item.title }}
					</h3>

					{% if item.text %}
						<p class="text-[17px] leading-[1.62] {{ item.dark ? 'text-white/78' : 'text-ink-3' }}">
							{{ item.text }}
						</p>
					{% endif %}
				</div>
			{% endfor %}
		</div>
	</div>
</section>
