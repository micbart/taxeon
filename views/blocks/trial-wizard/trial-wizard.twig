{#
	Title: Kreator pobrania
	Description: Trzy kroki — NIP z rejestru, dane kontaktowe, pobranie — z kolumną zaufania
	Category: raks
	Icon: download
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsMultiple: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

{% set showRail = fields.show_rail and (fields.title.text or fields.stats|length or fields.points|length) %}
{% set railRight = fields.rail_position == 'right' %}
{% set uid = 'wiz-' ~ block_index('trial-wizard') %}

{% set steps = [
	fields.step1_label ?: __('Twoja firma', 'raks'),
	fields.step2_label ?: __('Dane kontaktowe', 'raks'),
	fields.step3_label ?: __('Pobranie', 'raks')
] %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		<div class="grid items-start gap-11 max-lg:grid-cols-1 max-lg:gap-[30px]
			{{ showRail ? (railRight ? 'grid-cols-[1.08fr_0.92fr]' : 'grid-cols-[0.92fr_1.08fr]') : 'mx-auto max-w-[760px] grid-cols-1' }}">

			{% if showRail %}
				<aside class="reveal sticky top-[100px] max-lg:static
					{{ railRight ? 'order-2 max-lg:order-2' : 'max-lg:order-2' }}">

					{% include 'components/eyebrow.twig' with { title: fields.eyebrow, class: 'mb-3.5' } only %}

					{% include 'components/title-with-select-tag.twig' with {
						title: fields.title,
						defaultTag: 'h2',
						titleClass: 'font-display text-[clamp(26px,3vw,34px)] leading-[1.08] font-semibold
							tracking-[-0.02em] text-balance text-ink'
					} only %}

					{% include 'components/title-with-select-tag.twig' with {
						title: fields.text,
						defaultTag: 'p',
						titleClass: 'mt-3.5 max-w-[44ch] text-[16.5px] leading-relaxed text-ink-2'
					} only %}

					{% if fields.stats|length %}
						<div class="mt-[30px] grid grid-cols-2 gap-3.5 max-sm:grid-cols-1">
							{% for stat in fields.stats %}
								<div class="rounded-card border border-line bg-white px-5 py-[18px] shadow-soft">
									{% if stat.icon %}
										<span class="mb-3 grid size-[34px] place-items-center rounded-[9px]
											bg-accent-soft text-accent [&_svg]:size-[18px]">
											{{ stat.icon|svg }}
										</span>
									{% endif %}

									<div class="font-display text-[27px] leading-none font-bold tracking-[-0.02em] text-ink">
										{{ stat.value }}{% if stat.unit %} <b class="font-bold text-accent">{{ stat.unit }}</b>{% endif %}
									</div>

									<div class="mt-[7px] text-[13px] leading-tight font-semibold text-ink-2">{{ stat.label }}</div>
								</div>
							{% endfor %}
						</div>
					{% endif %}

					{% if fields.points|length %}
						<ul class="mt-[26px] grid gap-3">
							{% for point in fields.points %}
								<li class="flex items-start gap-3 text-[15px] font-medium text-ink
									[&_svg]:mt-0.5 [&_svg]:size-5 [&_svg]:flex-none [&_svg]:text-accent">
									{{ 'check-circle'|svg }}
									{{ point.text }}
								</li>
							{% endfor %}
						</ul>
					{% endif %}

					{% if fields.alt_title or fields.alt_link.url %}
						<div class="mt-[26px] flex items-center gap-[15px] rounded-card border border-line
							bg-white px-[22px] py-5">
							{% if fields.alt_icon %}
								<span class="grid size-11 flex-none place-items-center rounded-xl bg-accent-soft
									text-accent [&_svg]:size-[21px]">
									{{ fields.alt_icon|svg }}
								</span>
							{% endif %}

							<div>
								{% if fields.alt_title %}
									<b class="block font-display text-base font-semibold text-ink">{{ fields.alt_title }}</b>
								{% endif %}

								{% if fields.alt_text %}
									<p class="mt-[3px] mb-2 text-[13.5px] leading-snug text-ink-3">{{ fields.alt_text }}</p>
								{% endif %}

								{% if fields.alt_link.url %}
									<a href="{{ fields.alt_link.url }}"
										target="{{ fields.alt_link.target ?: '_self' }}"
										class="group/link inline-flex items-center gap-2 text-[14.5px] font-bold text-accent
											[&_svg]:size-[17px] [&_svg]:transition-transform group-hover/link:[&_svg]:translate-x-1">
										{{ fields.alt_link.title }}
										{{ 'arrow-right'|svg }}
									</a>
								{% endif %}
							</div>
						</div>
					{% endif %}

					{% if fields.secure_text %}
						<div class="mt-5 flex items-center gap-[9px] text-[13px] font-semibold text-ink-3
							[&_svg]:size-4 [&_svg]:text-[#1e8449]">
							{{ (fields.secure_icon ?: 'shield-check')|svg }}
							{{ fields.secure_text }}
						</div>
					{% endif %}
				</aside>
			{% endif %}

			<div data-wizard="{{ fields.form_name ?: 'demo' }}"
				class="@container reveal overflow-hidden rounded-panel border border-line bg-white shadow-mid
					{{ showRail and railRight ? 'order-1' : '' }} max-lg:order-1">

				<div class="flex items-center border-b border-line bg-[linear-gradient(180deg,var(--color-soft),#fff)]
					px-[34px] py-[26px] max-sm:px-5">
					{% for label in steps %}
						{% if not loop.first %}
							<span data-wizard-line="{{ loop.index0 }}"
								class="relative mx-3.5 h-0.5 flex-1 overflow-hidden rounded-sm bg-line
									after:absolute after:inset-y-0 after:left-0 after:w-0 after:bg-accent
									after:transition-[width] after:duration-300 after:content-['']
									data-[done=true]:after:w-full"></span>
						{% endif %}

						<span data-wizard-step="{{ loop.index }}" data-state="{{ loop.first ? 'active' : 'todo' }}"
							class="group/step flex items-center gap-[11px]">
							<span class="grid size-[38px] place-items-center rounded-full border-2 border-line bg-white
								font-display text-[15px] font-bold text-ink-3 transition
								group-data-[state=active]/step:border-accent group-data-[state=active]/step:bg-accent
								group-data-[state=active]/step:text-white
								group-data-[state=active]/step:shadow-[0_0_0_4px_color-mix(in_srgb,var(--color-accent)_15%,transparent)]
								group-data-[state=done]/step:border-accent group-data-[state=done]/step:bg-accent-soft
								group-data-[state=done]/step:text-accent">
								{{ loop.index }}
							</span>

							<span class="text-[13.5px] font-bold whitespace-nowrap text-ink-3 transition
								group-data-[state=active]/step:text-ink
								group-data-[state=done]/step:text-ink-2
								@max-[540px]:hidden">
								{{ label }}
							</span>
						</span>
					{% endfor %}
				</div>

				<form data-wizard-form novalidate class="px-9 pt-[34px] pb-9 max-sm:px-5 max-sm:py-6">
					{% include 'blocks/trial-wizard/step-company.twig' with { fields: fields, uid: uid } only %}
					{% include 'blocks/trial-wizard/step-contact.twig' with { fields: fields, uid: uid } only %}
					{% include 'blocks/trial-wizard/step-done.twig' with { fields: fields } only %}
				</form>

				{% if fields.foot|length %}
					<div data-wizard-foot
						class="flex flex-wrap items-center justify-center gap-x-7 gap-y-2.5 border-t border-line
							bg-soft px-9 py-[18px] text-[13px] font-semibold text-ink-3
							[&_svg]:size-4 [&_svg]:text-ink-3 max-sm:px-5">
						{% for item in fields.foot %}
							<span class="inline-flex items-center gap-2">
								{% if item.icon %}{{ item.icon|svg }}{% endif %}
								{{ item.text }}
							</span>
						{% endfor %}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</section>
