<div data-wizard-panel="3" hidden class="text-center">
	<span class="mx-auto mb-[22px] grid size-[76px] place-items-center rounded-full border-2
		border-[#1e8449]/35 bg-[#f3faf6] text-[#1e8449] [&_svg]:size-[38px]">
		{{ 'check'|svg }}
	</span>

	{% include 'components/title-with-select-tag.twig' with {
		title: fields.step3_title,
		defaultTag: 'h3',
		titleClass: 'font-display text-[clamp(24px,3vw,30px)] leading-[1.15] font-semibold
			tracking-[-0.02em] text-balance text-ink'
	} only %}

	{% if fields.step3_text %}
		<p data-wizard-done-text data-template="{{ fields.step3_text }}"
			class="mx-auto mt-3 max-w-[42ch] text-base leading-snug text-ink-2 [&_b]:text-ink">
			{{ fields.step3_text }}
		</p>
	{% endif %}

	{% if fields.downloads|length %}
		<div class="mt-[30px] flex flex-col items-center gap-3">
			{% for download in fields.downloads %}
				{% include 'components/button.twig' with { button: download.button } only %}

				{% if download.note %}
					<span class="text-[13.5px] text-ink-3 [&_a]:font-bold [&_a]:text-accent">{{ download.note }}</span>
				{% endif %}
			{% endfor %}
		</div>
	{% endif %}

	{% if fields.next_steps|length %}
		<div class="mt-[34px] grid gap-[18px] border-t border-line pt-[30px] text-left">
			{% if fields.next_steps_title %}
				<h4 class="font-sans text-[13px] font-bold tracking-[0.06em] text-ink-3 uppercase">
					{{ fields.next_steps_title }}
				</h4>
			{% endif %}

			{% for step in fields.next_steps %}
				<div class="flex items-start gap-[15px]">
					<span class="grid size-9 flex-none place-items-center rounded-[10px] bg-accent-soft
						font-display text-[15px] font-bold text-accent">
						{{ loop.index }}
					</span>

					<div>
						<b class="block font-display text-base font-semibold text-ink">{{ step.title }}</b>
						<p class="mt-[3px] text-sm leading-normal text-ink-2">{{ step.text }}</p>
					</div>
				</div>
			{% endfor %}
		</div>
	{% endif %}
</div>
