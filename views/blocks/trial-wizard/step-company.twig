<div data-wizard-panel="1">
	{% if fields.step1_kicker %}
		<span class="text-[13px] font-bold tracking-[0.06em] text-accent uppercase">{{ fields.step1_kicker }}</span>
	{% endif %}

	{% include 'components/title-with-select-tag.twig' with {
		title: fields.step1_title,
		defaultTag: 'h3',
		titleClass: 'mt-2 font-display text-[clamp(22px,2.6vw,27px)] leading-[1.15] font-semibold
			tracking-[-0.02em] text-ink'
	} only %}

	{% if fields.step1_text %}
		<p class="mt-2.5 max-w-[48ch] text-[15.5px] leading-snug text-ink-2">{{ fields.step1_text }}</p>
	{% endif %}

	<div class="mt-[26px] flex items-end gap-3 max-sm:flex-col max-sm:items-stretch">
		<div class="flex-1">
			{% include 'components/form-field.twig' with {
				name: 'nip',
				label: fields.step1_nip_label ?: __('Numer NIP', 'raks'),
				idPrefix: uid,
				inputmode: 'numeric',
				placeholder: __('np. 525 000 12 34', 'raks')
			} only %}
		</div>

		<button type="button" data-wizard-check
			class="inline-flex h-[49px] flex-none items-center justify-center gap-2 rounded-btn border-[1.5px]
				border-line bg-white px-6 font-sans font-bold text-ink transition
				hover:border-accent hover:text-accent disabled:pointer-events-none disabled:opacity-60
				[&_svg]:size-[18px]">
			{{ 'search'|svg }}
			{{ fields.step1_check_label ?: __('Sprawdź', 'raks') }}
		</button>
	</div>

	{% if fields.step1_hint %}
		<p class="mt-3.5 flex items-start gap-[9px] text-[13.5px] leading-normal text-ink-3
			[&_svg]:mt-0.5 [&_svg]:size-4 [&_svg]:flex-none [&_svg]:text-accent">
			{{ 'info'|svg }}
			{{ fields.step1_hint }}
		</p>
	{% endif %}

	<div data-wizard-result hidden
		class="mt-[22px] rounded-card border border-[#1e8449]/30 bg-[#f3faf6] px-6 py-[22px]">

		<div data-wizard-result-head
			class="flex items-center gap-2.5 text-[13px] font-bold tracking-[0.02em] text-[#1e8449]
				[&_svg]:size-[18px]">
			{{ 'badge-check'|svg }}
			<span data-wizard-result-label>{{ __('Dane pobrane z rejestru VAT', 'raks') }}</span>
		</div>

		<div data-wizard-result-name class="mt-3 font-display text-xl font-semibold text-ink empty:hidden"></div>

		<div class="mt-2 grid gap-[5px] text-sm text-ink-2 [&_svg]:size-[15px] [&_svg]:flex-none [&_svg]:text-ink-3">
			<span data-wizard-result-address class="flex items-center gap-2 empty:hidden"></span>
			<span data-wizard-result-status class="flex items-center gap-2 empty:hidden"></span>
		</div>

		<div class="mt-4">
			{% include 'components/form-field.twig' with {
				name: 'company',
				label: fields.step1_company_label ?: __('Nazwa firmy (możesz poprawić)', 'raks'),
				idPrefix: uid,
				required: true
			} only %}
		</div>
	</div>

	<div class="mt-[30px] flex justify-end">
		<button type="button" data-wizard-next="2"
			class="inline-flex items-center gap-2 rounded-btn bg-cta px-8 py-[15px] font-sans text-base
				font-bold text-white shadow-cta transition
				hover:-translate-y-0.5 hover:bg-cta-strong
				[&_svg]:size-[18px] [&_svg]:transition-transform hover:[&_svg]:translate-x-1">
			{{ fields.step1_next_label ?: __('Dalej', 'raks') }}
			{{ 'arrow-right'|svg }}
		</button>
	</div>
</div>
