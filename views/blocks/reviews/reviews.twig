{#
	Title: Opinie
	Description: Karty opinii z Google z odnośnikiem do wizytówki
	Category: taxeon
	Icon: star-filled
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set zGoogle = (fields.source ?: 'google') == 'google' %}
{% set profil = zGoogle ? googleReviews(fields.google_items ?: [], fields.limit ?: 8) : null %}
{% set opinie = zGoogle ? profil.items : fields.items %}
{% set wizytowka = fields.link.url ?: (profil.mapsUrl ?? '') %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %} class="{{ section.shell(fields) }}">
	<div class="{{ section.container(fields) }}">
		<div class="flex flex-wrap items-end justify-between gap-8">
			{% include 'components/section-head.twig' with {
			size: fields.head_size,
			background: fields.background,
			headWidth: fields.head_width,
			titleWidth: fields.title_width,
			textWidth: fields.text_width,
			textGap: fields.text_gap,
				eyebrow: fields.eyebrow,
				title: fields.title,
				text: {
					text: fields.text.text
						|replace({ '{ocena}': profil.rating|number_format(1, ',') })
						|replace({ '{liczba}': profil.total }),
					tag: fields.text.tag
				}
			} only %}

			{% if wizytowka %}
				<a href="{{ wizytowka }}" target="_blank" rel="noopener"
					class="inline-flex items-center gap-2.5 rounded-pill border border-[#c6d4ea] bg-page
						px-[22px] py-[13px] text-[15px] font-semibold whitespace-nowrap text-accent
						transition hover:border-accent hover:bg-soft">
					{{ fields.link.title }} →
				</a>
			{% endif %}
		</div>

		{% if opinie|length %}
			<div class="mt-11 grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5">
				{% for item in opinie %}
					<a href="{{ item.authorUrl ?: wizytowka ?: '#' }}" target="_blank" rel="noopener"
						class="flex min-h-[210px] flex-col gap-3.5 rounded-card border border-line bg-page p-[26px]
							text-ink transition hover:border-accent hover:shadow-[0_18px_40px_-26px_rgb(11_99_246/0.4)]">
						<div class="flex gap-1 text-[15px] tracking-[0.1em] text-accent">
							{% for gwiazdka in 1..5 %}{{ gwiazdka <= (item.rating ?: 5) ? '★' : '☆' }}{% endfor %}
						</div>

						<p class="line-clamp-[9] flex-1 text-[15px] leading-[1.6] text-ink-2">{{ item.text }}</p>

						<div class="flex items-center gap-2.5">
							{% if item.photo %}
								<img src="{{ item.photo }}" alt="" loading="lazy" width="34" height="34"
									referrerpolicy="no-referrer"
									class="size-[34px] flex-none rounded-full object-cover">
							{% else %}
								<span aria-hidden="true"
									class="grid size-[34px] flex-none place-items-center rounded-full
										bg-accent-soft font-display text-[14px] font-semibold text-accent">
									{{ item.author|slice(0, 1)|upper }}
								</span>
							{% endif %}
							<span class="flex flex-col">
								<span class="text-[14px] font-semibold">{{ item.author }}</span>
								<span class="text-[13px] text-ink-3">{{ item.when }}</span>
							</span>
						</div>
					</a>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
