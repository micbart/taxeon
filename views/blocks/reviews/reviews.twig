{#
	Title: Opinie
	Description: Karty opinii z Google z odnośnikiem do wizytówki
	Category: taxeon
	Icon: star-filled
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set zrodlo = fields.source ?: 'google' %}
{% set zGoogle = zrodlo != 'manual' %}
{% set profil = zGoogle ? googleReviews(fields.google_items ?: [], fields.limit ?: 8) : null %}
{% set opinie = (zGoogle ? profil.items : [])|merge(zrodlo != 'google' ? fields.items ?: [] : []) %}
{% set wizytowka = fields.link.url ?: (profil.mapsUrl ?? '') %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %} class="relative overflow-hidden {{ section.shell(fields) }}">
	{% include 'components/section-decor.twig' with { background: fields.background } only %}
	<div class="relative {{ section.container(fields) }}">
		<div class="flex flex-wrap items-end justify-between gap-8">
			{% include 'components/section-head.twig' with {
			size: fields.head_size,
			background: fields.background,
			headWidth: fields.head_width,
			titleWidth: fields.title_width,
			textWidth: fields.text_width,
			textGap: fields.text_gap,
				eyebrow: fields.eyebrow,
				title: fields.title,
				text: {
					text: fields.text.text
						|replace({ '{ocena}': profil.rating|number_format(1, ',') })
						|replace({ '{liczba}': profil.total }),
					tag: fields.text.tag
				}
			} only %}

			{% if wizytowka %}
				<a href="{{ wizytowka }}" target="_blank" rel="noopener"
					class="inline-flex items-center gap-2.5 rounded-pill border border-[#ded7c8] bg-page
						px-[22px] py-[13px] text-[15px] font-semibold whitespace-nowrap text-navy
						transition hover:border-navy hover:bg-cream">
					{{ fields.link.title }} →
				</a>
			{% endif %}
		</div>

		{% if opinie|length %}
			{% if opinie|length > 4 %}
				<div class="reveal mt-11" data-reviews>
					<div data-reviews-track
						role="group"
						tabindex="0"
						aria-label="{{ __('Opinie klientów — przewijana lista', 'taxeon') }}"
						class="flex snap-x snap-mandatory gap-5 overflow-x-auto overscroll-x-contain pb-1
							max-md:-mr-8 max-md:pr-8 max-sm:-mr-5 max-sm:pr-5 max-sm:gap-4
							[scrollbar-width:none] motion-safe:scroll-smooth [&::-webkit-scrollbar]:hidden">
						{% for item in opinie %}
							{% include 'components/review-card.twig' with {
								item: item,
								wizytowka: wizytowka,
								klasy: 'shrink-0 snap-start basis-[calc((100%-60px)/4)]
									max-lg:basis-[calc((100%-40px)/3)] max-md:basis-[calc((100%-20px)/2)]
									max-sm:basis-[86%]'
							} only %}
						{% endfor %}
					</div>

					<div class="mt-6 flex justify-end gap-2.5" data-reviews-nav>
						<button type="button" data-reviews-prev
							aria-label="{{ __('Poprzednie opinie', 'taxeon') }}"
							class="grid size-11 cursor-pointer place-items-center rounded-pill border border-[#ded7c8]
								bg-page text-navy transition hover:border-navy hover:bg-cream
								disabled:cursor-default disabled:opacity-40 disabled:hover:border-[#ded7c8]
								disabled:hover:bg-page [&_svg]:size-5">
							{{ 'arrow-left'|svg }}
						</button>

						<button type="button" data-reviews-next
							aria-label="{{ __('Następne opinie', 'taxeon') }}"
							class="grid size-11 cursor-pointer place-items-center rounded-pill border border-[#ded7c8]
								bg-page text-navy transition hover:border-navy hover:bg-cream
								disabled:cursor-default disabled:opacity-40 disabled:hover:border-[#ded7c8]
								disabled:hover:bg-page [&_svg]:size-5">
							{{ 'arrow-right'|svg }}
						</button>
					</div>
				</div>
			{% else %}
				<div class="mt-11 grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-5">
					{% for item in opinie %}
						{% include 'components/review-card.twig' with { item: item, wizytowka: wizytowka, klasy: '' } only %}
					{% endfor %}
				</div>
			{% endif %}
		{% endif %}
	</div>
</section>
