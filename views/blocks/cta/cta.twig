{#
	Title: Pas CTA
	Description: Wyśrodkowany pas z tytułem i przyciskami
	Category: taxeon
	Icon: megaphone
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %} class="relative overflow-hidden {{ section.shell(fields) }}">
	{% if onDark %}
		<div aria-hidden="true"
			class="absolute inset-0 bg-[radial-gradient(70%_90%_at_50%_110%,rgb(23_63_95/0.55),transparent_65%)]"></div>
	{% else %}
		{% include 'components/section-decor.twig' with { background: fields.background } only %}
	{% endif %}

	<div class="reveal relative mx-auto w-full max-w-page">
		<div class="mx-auto max-w-[900px] text-center">
		{% if fields.title.text %}
			<{{ fields.title.tag ?: 'h2' }} class="font-display leading-[1.04]
				{{ { 'lg': 'text-[clamp(34px,4.2vw,62px)]', 'sm': 'text-[clamp(32px,4vw,56px)]', 'xs': 'text-[clamp(32px,4vw,54px)]' }[fields.title_size] ?: 'text-[clamp(34px,4.2vw,58px)]' }}
				font-bold tracking-[-0.035em] {{ onDark ? 'text-white' : 'text-ink' }}">
				{{ fields.title.text|nl2br }}
			</{{ fields.title.tag ?: 'h2' }}>
		{% endif %}

		{% if fields.text %}
			<p class="mt-5 text-[19px] {{ onDark ? 'text-white/76' : 'text-ink-3' }}">{{ fields.text }}</p>
		{% endif %}

		{% if fields.button_primary.url or fields.button_secondary.url %}
			<div class="mt-9 flex flex-wrap justify-center gap-3.5">
				{% if fields.button_primary.url %}
					<a href="{{ fields.button_primary.url }}"
						{{ linkAttrs(fields.button_primary.url, fields.button_primary.target)|raw }}
						class="rounded-pill px-8 py-[17px] text-[16px] font-semibold transition
							{{ onDark ? 'bg-white text-ink hover:bg-sand' : 'bg-navy text-white hover:bg-navy-deep' }}">
						{{ fields.button_primary.title }}
					</a>
				{% endif %}

				{% if fields.button_secondary.url %}
					<a href="{{ fields.button_secondary.url }}"
						{{ linkAttrs(fields.button_secondary.url, fields.button_secondary.target)|raw }}
						class="rounded-pill border px-8 py-[17px] text-[16px] font-semibold transition
							{{ onDark ? 'border-white/32 text-white hover:bg-white hover:text-ink' : 'border-line text-ink hover:bg-cream' }}">
						{{ fields.button_secondary.title }}
					</a>
				{% endif %}
			</div>
			{% endif %}
		</div>
	</div>
</section>
