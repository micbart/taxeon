{#
	Title: Pas CTA
	Description: Wezwanie do działania — wariant jasny lub ciemny na całą szerokość
	Category: taxeon
	Icon: megaphone
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% set isDark = fields.variant == 'dark' %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="relative overflow-hidden py-section max-sm:py-16
		{{ isDark ? 'bg-[image:var(--gradient-hero)] text-white' : 'border-y border-line-2 bg-soft' }} {{ classes }}">

	<div class="relative z-[1] mx-auto w-full max-w-[760px] px-gutter text-center max-sm:px-5">
		{% if isDark %}
			<div class="mb-7 flex justify-center">
				{% include 'components/logo.twig' with { white: true, width: 190, height: 38, class: 'h-[38px] opacity-95' } %}
			</div>
		{% elseif fields.icon %}
			<span class="mx-auto mb-[22px] grid size-14 place-items-center rounded-[15px] bg-accent
				text-accent-ink [&_svg]:size-7">
				{{ fields.icon|svg }}
			</span>
		{% endif %}

		{% include 'components/title-with-select-tag.twig' with {
			title: fields.title,
			defaultTag: 'h2',
			titleClass: 'font-display text-[clamp(30px,4vw,48px)] leading-[1.08] font-semibold tracking-[-0.02em]
				text-balance ' ~ (isDark ? 'text-white' : 'text-ink')
		} only %}

		{% include 'components/title-with-select-tag.twig' with {
			title: fields.text,
			defaultTag: 'p',
			titleClass: 'mx-auto mt-4 max-w-[580px] text-lg leading-relaxed ' ~ (isDark ? 'text-white/70' : 'text-ink-2')
		} only %}

		<div class="mt-8 flex flex-wrap justify-center gap-3.5 max-sm:[&_a]:w-full">
			{% include 'components/button.twig' with {
				button: fields.button_primary,
				variant: isDark ? 'on-navy' : null
			} only %}

			{% include 'components/button.twig' with {
				button: fields.button_secondary,
				variant: isDark ? 'ghost-navy' : null
			} only %}
		</div>
	</div>
</section>
