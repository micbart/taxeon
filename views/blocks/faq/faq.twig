{#
	Title: FAQ
	Description: Pytania i odpowiedzi z opisem po lewej
	Category: taxeon
	Icon: editor-help
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}
{% import 'components/section.twig' as section %}

<section class="{{ section.shell(fields) }}">
	<div class="{{ section.container(fields) }}">
		<div class="grid grid-cols-[minmax(260px,0.7fr)_minmax(420px,1.3fr)] items-start gap-16
			max-xl:grid-cols-1 max-xl:gap-10">
			<div>
				{% include 'components/section-head.twig' with {
					eyebrow: fields.eyebrow,
					title: fields.title,
					text: fields.text,
					link: fields.link
				} only %}
			</div>

			<div class="flex flex-col gap-3">
				{% for item in fields.items %}
					<details class="group overflow-hidden rounded-sm border border-line bg-page"
						{% if loop.first and fields.open_first %}open{% endif %}>
						<summary class="flex cursor-pointer list-none items-center gap-[18px] px-6 py-5
							font-display text-[18px] font-medium tracking-[-0.015em] text-ink
							transition hover:bg-soft [&::-webkit-details-marker]:hidden">
							<span class="flex-1">{{ item.question }}</span>

							<span class="grid size-7 flex-none place-items-center rounded-full bg-[#eef3fb]
								text-[17px] text-accent">
								<span class="group-open:hidden">+</span>
								<span class="hidden group-open:block">−</span>
							</span>
						</summary>

						<div class="px-6 pb-5 text-[15px] leading-[1.65] text-ink-3
							[&_a]:font-semibold [&_a]:text-accent">
							{{ item.answer }}
						</div>
					</details>
				{% endfor %}
			</div>
		</div>
	</div>
</section>
