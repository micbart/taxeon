{#
	Title: Pytania i odpowiedzi
	Description: Rozwijana lista pytań na znacznikach <details>
	Category: taxeon
	Icon: editor-help
	HideFieldsInSidebar: true
	ExpandedEditorButtons: true
	ExpandedEditorButtonText: Edytuj zawartość
	SupportsAlign: false
	SupportsAnchor: true
#}

{% import 'components/section.twig' as section %}

{% set onDark = section.isDark(fields) %}
{% set isCenter = fields.align == 'center' %}
{% set groupName = fields.single ? 'faq-' ~ block_index('faq') : '' %}

<section {% if block.anchor %}id="{{ block.anchor }}"{% endif %}
	class="{{ section.shell(fields, classes) }}">

	<div class="{{ section.container(fields) }}">
		{% include 'components/section-head.twig' with {
			eyebrow: fields.eyebrow,
			title: fields.title,
			text: fields.text,
			center: isCenter,
			onDark: onDark
		} only %}

		<div class="grid gap-3.5 {{ fields.columns == '2'
			? 'grid-cols-2 items-start max-lg:grid-cols-1'
			: 'mx-auto max-w-[860px]' }}">

			{% for item in fields.items %}
				<details {% if groupName %}name="{{ groupName }}"{% endif %}
					class="group rounded-card border px-[26px] transition
						{{ onDark
							? 'border-white/15 bg-white/[0.06] open:border-white/35'
							: 'border-line bg-white open:border-accent/35 open:shadow-soft' }}">

					<summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-[22px]
						font-display text-[18.5px] font-semibold [&::-webkit-details-marker]:hidden
						{{ onDark ? 'text-white' : 'text-ink' }}">
						{{ item.question }}

						<span class="grid size-[30px] flex-none place-items-center rounded-[9px] transition-transform
							duration-200 group-open:rotate-45 [&_svg]:size-[18px]
							{{ onDark ? 'bg-white/15 text-white' : 'bg-accent-soft text-accent' }}">
							{{ (fields.icon ?: 'plus')|svg }}
						</span>
					</summary>

					<p class="-mt-1 pr-[50px] pb-6 text-[15.5px] leading-relaxed whitespace-pre-line max-sm:pr-0
						{{ onDark ? 'text-white/80' : 'text-ink-2' }}">
						{{ item.answer }}
					</p>
				</details>
			{% endfor %}
		</div>
	</div>
</section>
