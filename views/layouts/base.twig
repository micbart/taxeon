<!doctype html>
<html {{ function('get_language_attributes', 'html') }} class="scroll-smooth scroll-pt-[100px]">
	<head>
		<meta charset="{{ site.charset }}">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="theme-color" content="#030b1c">

		{% if not viteIsDev %}
			<link rel="preload" href="{{ site.theme.uri }}/dist/fonts/ibm-plex-sans-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous">
			<link rel="preload" href="{{ site.theme.uri }}/dist/fonts/poppins-600-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous">
		{% endif %}

		{% if themeOptions.scripts_head %}
			{{ themeOptions.scripts_head }}
		{% endif %}

		{{ fn('wp_head') }}
	</head>

	<body class="{{ body_class }} relative overflow-x-hidden bg-page font-sans text-[16px] leading-normal text-ink antialiased selection:bg-accent selection:text-accent-ink">
		{% if themeOptions.scripts_body %}
			{{ themeOptions.scripts_body }}
		{% endif %}

		<a class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:left-0 focus:z-[99999] focus:bg-page focus:px-8 focus:py-4 focus:text-ink"
			href="#content">
			{{ __('Przejdź do treści', 'taxeon') }}
		</a>

		{% include 'components/header.twig' %}

		<main id="content">
			{% block main %}
				<div class="py-section max-sm:py-16">
					<div class="mx-auto w-full max-w-page px-gutter max-sm:px-5">
						{% block content %}
							<div class="prose mx-auto max-w-[760px]">{{ post.content }}</div>
						{% endblock %}
					</div>
				</div>
			{% endblock %}
		</main>

		{% include 'components/footer.twig' %}


		{{ fn('wp_footer') }}
	</body>
</html>
