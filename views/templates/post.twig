{% extends "layouts/base.twig" %}

{% set kategoria = post.terms({ taxonomy: 'category' })|first %}
{% set autor = post.author %}

{% block main %}
	<section class="relative overflow-hidden bg-ink text-white">
		{% include 'components/hero-art-dark.twig' only %}

		<div class="relative mx-auto w-full max-w-[1160px] px-gutter pt-[156px] pb-[72px]
			max-md:pt-[128px] max-sm:px-5">

			<div class="flex items-center gap-2.5 text-[14px] text-white/60">
				<a href="{{ fn('get_permalink', fn('get_option', 'page_for_posts')) }}"
					class="text-white/60 transition hover:text-white">{{ __('Baza wiedzy', 'taxeon') }}</a>
				<span>/</span>
				{% if kategoria %}<span class="text-gold-light">{{ kategoria.name }}</span>{% endif %}
			</div>

			<h1 class="mt-5 font-display text-[clamp(34px,4vw,56px)] leading-[1.06] font-bold
				tracking-[-0.035em] text-balance">
				{{ post.title }}
			</h1>

			{% set zajawka = post.excerpt({ words: 34, force: true, read_more: '' })|striptags|trim %}

			{% if zajawka %}
				<p class="mt-[22px] max-w-[58ch] text-[19px] leading-[1.6] text-white/78">{{ zajawka }}</p>
			{% endif %}

			<div class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5 text-[14.5px] text-white/60">
				{% if autor %}
					<span>{{ autor.name }}{% if themeOptions.author_role %} · {{ themeOptions.author_role }}{% endif %}</span>
				{% endif %}

				<time datetime="{{ post.date('Y-m-d') }}">{{ post.date('j F Y') }}</time>
				<span>{{ post.content|readTime }} {{ __('min czytania', 'taxeon') }}</span>
			</div>
		</div>
	</section>

	<section class="relative overflow-clip bg-[image:var(--gradient-light)] px-gutter pt-[72px] pb-24
		max-sm:px-5 max-sm:pb-16">
		<div aria-hidden="true"
			class="absolute inset-0 bg-[radial-gradient(75%_55%_at_85%_100%,rgb(31_85_128/0.12),transparent_70%),radial-gradient(60%_50%_at_0%_15%,rgb(227_178_60/0.08),transparent_72%)]"></div>

		<div class="relative mx-auto grid w-full max-w-[1160px] grid-cols-[minmax(0,1fr)_280px]
			items-start gap-14 max-xl:grid-cols-1">

			<article class="rounded-panel border border-line bg-page px-[60px] py-14
				shadow-[0_40px_90px_-70px_rgb(14_31_44/0.7)] max-sm:px-7 max-sm:py-9">
				<div class="prose">{{ postContent }}</div>

				{% if autor %}
					<div class="mt-11 flex flex-wrap items-center gap-[18px] border-t border-line pt-7">
						<span aria-hidden="true"
							class="grid size-[52px] flex-none place-items-center rounded-full bg-line-2
								font-display text-[18px] font-semibold text-navy">
							{{ autor.name|slice(0, 1) }}
						</span>

						<span class="flex flex-col gap-[3px]">
							<span class="font-display text-[17px] font-semibold text-ink">{{ autor.name }}</span>

							{% if autor.description %}
								<span class="text-[15px] text-ink-3">{{ autor.description }}</span>
							{% endif %}
						</span>
					</div>
				{% endif %}
			</article>

			<aside class="sticky top-[120px] flex flex-col gap-5 max-xl:static">
				{% if toc|length > 1 %}
					<div class="rounded-card border border-line bg-page px-6 py-[26px]">
						<span class="font-mono text-[12px] tracking-[0.08em] text-navy uppercase">
							{{ __('W tym artykule', 'taxeon') }}
						</span>

						<div class="mt-4 flex flex-col gap-[11px]">
							{% for pozycja in toc %}
								<a href="#{{ pozycja.id }}"
									class="text-[15.5px] leading-[1.5] text-ink-2 transition hover:text-navy">
									{{ pozycja.title }}
								</a>
							{% endfor %}
						</div>
					</div>
				{% endif %}

				{% if themeOptions.article_cta_title %}
					<div class="flex flex-col gap-3 rounded-card bg-[image:var(--gradient-tile)]
						px-6 py-7 text-white">
						<span class="font-display text-[20px] leading-[1.25] font-semibold tracking-[-0.02em]">
							{{ themeOptions.article_cta_title }}
						</span>

						{% if themeOptions.article_cta_text %}
							<span class="text-[15px] leading-[1.6] text-white/80">{{ themeOptions.article_cta_text }}</span>
						{% endif %}

						{% if themeOptions.article_cta_link.url %}
							<a href="{{ themeOptions.article_cta_link.url }}"
								{{ linkAttrs(themeOptions.article_cta_link.url, themeOptions.article_cta_link.target)|raw }}
								class="mt-1.5 rounded-pill bg-white px-5 py-[13px] text-center text-[15px]
									font-semibold text-ink transition hover:bg-sand">
								{{ themeOptions.article_cta_link.title }}
							</a>
						{% endif %}
					</div>
				{% endif %}
			</aside>
		</div>
	</section>

	{% if relatedPosts|length %}
		<section class="bg-cream px-gutter py-[88px] max-sm:px-5 max-sm:py-16">
			<div class="mx-auto w-full max-w-[1160px]">
				{% include 'components/eyebrow.twig' with { title: { text: __('Czytaj dalej', 'taxeon'), tag: 'span' } } only %}

				<h2 class="mt-3.5 font-display text-[clamp(28px,2.8vw,40px)] leading-[1.12] font-bold
					tracking-[-0.03em] text-ink">
					{{ __('Powiązane artykuły', 'taxeon') }}
				</h2>

				<div class="mt-9 grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line
					max-xl:grid-cols-2 max-sm:grid-cols-1">
					{% for powiazany in relatedPosts %}
						{% include 'components/post-card.twig' with { post: powiazany, compact: true } only %}
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
{% endblock %}
