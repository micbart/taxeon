{% extends "layouts/base.twig" %}

{% set solidHeader = false %}

{% block main %}
	<section data-hero-bg="net"
		class="hero-clip relative -mt-header overflow-hidden rounded-b-section bg-[image:var(--gradient-hero)]
			pt-header max-md:rounded-b-section-sm">

		<div class="relative z-[1] mx-auto w-full max-w-page px-gutter max-sm:px-5">
			<div class="pt-16 pb-21">
				{% include 'components/breadcrumbs.twig' with { breadcrumbs: breadcrumbs, light: true } only %}

				{% include 'components/animated-title.twig' with {
					text: term.name,
					class: 'mt-5 max-w-[20ch] font-display text-[clamp(33px,4.6vw,54px)] leading-[1.08]
						font-semibold tracking-[-0.02em] text-balance text-white'
				} only %}

				{% if term.description %}
					<p class="mt-[22px] max-w-[600px] text-[clamp(17px,2vw,20px)] leading-[1.6] text-white/78">
						{{ term.description }}
					</p>
				{% endif %}
			</div>
		</div>
	</section>

	<section class="py-section max-sm:py-16">
		<div class="mx-auto w-full max-w-page px-gutter max-sm:px-5">
			{% if posts|length %}
				<div class="grid gap-6 grid-cols-2 max-lg:grid-cols-1">
					{% for item in posts %}
						{% include 'components/product-card.twig' with {
							item: item,
							showPrice: true,
							showDate: true
						} only %}
					{% endfor %}
				</div>

				{% include 'components/pagination.twig' with { pagination: posts.pagination } only %}
			{% else %}
				<p class="py-10 text-center text-base text-ink-3">
					{{ __('Nie mamy teraz nic w tej kategorii.', 'raks') }}
				</p>
			{% endif %}
		</div>
	</section>
{% endblock %}
