{% extends "layouts/base.twig" %}

{% set hasHeroBlock = post.post_content starts with '<!-- wp:acf/hero ' %}
{% set solidHeader = not hasHeroBlock %}

{% block main %}
	{% if not hasHeroBlock %}
		{% include 'components/page-hero.twig' with {
			title: post.title,
			text: post.meta('subtitle')
		} only %}
	{% endif %}

	{% if post.content %}
		{% if hasHeroBlock or post.post_content starts with '<!-- wp:acf/' %}
			{{ post.content }}
		{% else %}
			<section class="relative overflow-hidden bg-[image:var(--gradient-light)] px-gutter py-section-md
				max-sm:px-5 max-sm:py-16">
				{% include 'components/section-decor.twig' with { background: 'light' } only %}

				<div class="relative mx-auto w-full max-w-[860px] rounded-panel border border-line bg-page
					px-[60px] py-14 shadow-[0_40px_90px_-70px_rgb(6_16_36/0.7)] max-sm:px-7 max-sm:py-9">
					<div class="prose">{{ post.content }}</div>
				</div>
			</section>
		{% endif %}
	{% endif %}
{% endblock %}
