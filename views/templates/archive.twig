{% extends "layouts/base.twig" %}

{% block main %}
	<section class="relative overflow-hidden bg-ink text-white">
		{% include 'components/hero-art-dark.twig' only %}

		<div class="relative mx-auto w-full max-w-page px-gutter pt-[168px] pb-[72px] max-md:pt-[132px] max-sm:px-5">
			{% if archiveBadge %}
				<div class="inline-flex items-center gap-2.5 text-[13px] tracking-[0.04em] text-white/82 uppercase">
					<span class="block size-1.5 rounded-full bg-gold-light"></span>
					{{ archiveBadge }}
				</div>
			{% endif %}

			<h1 class="mt-[22px] max-w-[18ch] font-display text-[clamp(38px,4.4vw,62px)] leading-[1.03]
				font-bold tracking-[-0.035em] text-balance">
				{{ archiveTitle }}
			</h1>

			{% if archiveDescription %}
				<div class="mt-6 max-w-[58ch] text-[18px] leading-[1.6] text-white/76 [&_p]:m-0">
					{{ archiveDescription }}
				</div>
			{% endif %}
		</div>
	</section>

	<section class="relative overflow-hidden bg-[image:var(--gradient-light)] px-gutter pt-[72px]
		pb-section-md max-sm:px-5 max-sm:pt-14 max-sm:pb-16">
		{% include 'components/section-decor.twig' with { background: 'light' } only %}

		<div class="relative mx-auto w-full max-w-page">
			{% if filterTerms|length > 1 %}
				{% set pigulka = 'rounded-pill px-[18px] py-2.5 font-display text-[15px] font-medium transition
					border border-line bg-white/70 text-ink-3 hover:border-navy hover:text-ink
					data-[active=true]:border-ink data-[active=true]:bg-ink data-[active=true]:text-white' %}

				<div data-blog-filter
					role="group"
					aria-label="{{ __('Filtruj wpisy według kategorii', 'taxeon') }}"
					class="flex flex-wrap gap-2.5">

					<a href="{{ blogUrl }}" data-category="all"
						data-active="{{ activeTerm ? 'false' : 'true' }}" class="{{ pigulka }}">
						{{ __('Wszystkie', 'taxeon') }}
					</a>

					{% for term in filterTerms %}
						<a href="{{ term.url }}"
							data-category="{{ term.slug }}"
							data-active="{{ activeTerm == term.id ? 'true' : 'false' }}"
							class="{{ pigulka }}">
							{{ term.name }}
						</a>
					{% endfor %}
				</div>
			{% endif %}

			{% if featuredPost %}
				<div data-blog-featured class="mt-[34px]">
					{% include 'components/post-featured.twig' with { post: featuredPost } only %}
				</div>
			{% endif %}

			<div data-blog-results
				data-max-pages="{{ maxPages }}"
				aria-busy="false"
				class="group/results relative min-h-[240px] data-loading:pointer-events-none">

				<div aria-hidden="true"
					class="pointer-events-none absolute inset-0 z-10 hidden group-data-loading/results:block">
					<div class="absolute top-16 left-1/2 flex -translate-x-1/2 animate-fade-up items-center gap-3 rounded-pill
						border border-line bg-white px-5 py-3 font-display text-[15px] font-semibold whitespace-nowrap text-navy shadow-card">
						<span class="size-5 animate-spin text-gold [&_svg]:size-full">{{ 'loader-circle'|svg }}</span>
						{{ __('Ładuję wpisy…', 'taxeon') }}
					</div>
				</div>

				<p data-blog-status class="sr-only" role="status" aria-live="polite"></p>

				<div data-blog-grid
					class="mt-7 grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line
						transition-opacity duration-200 group-data-loading/results:opacity-35
						max-xl:grid-cols-2 max-sm:grid-cols-1">
					{% for post in posts %}
						{% include 'components/post-card.twig' with { post: post } only %}
					{% endfor %}
				</div>

				<p data-blog-empty
					{% if posts|length %}hidden{% endif %}
					class="py-10 text-center text-[16px] text-ink-3">
					{{ __('Nie znaleziono wpisów.', 'taxeon') }}
				</p>
			</div>

			<div data-blog-load-more hidden class="mt-8 flex justify-center">
				<button type="button"
					class="group/more inline-flex cursor-pointer items-center gap-2.5 rounded-pill border border-line bg-page
						px-[30px] py-[15px] text-[16px] font-semibold text-ink transition hover:border-navy hover:text-navy
						disabled:cursor-wait disabled:opacity-70">
					<span aria-hidden="true" class="hidden size-4 animate-spin text-gold group-disabled/more:block [&_svg]:size-full">
						{{ 'loader-circle'|svg }}
					</span>
					{{ __('Pokaż więcej artykułów', 'taxeon') }}
				</button>
			</div>

			{% include 'components/pagination.twig' with { pagination: pagination } only %}
		</div>
	</section>

	{% if archiveCtaTitle %}
		<section class="relative overflow-hidden bg-ink px-gutter py-24 text-white max-sm:px-5 max-sm:py-16">
			<div aria-hidden="true"
				class="absolute inset-0 bg-[radial-gradient(70%_90%_at_50%_110%,rgb(23_63_95/0.55),transparent_65%)]"></div>

			<div class="relative mx-auto max-w-[900px] text-center">
				<h2 class="font-display text-[clamp(30px,3.6vw,48px)] leading-[1.06] font-bold tracking-[-0.035em]">
					{{ archiveCtaTitle }}
				</h2>

				{% if archiveCtaText %}
					<p class="mt-[18px] text-[18px] text-white/76">{{ archiveCtaText }}</p>
				{% endif %}

				{% if archiveCtaLink.url %}
					<div class="mt-8 flex flex-wrap justify-center gap-3.5">
						<a href="{{ archiveCtaLink.url }}"
							{{ linkAttrs(archiveCtaLink.url, archiveCtaLink.target)|raw }}
							class="rounded-pill bg-white px-8 py-[17px] text-[16px] font-semibold text-ink
								transition hover:bg-sand">
							{{ archiveCtaLink.title }}
						</a>
					</div>
				{% endif %}
			</div>
		</section>
	{% endif %}
{% endblock %}
