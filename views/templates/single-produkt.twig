{% extends "layouts/base.twig" %}

{% set solidHeader = false %}
{% set shopUrl = post.meta('_shop_permalink') %}
{% set isTraining = post.meta('_shop_is_training') == 'yes' %}
{% set checklist = post.meta('_shop_checklist') %}
{% set areas = post.terms({ taxonomy: 'kategoria-produktu' }) %}
{% set cena = post.meta('_shop_price') %}
{% set jestDarmowe = cena is not empty and cena|number_format(2, '.', '') == '0.00' %}

{% block main %}
	<article>
		<section data-hero-bg="net"
			class="hero-clip relative -mt-header overflow-hidden rounded-b-section bg-[image:var(--gradient-hero)]
				pt-header max-md:rounded-b-section-sm">

			<div class="relative z-[1] mx-auto w-full max-w-page px-gutter max-sm:px-5">
				<div class="max-w-[880px] pt-16 pb-21">
					{% include 'components/breadcrumbs.twig' with { breadcrumbs: breadcrumbs, light: true } only %}

					{% if cena is not empty %}
						<span class="mt-5 inline-flex items-center gap-2.5 rounded-full bg-white/10 py-1.5 pr-4 pl-1.5
							text-meta font-bold whitespace-nowrap text-white">
							<b class="rounded-full bg-white px-2.5 py-[3px] text-xs text-ink">
								{{ jestDarmowe ? __('Bezpłatne', 'raks') : cena|shopPrice }}
							</b>
							{{ post.meta('_shop_virtual') == 'yes' ? __('webinar online', 'raks') }}
						</span>
					{% endif %}

					{% include 'components/animated-title.twig' with {
						text: post.title,
						class: 'mt-5 font-display text-[clamp(33px,4.6vw,54px)] leading-[1.08]
							font-semibold tracking-[-0.02em] text-balance text-white'
					} only %}

					{% if post.post_excerpt %}
						<p class="mt-[22px] text-[clamp(17px,2vw,20px)] leading-[1.6] text-white/78">
							{{ post.post_excerpt|striptags }}
						</p>
					{% endif %}
				</div>
			</div>
		</section>

		<div class="pt-16 pb-section max-sm:py-16">
			<div class="mx-auto w-full max-w-page px-gutter max-sm:px-5">
				<div class="grid items-start gap-12 max-lg:grid-cols-1 max-lg:gap-8 lg:grid-cols-[1fr_360px]">

					<div class="max-w-[760px]">
						{% if post.content %}
							<h2 class="font-display text-2xl leading-[1.15] font-semibold tracking-[-0.02em] text-ink">
								{{ __('Opis szkolenia', 'raks') }}
							</h2>

							<div class="prose mt-3.5">{{ post.content }}</div>
						{% endif %}

						{% if checklist|length %}
							<h2 class="mt-10 font-display text-2xl leading-[1.15] font-semibold tracking-[-0.02em] text-ink">
								{{ post.meta('_shop_checklist_title') ?: __('W trakcie webinaru odpowiemy na pytania', 'raks') }}
							</h2>

							<ul class="mt-4 grid gap-3.5">
								{% for point in checklist %}
									<li class="flex items-start gap-3.5 text-base leading-normal text-ink
										[&_svg]:mt-px [&_svg]:size-[22px] [&_svg]:flex-none [&_svg]:text-accent">
										{{ 'circle-check'|svg }}
										{{ point }}
									</li>
								{% endfor %}
							</ul>
						{% endif %}

						{% if areas|length %}
							<div class="mt-[22px] flex flex-wrap gap-2">
								{% for area in areas %}
									<a href="{{ area.link }}"
										class="rounded-full bg-accent-soft px-[11px] py-1 text-xs font-semibold
											text-accent-strong hover:bg-accent hover:text-white">
										{{ area.name }}
									</a>
								{% endfor %}
							</div>
						{% endif %}
					</div>

					<aside class="sticky top-[100px] rounded-panel border border-line bg-white p-[30px] shadow-soft max-lg:static">
						{% if jestDarmowe %}
							<span class="mb-5 inline-block rounded-lg bg-[#e9f7ef] px-[13px] py-1.5 text-[13px]
								font-bold tracking-[0.03em] text-[#1e8449] uppercase">
								{{ __('Bezpłatne', 'raks') }}
							</span>
						{% elseif cena is not empty %}
							<div class="mb-5 flex items-baseline gap-2.5">
								<b class="font-display text-[34px] leading-none font-bold tracking-[-0.02em] text-ink">
									{{ cena|shopPrice }}
								</b>

								{% if post.meta('_shop_regular_price') %}
									<s class="text-base text-ink-3">{{ post.meta('_shop_regular_price')|shopPrice }}</s>
								{% endif %}
							</div>
						{% endif %}

						{% set facts = [
							{ icon: 'calendar', label: __('Data', 'raks'), value: isTraining ? post.meta('_shop_training_date')|wpDate },
							{ icon: 'clock', label: __('Godzina', 'raks'), value: isTraining ? post.meta('_shop_training_time') },
							{ icon: 'timer', label: __('Czas trwania', 'raks'), value: post.meta('_shop_training_duration') ? post.meta('_shop_training_duration') ~ ' min' },
							{ icon: 'monitor', label: __('Forma', 'raks'), value: post.meta('_shop_virtual') == 'yes' ? __('Webinar online', 'raks') }
						]|filter(f => f.value) %}

						{% if facts|length %}
							<div class="grid gap-0.5">
								{% for fact in facts %}
									<div class="flex items-center gap-3.5 border-b border-line-2 py-3.5 last:border-b-0
										[&_svg]:size-[19px] [&_svg]:flex-none [&_svg]:text-accent">
										{{ fact.icon|svg }}
										<div>
											<div class="text-[13px] text-ink-3">{{ fact.label }}</div>
											<div class="text-[15.5px] font-bold text-ink">{{ fact.value }}</div>
										</div>
									</div>
								{% endfor %}
							</div>
						{% endif %}

						{% if shopUrl %}
							<a href="{{ shopUrl }}" target="_blank" rel="noopener"
								class="mt-6 inline-flex w-full items-center justify-center gap-2.5 rounded-btn bg-cta
									px-8 py-[17px] text-center font-sans text-lead leading-[1.6] font-bold text-white
									shadow-cta transition hover:-translate-y-0.5 hover:bg-cta-strong
									[&_svg]:size-5 [&_svg]:shrink-0">
								{{ 'user-plus'|svg }}
								{{ __('Zapisz się', 'raks') }}
							</a>

							<p class="mt-3.5 text-center text-[13px] leading-normal text-ink-3">
								{{ __('Zapisy prowadzimy w sklepie RAKS — otworzy się w nowej karcie.', 'raks') }}
							</p>
						{% endif %}
					</aside>
				</div>

				{% if areas|length %}
					<div class="mx-auto mt-12 flex max-w-[900px] items-start gap-[18px] rounded-panel border
						border-accent/20 bg-accent-soft px-[30px] py-[26px] max-sm:px-5">
						<span class="grid size-[46px] flex-none place-items-center rounded-[13px] bg-accent
							text-white [&_svg]:size-[23px]">
							{{ 'arrow-left'|svg }}
						</span>

						<div>
							<h3 class="font-display text-lg leading-[1.15] font-semibold tracking-[-0.02em] text-accent-strong">
								{{ __('Szukasz innego terminu?', 'raks') }}
							</h3>

							<p class="mt-1.5 text-[15.5px] leading-relaxed text-ink-2">
								{{ __('Zobacz pełną listę nadchodzących szkoleń RAKS.', 'raks') }}

								<a href="{{ areas|first.link }}"
									class="group/link ml-1 inline-flex items-center gap-2 font-bold text-accent
										[&_svg]:size-[17px] [&_svg]:transition-transform group-hover/link:[&_svg]:translate-x-1">
									{{ __('Wszystkie szkolenia', 'raks') }}
									{{ 'arrow-right'|svg }}
								</a>
							</p>
						</div>
					</div>
				{% endif %}
			</div>
		</div>
	</article>
{% endblock %}
