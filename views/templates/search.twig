{% extends "layouts/base.twig" %}

{% block main %}
	{% include 'components/page-hero.twig' with {
		badge: __('Wyszukiwanie', 'taxeon'),
		title: archiveTitle,
		text: posts|length
			? __('Poniżej wpisy i strony pasujące do zapytania.', 'taxeon')
			: __('Nic nie znaleźliśmy. Spróbuj innego słowa albo zajrzyj do bazy wiedzy.', 'taxeon')
	} only %}

	<section class="relative overflow-hidden bg-[image:var(--gradient-light)] px-gutter py-section-md
		max-sm:px-5 max-sm:py-16">
		{% include 'components/section-decor.twig' with { background: 'light' } only %}

		<div class="relative mx-auto w-full max-w-page">
			{% if posts|length %}
				<div class="grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line
					max-xl:grid-cols-2 max-sm:grid-cols-1">
					{% for post in posts %}
						{% include 'components/post-card.twig' with { post: post } only %}
					{% endfor %}
				</div>

				{% include 'components/pagination.twig' with { pagination: pagination } only %}
			{% else %}
				<a href="{{ fn('get_permalink', fn('get_option', 'page_for_posts')) }}"
					class="inline-flex rounded-pill bg-accent-cta px-7 py-4 text-[16px] font-semibold text-white
						shadow-cta transition hover:bg-accent-strong">
					{{ __('Przejdź do bazy wiedzy', 'taxeon') }}
				</a>
			{% endif %}
		</div>
	</section>
{% endblock %}
