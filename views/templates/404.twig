{% extends "layouts/base.twig" %}

{% block main %}
	{% include 'components/page-hero.twig' with {
		badge: __('Błąd 404', 'taxeon'),
		title: __('Nie ma takiej strony.', 'taxeon'),
		text: __('Adres mógł się zmienić albo zawiera literówkę. Poniżej kilka miejsc, od których warto zacząć.', 'taxeon'),
		links: [
			{ title: __('Wróć na stronę główną', 'taxeon'), url: site.url },
			{ title: __('Zobacz cennik', 'taxeon'), url: fn('get_permalink', fn('get_page_by_path', 'cennik').ID ?? 0) }
		]
	} only %}

	<section class="relative overflow-hidden bg-[image:var(--gradient-light)] px-gutter py-section-md
		max-sm:px-5 max-sm:py-16">
		{% include 'components/section-decor.twig' with { background: 'light' } only %}

		<div class="relative mx-auto w-full max-w-[1160px]">
			<span class="text-[13px] font-semibold tracking-[0.14em] text-navy uppercase">
				{{ __('Najczęściej szukane', 'taxeon') }}
			</span>

			<h2 class="mt-4 font-display text-[clamp(28px,3vw,42px)] leading-[1.1] font-bold tracking-[-0.03em] text-ink">
				{{ __('Może szukasz jednej z tych stron?', 'taxeon') }}
			</h2>

			<div class="mt-9 grid grid-cols-3 gap-px overflow-hidden rounded-card border border-line bg-line
				max-xl:grid-cols-2 max-sm:grid-cols-1">
				{% for pozycja in notFoundLinks %}
					<a href="{{ pozycja.url }}"
						class="flex min-h-[150px] flex-col gap-3 bg-page px-7 py-[30px] text-ink transition hover:bg-cream">
						<span class="font-display text-[20px] leading-[1.3] font-medium tracking-[-0.02em]">
							{{ pozycja.title }}
						</span>

						{% if pozycja.text %}
							<span class="text-[15px] leading-[1.6] text-ink-3">{{ pozycja.text }}</span>
						{% endif %}
					</a>
				{% endfor %}
			</div>
		</div>
	</section>
{% endblock %}
