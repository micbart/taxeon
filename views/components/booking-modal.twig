{% if themeOptions.booking_url %}
	<dialog id="booking-modal"
		data-booking-modal
		data-src="{{ themeOptions.booking_url }}"
		aria-label="{{ themeOptions.booking_title ?: __('Umów rozmowę', 'taxeon') }}"
		class="m-auto w-[min(920px,calc(100vw-32px))] rounded-panel border border-line bg-page p-0
			shadow-deep backdrop:bg-deep/70 backdrop:backdrop-blur-[6px] max-sm:w-[calc(100vw-20px)]">

		<div class="flex items-center justify-between gap-5 border-b border-line px-7 py-5 max-sm:px-5">
			<span class="font-display text-[19px] font-semibold tracking-[-0.02em] text-ink">
				{{ themeOptions.booking_title ?: __('Umów rozmowę z księgową', 'taxeon') }}
			</span>

			<button type="button"
				data-booking-close
				aria-label="{{ __('Zamknij', 'taxeon') }}"
				class="grid size-10 flex-none cursor-pointer place-items-center rounded-pill border border-line
					text-ink-3 transition hover:border-accent hover:text-accent [&_svg]:size-[18px]">
				{{ 'x'|svg }}
			</button>
		</div>

		<div class="h-[min(72vh,760px)] w-full bg-soft">
			<iframe data-booking-frame
				title="{{ themeOptions.booking_title ?: __('Umów rozmowę z księgową', 'taxeon') }}"
				loading="lazy"
				class="size-full border-0"></iframe>
		</div>
	</dialog>
{% endif %}
