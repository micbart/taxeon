{% set eyebrowClass = 'font-display text-[13px] font-semibold tracking-[0.14em] uppercase
	' ~ (color ?: (onDark ? 'text-accent-tint-2' : 'text-accent')) ~ ' ' ~ (class ?: '') %}

{% if title is defined and title %}
	{% include 'components/title-with-select-tag.twig' with {
		title: title,
		defaultTag: defaultTag ?: 'span',
		titleClass: eyebrowClass
	} only %}
{% elseif text %}
	<span class="{{ eyebrowClass }}">{{ text }}</span>
{% endif %}
