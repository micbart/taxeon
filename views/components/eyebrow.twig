{% set kolorTla = {
	'navy': 'text-sky-2',
	'gradient': 'text-accent-tint-2'
} %}

{% set eyebrowClass = 'text-[13px] font-semibold tracking-[0.14em] uppercase
	' ~ (color ?: kolorTla[background] ?: (onDark ? 'text-accent-tint-2' : 'text-accent')) ~ ' ' ~ (class ?: '') %}

{% if title is defined and title %}
	{% include 'components/title-with-select-tag.twig' with {
		title: title,
		defaultTag: defaultTag ?: 'span',
		titleClass: eyebrowClass
	} only %}
{% elseif text %}
	<span class="{{ eyebrowClass }}">{{ text }}</span>
{% endif %}
