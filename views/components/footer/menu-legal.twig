{% for item in items %}
	{% set biezacy = currentUrl and item.url == currentUrl %}

	<a href="{{ item.url }}"
		{{ linkAttrs(item.url, item.target)|raw }}
		{% if biezacy %}aria-current="page"{% endif %}
		class="transition hover:text-white {{ biezacy ? 'text-white underline underline-offset-4' : '' }}">
		{{ item.title }}
	</a>
{% endfor %}
