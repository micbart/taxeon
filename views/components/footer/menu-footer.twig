{% for item in items %}
	{% set biezacy = currentUrl and item.url == currentUrl %}

	<a href="{{ item.url }}"
		{{ linkAttrs(item.url, item.target)|raw }}
		{% if biezacy %}aria-current="page"{% endif %}
		class="text-[15px] transition hover:text-white max-md:flex max-md:min-h-[38px] max-md:items-center max-sm:min-h-[34px] max-sm:text-[13.5px]
			{{ biezacy ? 'font-semibold text-white' : '' }}">
		{{ item.title }}
	</a>
{% endfor %}
