{% set kategoria = post.terms({ taxonomy: 'category' })|first %}

<a href="{{ post.link }}"
	class="grid grid-cols-[1.15fr_0.85fr] overflow-hidden rounded-panel border border-line bg-page
		text-ink shadow-[0_40px_80px_-60px_rgb(6_16_36/0.6)] transition hover:border-accent
		max-lg:grid-cols-1">

	<div class="flex flex-col justify-center gap-4 px-11 pt-11 pb-10 max-sm:px-7">
		<span class="font-mono text-[12px] tracking-[0.08em] text-accent uppercase">
			{{ __('Wyróżnione', 'taxeon') }}{% if kategoria %} · {{ kategoria.name }}{% endif %}
		</span>

		<h2 class="font-display text-[clamp(28px,2.8vw,40px)] leading-[1.15] font-semibold tracking-[-0.03em]">
			{{ post.title }}
		</h2>

		<p class="max-w-[52ch] text-[17px] leading-[1.62] text-ink-3">
			{{ post.excerpt({ words: 26, force: true, read_more: '' })|striptags|trim }}
		</p>

		<span class="text-[14px] text-ink-3">
			{{ post.content|readTime }} {{ __('min czytania', 'taxeon') }} ·
			<time datetime="{{ post.date('Y-m-d') }}">{{ post.date('F Y') }}</time>
		</span>
	</div>

	<div class="relative flex min-h-[260px] items-end overflow-hidden
		bg-[linear-gradient(135deg,#0a7bee_0%,#0b4fd6_40%,#10289b_100%)] p-8">
		{% if post.thumbnail %}
			{% include 'components/image.twig' with {
				id: post.thumbnail.ID,
				preset: 'post-featured',
				altFrom: post.title,
				class: 'absolute inset-0 size-full object-cover opacity-60'
			} only %}
		{% else %}
			<div aria-hidden="true"
				class="absolute inset-0 bg-[repeating-linear-gradient(45deg,rgb(255_255_255/0.08)_0_1px,transparent_1px_42px)]"></div>
		{% endif %}

		<span class="relative font-display text-[15px] font-semibold text-white">
			{{ __('Czytaj artykuł', 'taxeon') }} →
		</span>
	</div>
</a>
