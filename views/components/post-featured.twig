{% set category = post.terms({ taxonomy: 'category' })|first %}

<article class="reveal mb-10 grid grid-cols-[1.1fr_1fr] overflow-hidden rounded-panel border border-line
	bg-white shadow-soft max-lg:grid-cols-1">

	<div class="relative min-h-[320px] bg-soft max-lg:min-h-[220px]">
		{% if post.thumbnail %}
			<a href="{{ post.link }}" tabindex="-1" aria-hidden="true">
				{% include 'components/image.twig' with {
					id: post.thumbnail.ID,
					size: 'raks-wide',
					sizes: '(max-width: 820px) 100vw, 55vw',
					altFrom: post.title,
					eager: true,
					class: 'absolute inset-0 size-full object-cover'
				} only %}
			</a>
		{% endif %}

		{% if category %}
			<a href="{{ category.link }}"
				style="--term-color: {{ category|termColor ?: 'var(--color-accent)' }}"
				class="absolute top-4 left-4 z-[2] rounded-full bg-(--term-color) px-3 py-[5px] text-xs
					font-bold tracking-[0.03em] whitespace-nowrap text-white uppercase">
				{{ category.name }}
			</a>
		{% endif %}
	</div>

	<div class="flex flex-col justify-center p-11 max-lg:p-[30px]">
		<span class="inline-flex items-center gap-2 text-[13px] font-semibold text-ink-3 [&_svg]:size-[15px]">
			{{ 'calendar'|svg }}
			<time datetime="{{ post.date('Y-m-d') }}">{{ post.date('F Y') }}</time>
			<span aria-hidden="true">·</span>
			{{ post.content|readTime }} {{ __('min czytania', 'raks') }}
		</span>

		<h2 class="my-3.5 font-display text-[clamp(24px,2.6vw,31px)] leading-[1.08] font-semibold tracking-[-0.02em] text-ink">
			<a href="{{ post.link }}" class="hover:text-accent">{{ post.title }}</a>
		</h2>

		<p class="mb-[22px] text-[16.5px] leading-relaxed text-ink-2">
			{{ post.excerpt({ words: 40, force: true, read_more: '' })|striptags|trim }}
		</p>

		<a href="{{ post.link }}"
			class="group/link inline-flex items-center gap-[7px] self-start font-bold text-accent
				[&_svg]:size-[17px] [&_svg]:transition-transform group-hover/link:[&_svg]:translate-x-1">
			{{ __('Czytaj artykuł', 'raks') }}
			{{ 'arrow-right'|svg }}
		</a>
	</div>
</article>
