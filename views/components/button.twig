{% set link = button.link ?? button %}

{% if link.url %}
	{% set base = 'inline-flex items-center justify-center gap-[9px] rounded-btn border
		text-center font-sans leading-[1.6] font-semibold transition [&_svg]:size-[18px] [&_svg]:shrink-0' %}

	{% set sizes = {
		'base': 'px-[26px] py-3.5 text-[15px]',
		'lg': 'px-[30px] py-[17px] text-base'
	} %}

	{% set variants = {
		'primary': 'border-transparent bg-navy text-white shadow-cta hover:-translate-y-0.5 hover:bg-navy-deep',
		'accent': 'border-sand bg-gold-light text-ink shadow-glow-gold hover:-translate-y-0.5 hover:bg-gold-hover',
		'ghost': 'border-navy bg-transparent text-navy hover:-translate-y-0.5 hover:bg-mist',
		'on-navy': 'border-transparent bg-white text-ink hover:-translate-y-0.5 hover:bg-sand',
		'ghost-navy': 'border-white/32 bg-transparent text-white hover:border-white hover:bg-white/6'
	} %}

	{% set pickedVariant = variant ?: (button.variant ?: 'primary') %}
	{% set pickedSize = size ?: (button.size ?: 'base') %}

	<a href="{{ link.url }}"
		{{ linkAttrs(link.url, link.target)|raw }}
		class="{{ base }} {{ sizes[pickedSize] }} {{ variants[pickedVariant] }} {{ block ? 'w-full' }} {{ class }}">
		{% set pickedIcon = icon ?: button.icon %}
		{% if pickedIcon %}{{ pickedIcon|svg }}{% endif %}
		{{ link.title }}
	</a>
{% endif %}
