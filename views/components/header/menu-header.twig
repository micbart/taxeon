<nav class="flex flex-none items-center gap-0.5 max-nav:hidden" aria-label="{{ __('Nawigacja główna', 'taxeon') }}">
	{% for item in items %}
		<a href="{{ item.url }}"
			target="{{ item.target ?: '_self' }}"
		{% if item.target == '_blank' %}rel="noopener"{% endif %}
			{% if currentUrl and item.url == currentUrl %}aria-current="page"{% endif %}
			class="rounded-pill px-[13px] py-[9px] text-[15px] font-medium whitespace-nowrap text-white
				transition hover:bg-white/12
				{{ currentUrl and item.url == currentUrl ? 'bg-white/12' : '' }}">
			{{ item.title }}
		</a>
	{% endfor %}
</nav>
