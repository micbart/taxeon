<nav class="flex min-w-0 flex-auto items-center justify-center gap-1 max-nav:hidden" aria-label="{{ __('Nawigacja główna', 'taxeon') }}">
	{% for item in items %}
		{% set aktywny = currentUrl and (item.url == currentUrl or (item.url != homeUrl and currentUrl starts with item.url)) %}
		<a href="{{ item.url }}"
			{{ linkAttrs(item.url, item.target)|raw }}
			{% if aktywny %}aria-current="page"{% endif %}
			class="rounded-pill px-[13px] py-[9px] text-[15px] font-medium whitespace-nowrap text-white
				transition hover:bg-white/12
				{{ aktywny ? 'bg-white/12' : '' }}">
			{{ item.title }}
		</a>
	{% endfor %}
</nav>
