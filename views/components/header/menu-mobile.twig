{% for item in items %}
	<a href="{{ item.url }}"
		{{ linkAttrs(item.url, item.target)|raw }}
		{% if currentUrl and item.url == currentUrl %}aria-current="page"{% endif %}
		class="border-b border-white/10 py-[11px] font-display text-[20px] font-medium text-white">
		{{ item.title }}
	</a>
{% endfor %}
