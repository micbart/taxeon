<div data-verify
	role="checkbox"
	tabindex="0"
	aria-checked="false"
	aria-label="{{ __('Weryfikacja — nie jestem robotem', 'taxeon') }}"
	class="group/verify flex cursor-pointer flex-wrap items-center gap-3.5 rounded-card border-[1.5px] border-line max-sm:gap-y-1.5
		bg-white px-[18px] py-3.5 transition
		hover:border-[color-mix(in_srgb,var(--color-accent)_40%,var(--color-line))]
		focus-visible:border-accent focus-visible:shadow-[0_0_0_3px_color-mix(in_srgb,var(--color-accent)_16%,transparent)]
		focus-visible:outline-none
		data-verified:cursor-default data-verified:border-[color-mix(in_srgb,#1e8449_45%,var(--color-line))]
		data-verified:bg-[#f3faf6]">

	<span aria-hidden="true"
		class="relative grid size-[22px] flex-none place-items-center rounded-[6px] border-2 border-line
			transition-colors
			before:absolute before:inset-[-2px] before:rounded-[8px] before:border-2
			before:border-accent/25 before:border-t-accent before:opacity-0 before:content-['']
			group-data-checking/verify:border-transparent
			group-data-checking/verify:before:animate-spin group-data-checking/verify:before:opacity-100
			group-data-verified/verify:border-[#1e8449] group-data-verified/verify:bg-[#1e8449]
			[&_svg]:size-4 [&_svg]:text-white [&_svg]:opacity-0 [&_svg]:transition-opacity
			group-data-verified/verify:[&_svg]:opacity-100">
		{{ 'check'|svg }}
	</span>

	<span data-verify-label
		data-checking-label="{{ __('Weryfikacja…', 'taxeon') }}"
		data-done-label="{{ __('Zweryfikowano', 'taxeon') }}"
		class="flex-1 text-[15px] font-semibold whitespace-nowrap text-ink
			group-data-checking/verify:text-ink-3 group-data-verified/verify:text-[#1e8449]">
		{{ __('Nie jestem robotem', 'taxeon') }}
	</span>

	<span aria-hidden="true"
		class="ml-auto inline-flex items-center gap-2 text-xs leading-[1.3] font-bold tracking-[0.02em]
			whitespace-nowrap text-ink-3 [&_svg]:size-[18px] [&_svg]:flex-none [&_svg]:text-accent
			max-sm:ml-9 max-sm:basis-full max-sm:flex-wrap max-sm:gap-x-1.5 max-sm:gap-y-0 max-sm:whitespace-normal max-sm:[&_svg]:size-4">
		{{ 'shield-check'|svg }}
		TAXEON Verify
		<small class="text-[11px] font-medium text-ink-3 before:content-['·_']">{{ __('Prywatność · Regulamin', 'taxeon') }}</small>
	</span>

	<input type="hidden" name="verified" value="">
</div>

<span data-error-for="verified" class="text-[13px] font-semibold text-[#d64545] empty:hidden"></span>
