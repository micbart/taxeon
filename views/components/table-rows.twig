{% for row in rows %}
	{% set lastRow = loop.last %}

	<tr class="{{ variant == 'downloads' ? 'transition-colors hover:bg-cream' }}">
		{% for cell in row.cells %}
			{% set col = head[loop.index0] %}
			{% set border = lastRow ? '' : 'border-b border-line-2' %}
			{% set isDash = cell.text == '—' and not cell.link.url %}

			{% if variant == 'downloads' %}
				<td class="px-[22px] py-[15px] text-left align-middle max-md:px-3.5 max-md:py-[13px] {{ border }} {{ col.hide_mobile ? 'max-md:hidden' }}">
					{% if cell.link.url %}
						<a href="{{ cell.link.url }}"
							{{ linkAttrs(cell.link.url, cell.link.target)|raw }}
							class="inline-flex items-center gap-[7px] text-sm whitespace-nowrap transition-colors [&_svg]:size-4
								{{ cell.style == 'muted' ? 'font-normal text-ink-3 hover:text-navy' : 'font-bold text-navy' }}">
							{% if cell.icon %}{{ cell.icon|svg }}{% endif %}
							{{ cell.link.title ?: cell.text }}
						</a>
					{% elseif loop.first %}
						<span class="inline-flex items-center gap-[11px] text-[15px] font-normal text-ink md:whitespace-nowrap">
							{% if cell.icon %}
								<span class="grid size-[34px] flex-none place-items-center rounded-[9px] bg-cream text-navy [&_svg]:size-[18px]">
									{{ cell.icon|svg }}
								</span>
							{% endif %}
							{{ cell.text }}
						</span>
					{% elseif isDash %}
						<span class="text-ink-3">{{ cell.text }}</span>
					{% elseif cell.style == 'strong' %}
						<span class="font-display text-[15px] font-normal whitespace-nowrap text-ink">{{ cell.text }}</span>
					{% else %}
						<span class="text-sm whitespace-nowrap text-ink-2">{{ cell.text }}</span>
					{% endif %}
				</td>

			{% elseif variant == 'pricing' %}
				<td class="px-[26px] py-[18px] text-left align-middle text-[17px] text-ink max-[620px]:px-3 max-[620px]:py-3 max-[620px]:text-sm {{ border }} {{ col.hide_mobile ? 'max-[620px]:hidden' }}">
					{% if cell.style == 'price' %}
						<span class="font-display text-[19px] font-bold whitespace-nowrap text-ink max-[620px]:text-[15px]">
							{{ cell.text }}
							{% if cell.suffix %}
								<small class="font-sans text-[13px] font-semibold text-ink-3 max-[620px]:text-[11px]">{{ cell.suffix }}</small>
							{% endif %}
						</span>
					{% elseif cell.link.url %}
						<a href="{{ cell.link.url }}"
							{{ linkAttrs(cell.link.url, cell.link.target)|raw }}
							class="group/link inline-flex items-center gap-[7px] font-bold whitespace-nowrap text-navy
								[&_svg]:size-[17px] [&_svg]:transition-transform group-hover/link:[&_svg]:translate-x-1
								max-[620px]:gap-1 max-[620px]:[&_svg]:size-[18px]">
							{% if cell.icon %}{{ cell.icon|svg }}{% endif %}
							<span class="max-[620px]:sr-only">{{ cell.link.title ?: cell.text }}</span>
							{% if not cell.icon %}{{ 'arrow-right'|svg }}{% endif %}
						</a>
					{% elseif loop.first %}
						<span class="inline-flex items-center gap-3 font-semibold max-[620px]:gap-2">
							{% if cell.icon %}
								<span class="grid size-9 flex-none place-items-center rounded-[10px] bg-cream text-navy [&_svg]:size-[19px] max-[620px]:size-7 max-[620px]:rounded-lg max-[620px]:[&_svg]:size-[15px]">
									{{ cell.icon|svg }}
								</span>
							{% endif %}
							{{ cell.text }}
						</span>
					{% else %}
						<p class="mt-[3px] text-[13.5px] text-ink-3 max-[620px]:text-xs">{{ cell.text }}</p>
					{% endif %}
				</td>

			{% else %}
				<td class="px-6 py-[18px] text-left align-top text-[17px] text-ink max-[620px]:px-3.5 max-[620px]:py-[13px] max-[620px]:text-sm
					{{ loop.first ? 'w-[30%] font-semibold' : 'font-normal' }} {{ border }} {{ col.hide_mobile ? 'max-[620px]:hidden' }}">
					{% if cell.link.url %}
						<a href="{{ cell.link.url }}"
							{{ linkAttrs(cell.link.url, cell.link.target)|raw }}
							class="group/link inline-flex items-center gap-[7px] font-bold text-navy
								[&_svg]:size-[17px] [&_svg]:transition-transform group-hover/link:[&_svg]:translate-x-1">
							{{ cell.link.title ?: cell.text }}
							{{ 'arrow-right'|svg }}
						</a>
					{% else %}
						<span class="inline-flex items-center gap-[9px] [&_svg]:size-[18px] [&_svg]:flex-none
							{{ cell.style == 'muted' ? '[&_svg]:text-ink-3' : '[&_svg]:text-navy' }}">
							{% if cell.icon %}{{ cell.icon|svg }}{% endif %}
							{{ cell.text }}
							{% if cell.suffix %}<small class="text-meta text-ink-3">{{ cell.suffix }}</small>{% endif %}
						</span>
					{% endif %}
				</td>
			{% endif %}
		{% endfor %}
	</tr>
{% endfor %}
