<section class="relative overflow-hidden bg-deep text-white">
	<div aria-hidden="true" class="absolute inset-0 bg-[image:var(--gradient-hero-glow)]"></div>

	<div class="relative mx-auto w-full max-w-page px-gutter pt-[156px] pb-[72px] max-md:pt-[128px] max-sm:px-5">
		{% if badge %}
			<div class="inline-flex items-center gap-2.5 text-[13px] tracking-[0.04em] text-white/82 uppercase">
				<span class="block size-1.5 rounded-full bg-sky"></span>
				{{ badge }}
			</div>
		{% endif %}

		<h1 class="mt-5 max-w-[20ch] font-display text-[clamp(34px,4vw,56px)] leading-[1.06] font-bold
			tracking-[-0.035em] text-balance">
			{{ title }}
		</h1>

		{% if text %}
			<p class="mt-[22px] max-w-[58ch] text-[19px] leading-[1.6] text-white/78">{{ text }}</p>
		{% endif %}

		{% if links|length %}
			<div class="mt-8 flex flex-wrap gap-3.5">
				{% for odnosnik in links %}
					<a href="{{ odnosnik.url }}"
						class="rounded-pill px-8 py-[17px] text-[16px] font-semibold transition
							{{ loop.first
								? 'bg-white text-ink hover:bg-accent-tint'
								: 'border border-white/32 text-white hover:bg-white hover:text-ink' }}">
						{{ odnosnik.title }}
					</a>
				{% endfor %}
			</div>
		{% endif %}
	</div>
</section>
