<footer id="site-footer" class="border-t border-white/8 bg-[#010714] px-gutter pt-14 pb-11 text-white/62 max-sm:px-5">
	<div class="mx-auto grid w-full max-w-page grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-9">
		<div class="flex flex-col gap-3">
			<a href="{{ site.url }}" class="flex items-center gap-2.5" aria-label="{{ site.name }}">
				{% include 'components/logo.twig' with { class: '!h-[22px]' } %}
			</a>

			{% if themeOptions.footer_description %}
				<span class="text-[14px] leading-[1.6]">{{ themeOptions.footer_description }}</span>
			{% endif %}
		</div>

		{% for column in footerMenuColumns %}
			<div class="flex flex-col gap-2.5">
				<span class="font-display text-[14px] tracking-[0.08em] text-white uppercase">{{ column.title }}</span>
				{{ column.html|raw }}
			</div>
		{% endfor %}

		<div class="flex flex-col gap-2.5">
			<span class="font-display text-[14px] tracking-[0.08em] text-white uppercase">
				{{ themeOptions.footer_contact_title ?: __('Kontakt', 'taxeon') }}
			</span>

			{% if themeOptions.footer_company %}
				<span class="text-[15px]">{{ themeOptions.footer_company }}</span>
			{% endif %}

			{% if themeOptions.email %}
				<a href="mailto:{{ themeOptions.email }}" class="text-[15px] transition hover:text-white">{{ themeOptions.email }}</a>
			{% endif %}

			{% if themeOptions.footer_hours %}
				<span class="text-[15px]">{{ themeOptions.footer_hours }}</span>
			{% endif %}

			{% if themeOptions.footer_contact_link.url %}
				<a href="{{ themeOptions.footer_contact_link.url }}"
					{{ linkAttrs(themeOptions.footer_contact_link.url, themeOptions.footer_contact_link.target)|raw }}
					class="text-[15px] transition hover:text-white">
					{{ themeOptions.footer_contact_link.title }}
				</a>
			{% endif %}
		</div>
	</div>

	<div class="mx-auto mt-9 flex w-full max-w-page flex-wrap gap-5 border-t border-white/8 pt-[22px] text-[14px]">
		<span>{{ themeOptions.copyrights ?: '© ' ~ 'now'|date('Y') ~ ' ' ~ site.name }}</span>

		{{ legalMenuHtml|raw }}
	</div>
</footer>
