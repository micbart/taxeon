<footer id="site-footer" class="border-t border-white/8 bg-navy-deep px-gutter pt-14 pb-11 text-white/62 max-sm:px-5 max-sm:pt-10 max-sm:pb-7">
	<div class="mx-auto grid w-full max-w-page grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-9 max-sm:grid-cols-2 max-sm:gap-x-5 max-sm:gap-y-7">
		<div class="flex flex-col gap-3 max-sm:col-span-2 max-sm:gap-2">
			<a href="{{ site.url }}" class="flex items-center gap-2.5" aria-label="{{ site.name }}">
				{% include 'components/logo.twig' with { class: '!h-[22px]' } %}
			</a>

			{% if themeOptions.footer_description %}
				<span class="text-[14px] leading-[1.6] max-sm:text-[13px]">{{ themeOptions.footer_description }}</span>
			{% endif %}
		</div>

		{% for column in footerMenuColumns %}
			<div class="flex flex-col gap-2.5 max-md:gap-0">
				<span class="font-display text-[14px] tracking-[0.08em] text-white uppercase max-md:mb-1 max-sm:text-[12px]">{{ column.title }}</span>
				{{ column.html|raw }}
			</div>
		{% endfor %}

		<div class="flex flex-col gap-2.5 max-md:gap-0 max-sm:col-span-2">
			<span class="font-display text-[14px] tracking-[0.08em] text-white uppercase max-md:mb-1 max-sm:text-[12px]">
				{{ themeOptions.footer_contact_title ?: __('Kontakt', 'taxeon') }}
			</span>

			{% if themeOptions.footer_company %}
				<span class="text-[15px] max-md:flex max-md:min-h-[38px] max-md:items-center max-sm:min-h-[34px] max-sm:text-[13.5px]">{{ themeOptions.footer_company }}</span>
			{% endif %}

			{% if themeOptions.email %}
				<a href="mailto:{{ themeOptions.email }}" class="text-[15px] transition hover:text-white max-md:flex max-md:min-h-[38px] max-md:items-center max-sm:min-h-[34px] max-sm:text-[13.5px]">{{ themeOptions.email }}</a>
			{% endif %}

			{% if themeOptions.footer_hours %}
				<span class="text-[15px] max-md:flex max-md:min-h-[38px] max-md:items-center max-sm:min-h-[34px] max-sm:text-[13.5px]">{{ themeOptions.footer_hours }}</span>
			{% endif %}

			{% if themeOptions.footer_contact_link.url %}
				<a href="{{ themeOptions.footer_contact_link.url }}"
					{{ linkAttrs(themeOptions.footer_contact_link.url, themeOptions.footer_contact_link.target)|raw }}
					class="text-[15px] transition hover:text-white max-md:flex max-md:min-h-[38px] max-md:items-center max-sm:min-h-[34px] max-sm:text-[13.5px]">
					{{ themeOptions.footer_contact_link.title }}
				</a>
			{% endif %}
		</div>
	</div>

	<div class="mx-auto mt-9 flex w-full max-w-page flex-wrap items-center gap-x-5 gap-y-1 border-t border-white/8 pt-[22px] text-[14px]
		max-sm:mt-7 max-sm:pt-4 max-sm:text-[12.5px]">
		<span class="max-md:w-full max-md:py-1">{{ themeOptions.copyrights ?: '© ' ~ 'now'|date('Y') ~ ' ' ~ site.name }}</span>

		{{ legalMenuHtml|raw }}
	</div>
</footer>
