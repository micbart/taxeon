{% set wlasne = themeOptions.logo_white ?: themeOptions.logo %}

{% if wlasne %}
	{% include 'components/image.twig' with {
		id: wlasne.ID,
		preset: 'avatar',
		alt: site.name,
		eager: true,
		class: 'h-6 w-auto ' ~ (class ?: '')
	} only %}
{% else %}
	<img src="{{ theme.link }}/images/logo-white.png" width="156" height="24" alt="{{ site.name }}"
		decoding="async" class="block h-6 w-auto {{ class }}">
{% endif %}
