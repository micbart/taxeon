{% set wlasne = themeOptions.logo_white ?: themeOptions.logo %}

{% if wlasne %}
	{% include 'components/image.twig' with {
		id: wlasne.ID,
		preset: 'avatar',
		alt: site.name,
		eager: true,
		class: 'h-6 w-auto ' ~ (class ?: '')
	} only %}
{% else %}
	<span class="block h-6 w-[156px] text-white {{ class }}" role="img" aria-label="{{ site.name }}">
		{{ 'logo'|svg('size-full') }}
	</span>
{% endif %}
