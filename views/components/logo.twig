{% set wlasne = themeOptions.logo_white ?: themeOptions.logo %}

{% if wlasne %}
	<img src="{{ wlasne.url }}"
		alt="{{ site.name }}"
		width="{{ wlasne.width }}"
		height="{{ wlasne.height }}"
		class="h-6 w-auto {{ class }}">
{% else %}
	<img src="{{ site.theme.uri }}/images/logo-white.png"
		alt="{{ site.name }}"
		width="624"
		height="96"
		class="h-6 w-[156px] {{ class }}">
{% endif %}
