{% set youtubeId = url ? url|youtubeId : '' %}

{% if url %}
	{% if youtubeId %}
		{% set parametry = 'autoplay=1&mute=1&loop=1&controls=0&playsinline=1&modestbranding=1&rel=0&playlist=' ~ youtubeId %}

		<iframe src="https://www.youtube-nocookie.com/embed/{{ youtubeId }}?{{ parametry }}"
			title="{{ title|default('') }}"
			tabindex="-1"
			aria-hidden="true"
			allow="autoplay; encrypted-media"
			referrerpolicy="strict-origin-when-cross-origin"
			class="pointer-events-none absolute top-1/2 left-1/2 h-[56.25vw] min-h-full w-[177.78vh] min-w-full
				-translate-x-1/2 -translate-y-1/2 border-0
				brightness-[1.3] contrast-[1.1] saturate-[1.5]"></iframe>
	{% else %}
		<video data-hero-video
			data-src="{{ url }}"
			{% if poster %}poster="{{ poster }}"{% endif %}
			muted loop playsinline preload="none" aria-hidden="true" disablepictureinpicture
			class="absolute inset-0 size-full object-cover brightness-[1.3] contrast-[1.1] saturate-[1.5]"></video>
	{% endif %}

	<div aria-hidden="true" class="absolute inset-0 bg-navy mix-blend-color"></div>

	<div aria-hidden="true"
		class="absolute inset-0 {{ center
			? 'bg-[image:var(--gradient-hero-shade-center)]'
			: (split
				? 'bg-[image:var(--gradient-hero-shade-split)]'
				: 'bg-[image:var(--gradient-hero-shade)]') }}"></div>
{% endif %}

{% if glow %}
	<div aria-hidden="true" class="absolute inset-0 bg-[image:var(--gradient-hero-glow)]"></div>
{% endif %}
