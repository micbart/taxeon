{% macro shell(fields, extra) %}
	{%- set backgrounds = {
		'page': 'bg-page',
		'soft': 'bg-soft',
		'soft-2': 'bg-soft-2',
		'light': 'bg-[image:var(--gradient-light)]',
		'navy': 'bg-deep text-white',
		'gradient': 'bg-[image:var(--gradient-blue)] text-white'
	} -%}

	{%- set paddingTop = {
		'default': 'pt-section max-sm:pt-16',
		'large': 'pt-[108px] max-sm:pt-16',
		'medium': 'pt-section-md max-sm:pt-16',
		'medium-sm': 'pt-[100px] max-sm:pt-16',
		'small-lg': 'pt-[96px] max-sm:pt-14',
		'small': 'pt-section-sm max-sm:pt-14',
		'none': 'pt-0'
	} -%}

	{%- set paddingBottom = {
		'default': 'pb-section max-sm:pb-16',
		'large': 'pb-[108px] max-sm:pb-16',
		'medium': 'pb-section-md max-sm:pb-16',
		'medium-sm': 'pb-[100px] max-sm:pb-16',
		'small-lg': 'pb-[96px] max-sm:pb-14',
		'small': 'pb-section-sm max-sm:pb-14',
		'none': 'pb-0'
	} -%}

	{{- backgrounds[fields.background ?: 'page'] }} px-gutter max-sm:px-5 {{ paddingTop[fields.padding_top ?: 'default'] }} {{ paddingBottom[fields.padding_bottom ?: 'default'] }} {{ extra -}}
{% endmacro %}

{% macro container(fields) %}
	{%- set widths = {
		'page': 'max-w-page',
		'content': 'max-w-[1160px]',
		'narrow': 'max-w-[860px]',
		'wide': 'max-w-[1440px]',
		'full': 'max-w-none'
	} -%}

	{{- 'mx-auto w-full ' ~ widths[fields.container ?: 'page'] -}}
{% endmacro %}

{% macro isDark(fields) %}
	{{- fields.background in ['navy', 'gradient'] ? '1' : '' -}}
{% endmacro %}
