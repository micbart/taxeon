{% set kategoria = post.terms({ taxonomy: 'category' })|first %}

<a href="{{ post.link }}"
	class="flex flex-col bg-page px-7 py-[30px] text-ink transition
		{{ compact ? 'min-h-[190px] gap-3 hover:bg-soft' : 'min-h-[210px] gap-3.5 hover:bg-soft-2' }}">
	{% if kategoria %}
		<span class="font-mono text-[12px] tracking-[0.08em] text-accent uppercase">{{ kategoria.name }}</span>
	{% endif %}

	<span class="font-display leading-[1.3] font-medium tracking-[-0.02em]
		{{ compact ? 'text-[21px]' : 'text-[22px]' }}">{{ post.title }}</span>

	{% if not compact %}
		<span class="text-[15px] leading-[1.6] text-ink-3">
			{{ post.excerpt({ words: 22, force: true, read_more: '' })|striptags|trim }}
		</span>
	{% endif %}

	<span class="mt-auto text-[13.5px] text-ink-4">
		{{ post.content|readTime }} {{ __('min czytania', 'taxeon') }} ·
		<time datetime="{{ post.date('Y-m-d') }}">{{ post.date('F Y') }}</time>
	</span>
</a>
