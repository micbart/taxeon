<header id="site-header"
	class="pointer-events-none fixed inset-x-0 top-0 z-[60] flex justify-center px-gutter py-4 max-sm:px-5">
	<div class="pointer-events-auto flex h-[68px] w-full max-w-page items-center gap-5 rounded-pill
		border border-navy-deep bg-navy pr-3 pl-[22px] whitespace-nowrap shadow-nav max-sm:pl-4">

		<a href="{{ site.url }}" class="flex flex-none items-center" aria-label="{{ site.name }}">
			{% include 'components/logo.twig' %}
		</a>

		{{ headerMenuHtml|raw }}

		<div class="ml-auto flex items-center gap-2 max-md:flex-row-reverse">
			<button type="button"
				id="menu-toggle"
				aria-expanded="false"
				aria-controls="mobile-menu"
				aria-label="{{ __('Menu', 'taxeon') }}"
				class="flex size-11 flex-none cursor-pointer flex-col items-center justify-center gap-[5px]
					rounded-pill border border-white/20 bg-white/10 nav:hidden
					[&_span]:block [&_span]:h-0.5 [&_span]:w-[18px] [&_span]:rounded-sm [&_span]:bg-white
					[&_span]:transition
					data-open:[&_span:first-child]:translate-y-[3.5px] data-open:[&_span:first-child]:rotate-45
					data-open:[&_span:last-child]:-translate-y-[3.5px] data-open:[&_span:last-child]:-rotate-45">
				<span></span>
				<span></span>
			</button>

			{% if themeOptions.header_cta.url %}
				<a href="{{ themeOptions.header_cta.url }}"
					{{ linkAttrs(themeOptions.header_cta.url, themeOptions.header_cta.target)|raw }}
					aria-label="{{ themeOptions.header_cta.title }}"
					class="flex flex-none items-center justify-center rounded-pill border-2 border-sand bg-gold-light
						text-[15px] font-bold text-ink shadow-glow-gold transition
						hover:bg-gold-hover hover:shadow-[0_0_26px_5px_rgb(227_178_60/0.7)]
						px-[22px] py-[12px] max-md:size-11 max-md:px-0 max-md:py-0">
					<span class="max-md:hidden">{{ themeOptions.header_cta.title }}</span>

					<span aria-hidden="true" class="hidden max-md:block [&_svg]:size-5">
						{{ 'calendar-check'|svg }}
					</span>
				</a>
			{% endif %}
		</div>
	</div>
</header>

<div id="mobile-menu"
	class="fixed inset-0 z-[59] hidden h-dvh flex-col gap-0.5 overflow-y-auto overscroll-contain bg-navy px-gutter
		pt-[100px] pb-10 data-open:flex max-sm:px-5">
	{{ mobileMenuHtml|raw }}

	{% if themeOptions.header_cta.url %}
		<a href="{{ themeOptions.header_cta.url }}"
			{{ linkAttrs(themeOptions.header_cta.url, themeOptions.header_cta.target)|raw }}
			class="mt-5 flex-none rounded-pill border-2 border-sand bg-gold-light px-7 py-[15px] text-center text-[15px]
				font-bold text-ink shadow-glow-gold transition hover:bg-gold-hover">
			{{ themeOptions.header_cta.title }}
		</a>
	{% endif %}
</div>
