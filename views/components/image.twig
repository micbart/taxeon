{% if id %}
	{% set pic = imagePicture(id, preset ?: 'inline', altFrom ?: '') %}

	{% if pic %}
		{% set opis = alt is defined ? alt : pic.alt %}
		{% set pierwszy = imageFirstOnPage() %}
		{% set wczesnie = eager ?: pierwszy %}

		<picture>
			{% if not pic.is_svg and pic.webp %}
				<source type="image/webp" srcset="{{ pic.webp }}" sizes="{{ sizes ?: pic.sizes }}">
			{% endif %}

			<img src="{{ pic.src }}"
				alt="{{ opis }}"
				{% if opis is empty %}aria-hidden="true"{% endif %}
				width="{{ pic.width }}"
				height="{{ pic.height }}"
				class="{{ class }}"
				{% if objectPosition %}style="object-position: {{ objectPosition }}"{% endif %}
				loading="{{ wczesnie ? 'eager' : 'lazy' }}"
				decoding="{{ wczesnie ? 'sync' : 'async' }}"
				{% if wczesnie %}fetchpriority="high"{% endif %}>
		</picture>
	{% endif %}
{% endif %}
