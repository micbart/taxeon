{% set control = include('components/control.twig')|trim %}
{% set id = (idPrefix ?: 'field') ~ '-' ~ name %}

<div class="grid gap-[7px]">
	<label for="{{ id }}" class="text-sm font-bold text-ink">
		{{ label }}
		{% if hint %}<span class="font-medium text-ink-3">{{ hint }}</span>{% endif %}
		{% if required %}<span class="text-cta">*</span>{% endif %}
	</label>

	{% if type == 'textarea' %}
		<textarea id="{{ id }}"
			name="{{ name }}"
			rows="{{ rows ?? 6 }}"
			{% if required %}required{% endif %}
			class="{{ control }} min-h-[150px] resize-y"></textarea>
	{% elseif type == 'select' %}
		<select id="{{ id }}" name="{{ name }}" {% if required %}required{% endif %} class="{{ control }}">
			<option value="">{{ __('— wybierz —', 'taxeon') }}</option>
			{% for option in options %}
				<option value="{{ option.label }}">{{ option.label }}</option>
			{% endfor %}
		</select>
	{% else %}
		<input id="{{ id }}"
			type="{{ type ?: 'text' }}"
			name="{{ name }}"
			{% if required %}required{% endif %}
			{% if autocomplete %}autocomplete="{{ autocomplete }}"{% endif %}
			{% if inputmode %}inputmode="{{ inputmode }}"{% endif %}
			{% if value %}value="{{ value }}"{% endif %}
			{% if placeholder %}placeholder="{{ placeholder }}"{% endif %}
			class="{{ control }}">
	{% endif %}

	<span data-error-for="{{ name }}" class="text-[13px] font-semibold text-[#d64545] empty:hidden"></span>
</div>
