{% if background == 'light' %}
	<div aria-hidden="true"
		class="absolute inset-0 bg-[radial-gradient(75%_55%_at_85%_100%,rgb(18_104_255/0.16),transparent_70%),radial-gradient(60%_50%_at_0%_15%,rgb(69_208_255/0.1),transparent_72%)]"></div>

	<div aria-hidden="true"
		class="absolute inset-0 [mask-image:linear-gradient(180deg,transparent,#000_55%)]
			bg-[repeating-linear-gradient(45deg,rgb(11_99_246/0.06)_0_1px,transparent_1px_54px),repeating-linear-gradient(-45deg,rgb(11_99_246/0.06)_0_1px,transparent_1px_54px)]"></div>
{% elseif background == 'gradient' %}
	<div aria-hidden="true" class="absolute inset-0 bg-[image:var(--gradient-blue-glow)]"></div>
{% elseif background == 'navy' and glow %}
	<div aria-hidden="true"
		class="absolute inset-0 bg-[radial-gradient(70%_90%_at_50%_110%,rgb(11_99_246/0.55),transparent_65%)]"></div>
{% endif %}
