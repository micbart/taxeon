<IfModule mod_rewrite.c>
	RewriteEngine On

	RewriteRule ^(app|bin|src|tests|views|node_modules|vendor|acf-json|languages)/ - [F,L]
	RewriteRule \.(twig|json|lock|md|neon|log|sh|yml|yaml|sql|bak|orig|save|dist|map)$ - [F,L]
	RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|phpcs\.xml|vite\.config\.js|\.env) - [F,L]
</IfModule>
